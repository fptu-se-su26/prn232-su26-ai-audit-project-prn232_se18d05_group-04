@page "/register"
@model RegisterModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Create account - VivuCar";
}

@section HeadStyles {
    <link rel="stylesheet" href="~/css/auth/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth/register.css" asp-append-version="true" />
}

<div class="lm-auth-container">

    @* ══════════════ LEFT PANEL ══════════════ *@
    <div class="lm-left-panel">
        <div>
            <div class="lm-logo-row">
                <a href="/" class="lm-logo-link">
                    <img src="~/logo.webp" class="lm-logo-img" alt="VivuCar" />
                    <span class="lm-logo-brand">VivuCar</span>
                </a>
            </div>
            <div class="lm-left-hero">
                <h1 class="lm-welcome-heading">Create your account</h1>
                <p class="lm-welcome-sub">
                    Join VivuCar to start your car rental journey.
                </p>
            </div>
        </div>
    </div>

    @* ══════════════ RIGHT PANEL ══════════════ *@
    <div class="lm-right-panel">
        <div class="lm-form-container">

            @* Mobile-only logo *@
            <div class="lm-mobile-logo">
                <a href="/" class="lm-logo-link">
                    <img src="~/logo.webp" class="lm-logo-img" alt="VivuCar" />
                    <span class="lm-logo-brand lm-logo-brand--dark">VivuCar</span>
                </a>
            </div>

            <h2 class="lm-signin-heading">Create an account</h2>
            <p class="lm-signin-sub">
                Already have an account? <a href="/login" class="lm-signup-link">Sign in</a>
            </p>

            @* Global error *@
            <div class="lm-global-error" id="globalError" style="display:none" role="alert"></div>

            @* Stepper (rendered by JS) *@
            <div class="lm-stepper" id="stepperEl"></div>

            @* Step content (rendered by JS) *@
            <div id="stepContainer"></div>

            @* Divider + Google (steps 1-2 only, visibility controlled by JS) *@
            <div id="googleSection">
                <div class="lm-divider">
                    <div class="lm-divider-line"></div>
                    <span class="lm-divider-label">Or continue with</span>
                    <div class="lm-divider-line"></div>
                </div>
                <button class="lm-btn-google" type="button" style="border-radius:9999px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
                    </svg>
                    <span>Google</span>
                </button>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/auth/register.js" asp-append-version="true"></script>
}

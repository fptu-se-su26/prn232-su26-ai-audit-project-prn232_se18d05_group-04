@page "/admin/moderation/licenses"
@model WebClient.Pages.Admin.Moderation.LicensesModel
@{
    ViewData["Title"] = "Kiểm duyệt GPLX";
    ViewData["AdminPage"] = "moderation-licenses";
}
<div data-admin-licenses-page>

<div class="page-heading">
          <div>
            <h1>Kiểm duyệt GPLX</h1>
            <p>Duyệt giấy phép lái xe từ bảng `user_documents`, không trộn vào tab Người dùng.</p>
          </div>
        </div>

        <section id="licenseModerationSummary" class="summary-grid"></section>
        <section id="licenseModerationFilters" class="mb-5 flex gap-2 overflow-x-auto whitespace-nowrap"></section>

        <section class="panel">
          <div id="licenseModerationEmpty" class="empty-state hidden">
            <h3>Không có GPLX cần xử lý</h3>
            <p>Giấy phép lái xe chờ duyệt sẽ xuất hiện tại đây.</p>
          </div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Người dùng</th>
                  <th>Email</th>
                  <th>Ảnh GPLX</th>
                  <th>Ngày gửi</th>
                  <th>Trạng thái</th>
                  <th>Hành động</th>
                </tr>
              </thead>
              <tbody id="licenseModerationTableBody"></tbody>
            </table>
          </div>
        </section>

<div class="modal-backdrop" id="licenseDetailModal">
    <div class="modal">
      <div class="modal-header"><h2>Chi tiết GPLX</h2><button class="icon-button" type="button" data-close-modal>×</button></div>
      <div id="licenseDetailContent"></div>
      <div class="modal-actions"><button class="btn btn-secondary" type="button" data-close-modal>Đóng</button></div>
    </div>
  </div>

  <div class="modal-backdrop" id="licenseRejectModal">
    <div class="modal">
      <div class="modal-header"><h2>Từ chối GPLX</h2><button class="icon-button" type="button" data-close-modal>×</button></div>
      <p class="muted">Nhập lý do để người dùng biết cần bổ sung hoặc gửi lại giấy phép.</p>
      <label>Lý do từ chối<textarea id="licenseRejectReason" placeholder="Ví dụ: Ảnh mặt sau bị mờ, vui lòng tải lại."></textarea></label>
      <div class="modal-actions">
        <button class="btn btn-secondary" id="btnCancelLicenseReject" type="button">Hủy</button>
        <button class="btn btn-danger" id="btnConfirmLicenseReject" type="button">Từ chối GPLX</button>
      </div>
    </div>
  </div>
</div>
@section Scripts { <script type="module" src="~/js/admin/moderation/licenses.js" asp-append-version="true"></script> }

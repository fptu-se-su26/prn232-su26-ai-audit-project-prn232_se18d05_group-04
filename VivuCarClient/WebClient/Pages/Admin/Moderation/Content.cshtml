@page "/admin/moderation/content"
@model WebClient.Pages.Admin.Moderation.ContentModel
@{
    ViewData["Title"] = "Kiểm duyệt nội dung";
    ViewData["AdminPage"] = "moderation-content";
}
<div data-admin-content-page>

<div class="page-heading">
          <div>
            <h1>Kiểm duyệt nội dung</h1>
            <p>Xử lý đánh giá và nội dung bị báo cáo, tách riêng khỏi quản lý người dùng.</p>
          </div>
        </div>

        <section id="contentModerationSummary" class="summary-grid"></section>
        <section id="contentModerationFilters" class="toolbar toolbar-content-moderation" aria-label="Bộ lọc nội dung">
          <label class="field" for="contentTypeFilter">
            <span>Phân loại</span>
            <select id="contentTypeFilter">
              <option value="">Tất cả nội dung</option>
              <option value="review">Đánh giá</option>
              <option value="incident">Báo cáo sự cố</option>
            </select>
          </label>
          <label class="field" for="contentDateFrom">
            <span>Từ ngày</span>
            <input id="contentDateFrom" type="date">
          </label>
          <label class="field" for="contentDateTo">
            <span>Đến ngày</span>
            <input id="contentDateTo" type="date">
          </label>
          <div class="field">
            <span>Kết quả</span>
            <strong id="contentFilterResult" class="filter-result-value" aria-live="polite">0 nội dung</strong>
          </div>
          <button class="btn btn-primary" id="btnFilterContent" type="button">Lọc</button>
          <button class="btn btn-secondary" id="btnResetContentFilter" type="button">Đặt lại</button>
        </section>

        <section class="panel">
          <div id="contentModerationEmpty" class="empty-state hidden">
            <h3>Không có nội dung phù hợp</h3>
            <p>Thử thay đổi phân loại hoặc khoảng thời gian.</p>
            <button class="btn btn-secondary" id="btnResetEmptyContent" type="button">Đặt lại bộ lọc</button>
          </div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Loại</th>
                  <th>Nội dung</th>
                  <th>Người gửi</th>
                  <th>Ngày gửi</th>
                  <th>Trạng thái</th>
                  <th>Hành động</th>
                </tr>
              </thead>
              <tbody id="contentModerationTableBody"></tbody>
            </table>
          </div>
        </section>

<div class="modal-backdrop" id="contentModerationDetailModal">
    <div class="modal">
      <div class="modal-header"><h2>Chi tiết nội dung</h2><button class="icon-button" type="button" data-close-modal>×</button></div>
      <div id="contentModerationDetail"></div>
      <div class="modal-actions"><button class="btn btn-secondary" type="button" data-close-modal>Đóng</button></div>
    </div>
  </div>
</div>
@section Scripts { <script type="module" src="~/js/admin/moderation/content.js" asp-append-version="true"></script> }

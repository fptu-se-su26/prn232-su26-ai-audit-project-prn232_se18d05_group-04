@page "/admin/content"
@model WebClient.Pages.Admin.Moderation.ContentModel
@{
    ViewData["Title"] = "Kiểm duyệt nội dung";
    ViewData["AdminPage"] = "moderation-content";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Moderation</p>
        <h1>Kiểm duyệt nội dung</h1>
        <p>Khung xử lý đánh giá và báo cáo sự cố từ `reviews`, `incident_reports`.</p>
    </div>
</section>

<section class="admin-toolbar">
    <input id="searchContentInput" type="search" placeholder="Tìm theo tiêu đề, nội dung, người gửi" />
    <select id="contentTypeFilter">
        <option value="">Tất cả loại nội dung</option>
        <option value="review">Đánh giá</option>
        <option value="incident_report">Báo cáo sự cố</option>
    </select>
    <select id="contentStatusFilter">
        <option value="">Tất cả trạng thái</option>
        <option value="open">Đang mở</option>
        <option value="in_review">Đang xem xét</option>
        <option value="resolved">Đã xử lý</option>
        <option value="closed">Đã đóng</option>
    </select>
    <button class="button button-primary" type="button">Lọc</button>
</section>

<section class="admin-panel">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Loại</th>
                    <th>Người gửi</th>
                    <th>Nội dung</th>
                    <th>Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody id="contentModerationBody">
                <tr><td colspan="6" class="empty-cell">Chưa gắn dữ liệu kiểm duyệt.</td></tr>
            </tbody>
        </table>
    </div>
</section>

@page "/admin/dashboard"
@model WebClient.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Dashboard doanh thu";
    ViewData["AdminPage"] = "dashboard";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Báo cáo</p>
        <h1>Dashboard doanh thu</h1>
        <p>Theo dõi doanh thu, đơn hoàn tất và tỷ lệ hủy dựa trên `daily_revenue_snapshots`, `bookings`, `payments`.</p>
    </div>
    <div class="admin-actions">
        <select id="revenueRange" aria-label="Khoảng thời gian">
            <option value="today">Hôm nay</option>
            <option value="7_days">7 ngày gần đây</option>
            <option value="this_month" selected>Tháng này</option>
            <option value="this_year">Năm nay</option>
            <option value="custom">Tùy chỉnh</option>
        </select>
        <button class="button button-primary" id="btnApplyRevenueFilter" type="button">Áp dụng</button>
    </div>
</section>

<section class="admin-grid admin-grid-kpi">
    <article class="admin-card"><span>Tổng doanh thu</span><strong id="totalRevenue">0 VND</strong></article>
    <article class="admin-card"><span>Đơn hoàn tất</span><strong id="completedOrders">0</strong></article>
    <article class="admin-card"><span>Giá trị đơn trung bình</span><strong id="averageOrderValue">0 VND</strong></article>
    <article class="admin-card"><span>Tỷ lệ hủy đơn</span><strong id="cancelRate">0%</strong></article>
</section>

<section class="admin-panel">
    <div class="panel-head">
        <h2>Doanh thu theo thời gian</h2>
        <span class="status-badge status-success">Mock chart</span>
    </div>
    <div class="chart-placeholder" id="revenueChart" aria-label="Biểu đồ doanh thu"></div>
</section>

<section class="admin-panel">
    <div class="panel-head">
        <h2>Đơn hàng gần đây</h2>
        <a class="button button-secondary" asp-page="/Admin/Reports/Export">Xuất báo cáo</a>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Xe</th>
                    <th>Ngày thuê</th>
                    <th>Tổng tiền</th>
                    <th>Thanh toán</th>
                </tr>
            </thead>
            <tbody id="recentOrdersBody">
                <tr><td colspan="6" class="empty-cell">Chưa có dữ liệu.</td></tr>
            </tbody>
        </table>
    </div>
</section>

@page "/admin/dashboard"
@model WebClient.Pages.Admin.DashboardModel
@{ ViewData["Title"] = "Dashboard doanh thu"; ViewData["AdminPage"] = "dashboard"; }
@section Styles { <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" /> }

<div class="revenue-page" data-admin-dashboard-page>
  <header class="revenue-heading">
    <div><p class="revenue-eyebrow">Báo cáo vận hành</p><h1>Dashboard doanh thu</h1><p>Theo dõi doanh thu đã chốt từ snapshot hằng ngày và trạng thái các đơn gần nhất.</p></div>
    <p class="revenue-period" id="selectedPeriod" aria-live="polite">Đang tải khoảng thời gian…</p>
  </header>

  <section class="revenue-filter" aria-labelledby="filterTitle">
    <div><h2 id="filterTitle">Khoảng báo cáo</h2><p>Dữ liệu tối đa 366 ngày cho mỗi lần truy vấn.</p></div>
    <div class="revenue-presets" id="revenuePresets" role="group" aria-label="Chọn nhanh khoảng báo cáo">
      <button type="button" data-range="today">Hôm nay</button><button type="button" data-range="7days">7 ngày</button><button type="button" data-range="month" class="is-active">Tháng này</button><button type="button" data-range="year">Năm nay</button><button type="button" data-range="custom">Tùy chỉnh</button>
    </div>
    <form class="revenue-custom-range" id="customRangeForm" hidden>
      <label>Từ ngày<input id="dateFrom" name="from" type="date" required /></label><label>Đến ngày<input id="dateTo" name="to" type="date" required /></label><button class="revenue-primary-button" type="submit">Áp dụng</button>
    </form>
  </section>

  <div class="revenue-alert" id="dashboardError" role="alert" hidden><div><strong>Không tải được báo cáo</strong><p id="dashboardErrorMessage"></p></div><button type="button" id="retryDashboard">Thử lại</button></div>

  <section class="revenue-kpis" aria-label="Chỉ số doanh thu">
    <article class="revenue-kpi revenue-kpi-primary"><span>Tổng doanh thu</span><strong id="grossRevenue">—</strong><small id="completedSummary">Đang tải…</small></article>
    <article class="revenue-kpi"><span>Doanh thu thuần</span><strong id="netRevenue">—</strong><small>Sau các khoản điều chỉnh</small></article>
    <article class="revenue-kpi"><span>Tiền cọc đã thu</span><strong id="depositCollected">—</strong><small id="totalBookingSummary">Đang tải…</small></article>
    <article class="revenue-kpi"><span>Giá trị đơn trung bình</span><strong id="averageOrderValue">—</strong><small id="cancelRateSummary">Đang tải…</small></article>
  </section>

  <section class="revenue-panel" aria-labelledby="chartTitle">
    <div class="revenue-panel-heading"><div><h2 id="chartTitle">Doanh thu theo ngày</h2><p>Chiều cao cột dựa trên tổng doanh thu snapshot.</p></div><span id="snapshotCount">0 ngày dữ liệu</span></div>
    <div class="revenue-skeleton revenue-chart-skeleton" id="chartSkeleton" aria-label="Đang tải biểu đồ"></div><div class="revenue-chart" id="revenueChart" hidden></div>
    <div class="revenue-empty" id="chartEmpty" hidden><strong>Chưa có snapshot doanh thu</strong><p>Khoảng này chưa được tổng hợp; hệ thống không tự tạo số liệu ước tính.</p></div>
  </section>

  <section class="revenue-panel" aria-labelledby="recentTitle">
    <div class="revenue-panel-heading"><div><h2 id="recentTitle">Đơn gần đây</h2><p>Tối đa 10 đơn được tạo trong khoảng báo cáo.</p></div><span id="recentCount">—</span></div>
    <div class="revenue-table-wrap"><table><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Xe</th><th>Ngày nhận</th><th>Tổng tiền</th><th>Booking</th><th>Thanh toán</th></tr></thead><tbody id="recentBookingsBody"><tr><td colspan="7"><div class="revenue-row-skeleton"></div></td></tr></tbody></table></div>
    <div class="revenue-empty" id="recentEmpty" hidden><strong>Chưa có đơn trong khoảng này</strong><p>Hãy chọn khoảng thời gian khác để xem hoạt động gần đây.</p></div>
  </section>
</div>
@section Scripts { <script type="module" src="~/js/admin/dashboard.js" asp-append-version="true"></script> }

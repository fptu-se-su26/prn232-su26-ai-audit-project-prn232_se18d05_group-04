@page "/admin/dashboard"
@model WebClient.Pages.Admin.DashboardModel
@{ ViewData["Title"] = "Dashboard doanh thu"; ViewData["AdminPage"] = "dashboard"; }
@section Styles { <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" /> }
<div class="revenue-page" data-admin-dashboard-page>
  <div class="mb-6 flex items-start justify-between gap-4 max-sm:grid"><div><h1 class="m-0 text-3xl font-bold tracking-tight text-zinc-900">Dashboard doanh thu</h1><p class="mt-1.5 max-w-[72ch] text-sm leading-6 text-zinc-600">Theo d&#245;i doanh thu &#273;&#227; ch&#7889;t t&#7915; snapshot h&#7857;ng ng&#224;y v&#224; tr&#7841;ng th&#225;i c&#225;c &#273;&#417;n g&#7847;n nh&#7845;t.</p></div><p class="revenue-period" id="selectedPeriod" aria-live="polite">&#272;ang t&#7843;i...</p></div>
  <section class="mb-6"><div class="flex gap-2 overflow-x-auto whitespace-nowrap pb-1" id="revenuePresets" role="group" aria-label="Ch&#7885;n kho&#7843;ng b&#225;o c&#225;o"><button type="button" data-range="today">H&#244;m nay</button><button type="button" data-range="7days">7 ng&#224;y</button><button type="button" data-range="month" class="is-active">Th&#225;ng n&#224;y</button><button type="button" data-range="year">N&#259;m nay</button><button type="button" data-range="custom">T&#249;y ch&#7881;nh</button></div><form class="revenue-custom-range mt-3" id="customRangeForm" hidden><label>T&#7915; ng&#224;y<input id="dateFrom" name="from" type="date" required></label><label>&#272;&#7871;n ng&#224;y<input id="dateTo" name="to" type="date" required></label><button class="revenue-primary-button" type="submit">&#193;p d&#7909;ng</button></form></section>
  <div class="revenue-alert" id="dashboardError" role="alert" hidden><div><strong>Kh&#244;ng t&#7843;i &#273;&#432;&#7907;c b&#225;o c&#225;o</strong><p id="dashboardErrorMessage"></p></div><button type="button" id="retryDashboard">Th&#7917; l&#7841;i</button></div>
  <section class="grid grid-cols-2 gap-5 max-lg:grid-cols-1">
    <article class="rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm"><div class="mb-5"><h2 class="m-0 text-lg font-semibold tracking-tight">Thu theo &#273;&#417;n ho&#224;n th&#224;nh</h2><p class="mt-1 text-sm text-zinc-500">T&#7893;ng doanh thu trong kho&#7843;ng &#273;&#227; ch&#7885;n.</p></div><div class="rounded-xl border border-emerald-100 bg-emerald-50 p-5"><span class="text-sm font-medium text-emerald-700">T&#7893;ng doanh thu</span><strong id="grossRevenue" class="mt-2 block font-mono text-3xl tracking-tight text-zinc-900">&#8212;</strong><small id="completedSummary" class="mt-2 block text-sm text-zinc-500">&#272;ang t&#7843;i...</small></div><div class="mt-4 flex items-center justify-between border-t border-zinc-100 pt-4"><span class="text-sm text-zinc-500">Doanh thu thu&#7847;n</span><strong id="netRevenue" class="font-mono text-lg">&#8212;</strong></div></article>
    <article class="rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm"><div class="mb-4"><h2 class="m-0 text-lg font-semibold tracking-tight">Ch&#7881; s&#7889; v&#7853;n h&#224;nh</h2><p class="mt-1 text-sm text-zinc-500">C&#7885;c, gi&#225; tr&#7883; &#273;&#417;n v&#224; t&#7927; l&#7879; h&#7911;y.</p></div><div class="divide-y divide-zinc-100"><div class="flex items-center justify-between py-4"><div><span class="block text-sm text-zinc-500">Ti&#7873;n c&#7885;c &#273;&#227; thu</span><small id="totalBookingSummary" class="text-xs text-zinc-400">&#272;ang t&#7843;i...</small></div><strong id="depositCollected" class="font-mono text-lg">&#8212;</strong></div><div class="flex items-center justify-between py-4"><div><span class="block text-sm text-zinc-500">Gi&#225; tr&#7883; &#273;&#417;n trung b&#236;nh</span><small id="cancelRateSummary" class="text-xs text-zinc-400">&#272;ang t&#7843;i...</small></div><strong id="averageOrderValue" class="font-mono text-lg">&#8212;</strong></div></div></article>
  </section>
  <section class="mt-5 rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm" aria-labelledby="chartTitle"><div class="mb-5 flex items-start justify-between gap-4 max-sm:grid"><div><h2 id="chartTitle" class="m-0 text-lg font-semibold tracking-tight">Doanh thu theo ng&#224;y</h2><p class="mt-1 text-sm text-zinc-500">Chi&#7873;u cao c&#7897;t d&#7921;a tr&#234;n snapshot doanh thu.</p></div><span id="snapshotCount" class="rounded-full border border-emerald-100 bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">0 ng&#224;y</span></div><div class="revenue-skeleton revenue-chart-skeleton" id="chartSkeleton"></div><div class="revenue-chart" id="revenueChart" hidden></div><div class="revenue-empty" id="chartEmpty" hidden><strong>Ch&#432;a c&#243; snapshot doanh thu</strong><p>Kho&#7843;ng n&#224;y ch&#432;a &#273;&#432;&#7907;c t&#7893;ng h&#7907;p.</p></div></section>
  <section class="mt-5 rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm" aria-labelledby="recentTitle"><div class="mb-5 flex items-start justify-between gap-4 max-sm:grid"><div><h2 id="recentTitle" class="m-0 text-lg font-semibold tracking-tight">&#272;&#417;n g&#7847;n &#273;&#226;y</h2><p class="mt-1 text-sm text-zinc-500">T&#7889;i &#273;a 10 &#273;&#417;n trong kho&#7843;ng b&#225;o c&#225;o.</p></div><span id="recentCount" class="rounded-full border border-zinc-200 bg-zinc-50 px-3 py-1 text-xs font-semibold text-zinc-600">&#8212;</span></div><div class="revenue-table-wrap"><table><thead><tr><th>M&#227; &#273;&#417;n</th><th>Kh&#225;ch h&#224;ng</th><th>Xe</th><th>Ng&#224;y nh&#7853;n</th><th>T&#7893;ng ti&#7873;n</th><th>Booking</th><th>Thanh to&#225;n</th></tr></thead><tbody id="recentBookingsBody"><tr><td colspan="7"><div class="revenue-row-skeleton"></div></td></tr></tbody></table></div><div class="revenue-empty" id="recentEmpty" hidden><strong>Ch&#432;a c&#243; &#273;&#417;n trong kho&#7843;ng n&#224;y</strong></div></section>
</div>
@section Scripts { <script type="module" src="~/js/admin/dashboard.js" asp-append-version="true"></script> }

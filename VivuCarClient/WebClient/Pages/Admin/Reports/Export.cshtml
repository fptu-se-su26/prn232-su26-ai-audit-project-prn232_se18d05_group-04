@page "/admin/reports/export"
@model WebClient.Pages.Admin.Reports.ExportModel
@{ViewData["Title"]="Xuất báo cáo";ViewData["AdminPage"]="reports";}
@section Styles{<link rel="stylesheet" href="~/css/admin-export.css" asp-append-version="true"/>}
<div class="export-page" data-admin-reports-page>
<header class="export-heading"><div><p class="export-eyebrow">Đối soát dữ liệu</p><h1>Xuất báo cáo</h1><p>Tạo file từ dữ liệu database, theo dõi trạng thái và tải lại từ lịch sử.</p></div><span>CSV + PDF</span></header>
<section class="export-controls"><fieldset><legend>Loại báo cáo</legend><div class="export-types"><label><input type="radio" name="export_type" value="payments" checked><span>Giao dịch</span></label><label><input type="radio" name="export_type" value="users"><span>Khách hàng</span></label><label><input type="radio" name="export_type" value="cars"><span>Danh sách xe</span></label><label><input type="radio" name="export_type" value="revenue"><span>Doanh thu</span></label></div></fieldset>
<form id="exportFilterForm" class="export-filter"><label>Từ ngày<input id="exportDateFrom" type="date" required></label><label>Đến ngày<input id="exportDateTo" type="date" required></label><label>Thanh toán<select id="paymentStatusFilter"><option value="">Tất cả</option><option value="success">Thành công</option><option value="pending">Chờ thanh toán</option><option value="failed">Thất bại</option><option value="refunded">Đã hoàn tiền</option></select></label><label>Booking<select id="bookingStatusFilter"><option value="">Tất cả</option><option value="pending">Chờ xử lý</option><option value="approved">Đã xác nhận</option><option value="completed">Hoàn tất</option><option value="cancelled">Đã hủy</option><option value="rejected">Đã từ chối</option></select></label><button class="export-primary" type="submit">Xem trước</button></form></section>
<div id="exportError" class="export-error" role="alert" hidden></div>
<section class="export-panel"><div class="export-panel-head"><div><h2>Preview dữ liệu</h2><p id="previewCount">Tối đa 100 dòng trên màn hình.</p></div><div><button id="btnExportCsv" type="button">Tạo CSV</button><button id="btnExportPdf" class="export-primary" type="button">Tạo PDF</button></div></div><div id="reportPreview" class="export-preview"><div class="export-skeleton"></div></div></section>
<section class="export-panel"><div class="export-panel-head"><div><h2>Lịch sử export</h2><p>50 yêu cầu gần nhất của tài khoản hiện tại.</p></div><button id="refreshJobs" type="button">Làm mới</button></div><div class="export-table-wrap"><table><thead><tr><th>ID</th><th>Loại</th><th>Trạng thái</th><th>Tạo lúc</th><th>Hoàn tất</th><th></th></tr></thead><tbody id="exportJobsBody"><tr><td colspan="6"><div class="export-row-skeleton"></div></td></tr></tbody></table></div><div id="jobsEmpty" class="export-empty" hidden>Chưa có yêu cầu export.</div></section>
</div>
@section Scripts{<script type="module" src="~/js/admin/reports/export.js" asp-append-version="true"></script>}

@page "/admin/reports/export"
@model WebClient.Pages.Admin.Reports.ExportModel
@{
    ViewData["Title"] = "Xuất báo cáo";
    ViewData["AdminPage"] = "reports";
}
<div data-admin-reports-page>

<div class="page-heading"><div><h1>Xuất báo cáo</h1><p>Preview từ bảng `payments`, `users`, `cars`, `daily_revenue_snapshots`; lịch sử export lưu mock vào `export_jobs`.</p></div></div>
    <section class="report-types" id="reportTypes"><label class="radio-card"><input type="radio" name="reportType" value="payments" checked>Giao dịch</label><label class="radio-card"><input type="radio" name="reportType" value="users">Khách hàng</label><label class="radio-card"><input type="radio" name="reportType" value="cars">Danh sách xe</label><label class="radio-card"><input type="radio" name="reportType" value="revenue">Doanh thu</label></section>
    <section class="toolbar toolbar-export"><input id="exportDateFrom" type="date"><input id="exportDateTo" type="date"><select id="paymentStatusFilter"><option value="">Tất cả thanh toán</option><option value="success">Thành công</option><option value="pending">Chờ thanh toán</option><option value="refunded">Đã hoàn tiền</option><option value="failed">Thất bại</option></select><select id="bookingStatusFilter"><option value="">Tất cả đơn</option><option value="completed">Hoàn tất</option><option value="cancelled">Đã hủy</option><option value="approved">Đã xác nhận</option><option value="pending">Chờ xử lý</option><option value="rejected">Đã từ chối</option></select><button class="btn btn-primary" id="btnPreviewReport">Xem trước</button></section>
    <section class="panel"><div class="panel-head"><h2>Preview dữ liệu</h2><div class="actions"><button class="btn btn-primary btn-sm" id="btnExportExcel">Xuất Excel</button><button class="btn btn-primary btn-sm" id="btnExportPdf">Xuất PDF</button></div></div><div id="reportPreview" class="table-wrap"></div></section>
    <section class="panel"><div class="panel-head"><h2>Lịch sử export_jobs</h2></div><div class="table-wrap"><table><thead><tr><th>ID</th><th>Loại</th><th>Trạng thái</th><th>File</th><th>Tạo lúc</th></tr></thead><tbody id="exportJobsBody"></tbody></table></div></section>

<div class="modal-backdrop" id="pdfExportModal"><div class="modal"><div class="modal-header"><h2>Tùy chọn PDF</h2><button class="icon-button" type="button" data-close-modal>×</button></div><label>Tiêu đề báo cáo<input id="pdfTitle" value="Báo cáo VivuCar"></label><label class="check-row"><input id="includeLogo" type="checkbox" checked> Hiển thị logo công ty</label><label class="check-row"><input id="includeFooter" type="checkbox" checked> Hiển thị footer</label><div class="modal-actions"><button class="btn btn-secondary" data-close-modal>Hủy</button><button class="btn btn-primary" id="btnCreatePdf">Tạo PDF</button></div></div></div>
</div>
@section Styles { <link rel="stylesheet" href="~/css/admin-export.css" asp-append-version="true" /> }
@section Scripts { <script type="module" src="~/js/admin/reports/export.js" asp-append-version="true"></script> }

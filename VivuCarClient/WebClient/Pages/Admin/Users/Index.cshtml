        <label class="field"><span>Tr&#7841;ng th&#225;i</span><select id="blockedFilter"><option value="">T&#7845;t c&#7843;</option><option value="false">&#272;ang ho&#7841;t &#273;&#7897;ng</option><option value="true">&#272;&#227; kh&#243;a</option></select></label>

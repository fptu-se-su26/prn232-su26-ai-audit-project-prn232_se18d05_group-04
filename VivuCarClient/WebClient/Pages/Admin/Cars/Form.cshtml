@page "/admin/cars/form"
@model WebClient.Pages.Admin.Cars.FormModel
@{
    ViewData["Title"] = "Biểu mẫu phương tiện";
    ViewData["AdminPage"] = "cars";
}
<div data-admin-car-form data-car-id="@Model.Id">

<div class="page-heading">
            <div>
              <p class="breadcrumb">Admin / Quản lý xe / Form xe</p>
              <h1 id="carFormTitle">Thêm xe mới</h1>
              <p>
                Field form dùng tên cột DB: `license_plate`, `price_per_day`,
                `price_per_hours`.
              </p>
            </div>
          </div>
          <form id="carForm" class="form-stack" novalidate>
            <select id="owner_id" name="owner_id" class="hidden" aria-hidden="true"></select>
            <select id="car_model_id" name="car_model_id" class="hidden" aria-hidden="true"></select>
            <section class="form-card">
              <h2>Thông tin cơ bản</h2>
              <div class="form-grid">
                <div class="field">
                  <label for="license_plate">Biển số xe</label
                  ><input
                    id="license_plate"
                    name="license_plate"
                    placeholder="43A-12345"
                  />
                </div>
                <div class="field">
                  <label for="brand">Hãng xe</label
                  ><input id="brand" name="brand" placeholder="Toyota" />
                </div>
                <div class="field">
                  <label for="model">Dòng xe</label
                  ><input
                    id="model"
                    name="model"
                    placeholder="Vios, City, CX-5"
                  />
                </div>
                <div class="field">
                  <label for="type_id">Loại xe</label
                  ><select id="type_id" name="type_id"></select>
                </div>
                <div class="field">
                  <label for="year">Năm sản xuất</label
                  ><input
                    id="year"
                    name="year"
                    type="number"
                    min="1900"
                    max="2026"
                  />
                </div>
                <div class="field">
                  <label for="color">Màu sắc</label
                  ><input id="color" name="color" placeholder="Trắng" />
                </div>
                <div class="field">
                  <label for="seats">Số chỗ</label
                  ><input id="seats" name="seats" type="number" min="1" />
                </div>
                <div class="field">
                  <label for="kilometers_driven">Số km đã đi</label
                  ><input
                    id="kilometers_driven"
                    name="kilometers_driven"
                    type="number"
                    min="1"
                  />
                </div>
              </div>
            </section>
            <section class="form-card">
              <h2>Thông số và địa chỉ</h2>
              <div class="form-grid">
                <div class="field">
                  <label for="transmission">Hộp số</label
                  ><select id="transmission" name="transmission">
                    <option value="manual">Số sàn</option>
                    <option value="automatic">Tự động</option>
                    <option value="cvt">CVT</option>
                  </select>
                </div>
                <div class="field">
                  <label for="fuel_type">Nhiên liệu</label
                  ><select id="fuel_type" name="fuel_type">
                    <option value="gasoline">Xăng</option>
                    <option value="diesel">Dầu</option>
                    <option value="electric">Điện</option>
                    <option value="hybrid">Hybrid</option>
                  </select>
                </div>
                <div class="field">
                  <label for="address">Địa chỉ nhận xe</label
                  ><input
                    id="address"
                    name="address"
                    placeholder="Hải Châu, Đà Nẵng"
                  />
                </div>
                <div class="field">
                  <label for="status">Trạng thái</label
                  ><select id="status" name="status">
                    <option value="available">Đang rảnh</option>
                    <option value="rented">Đang thuê</option>
                    <option value="maintenance">Bảo trì</option>
                    <option value="blocked">Đã khóa</option>
                  </select>
                </div>
                <div class="field full">
                  <label for="description">Mô tả xe</label
                  ><textarea
                    id="description"
                    name="description"
                    placeholder="Mô tả tiện nghi, tình trạng xe"
                  ></textarea>
                </div>
              </div>
            </section>
            <section class="form-card">
              <h2>Giá thuê</h2>
              <div class="form-grid">
                <div class="field">
                  <label for="price_per_day">Giá thuê theo ngày</label
                  ><input
                    id="price_per_day"
                    name="price_per_day"
                    type="number"
                    placeholder="700000"
                  />
                </div>
                <div class="field">
                  <label for="price_per_hours">Giá thuê theo giờ</label
                  ><input
                    id="price_per_hours"
                    name="price_per_hours"
                    type="number"
                    placeholder="90000"
                  />
                </div>
              </div>
            </section>
            <section class="form-card">
              <div class="flex items-start justify-between gap-4 max-sm:grid">
                <div>
                  <h2 class="!mb-1">Hình ảnh xe</h2>
                  <p class="text-sm text-zinc-500">Ảnh chính được ưu tiên hiển thị trên danh sách và trang chi tiết xe.</p>
                </div>
                <span id="existingImageCount" class="rounded-full border border-zinc-200 bg-zinc-50 px-3 py-1 text-xs font-semibold text-zinc-600">Đang tải</span>
              </div>

              <div id="imagePreviewGrid" class="image-preview-grid" aria-live="polite"></div>

              <div class="upload-zone mt-5">
                <label for="carImages" class="text-sm font-semibold text-zinc-800">Thêm ảnh mới</label>
                <input
                  id="carImages"
                  name="car_images"
                  type="file"
                  accept="image/jpeg,image/png,image/webp"
                  multiple
                />
                <small>Tối đa 8 ảnh cho mỗi xe, mỗi ảnh không quá 5MB.</small>
                <button
                  class="btn btn-secondary btn-sm hidden justify-self-start"
                  id="btnClearImages"
                  type="button"
                >
                  Bỏ ảnh mới chọn
                </button>
              </div>

              <div id="selectedImageSection" class="mt-4 hidden">
                <div class="flex items-center justify-between gap-3">
                  <h3 class="text-sm font-semibold text-zinc-800">Ảnh mới chờ tải lên</h3>
                  <span id="selectedImageCount" class="text-xs font-medium text-zinc-500"></span>
                </div>
                <div id="selectedImagePreviewGrid" class="image-preview-grid"></div>
              </div>
            </section>
            <div id="carFormError" class="alert alert-error hidden"></div>
            <div class="sticky-actions">
              <a class="btn btn-secondary" href="/admin/cars">Hủy</a
              ><button
                class="btn btn-secondary"
                id="btnSaveDraft"
                type="button"
              >
                Lưu nháp</button
              ><button class="btn btn-primary" id="btnSaveCar" type="submit">
                Lưu xe
              </button>
            </div>
          </form>
</div>
@section Scripts { <script type="module" src="~/js/admin/cars/form.js" asp-append-version="true"></script> }

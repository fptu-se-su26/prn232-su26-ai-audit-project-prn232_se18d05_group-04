@page "/admin/vouchers"
@model WebClient.Pages.Admin.Vouchers.IndexModel
@{ ViewData["Title"] = "Voucher"; ViewData["AdminPage"] = "vouchers"; }
<div class="grid gap-5" data-admin-vouchers-page>
  <header class="page-heading"><div><p class="eyebrow">Voucher management</p><h1>Qu&#7843;n l&#253; voucher</h1><p>Theo d&#245;i h&#7841;n d&#249;ng, s&#7889; l&#432;&#7907;t c&#242;n l&#7841;i v&#224; hi&#7879;u qu&#7843; t&#7915;ng chi&#7871;n d&#7883;ch.</p></div><a class="btn btn-primary" href="/admin/vouchers/form">T&#7841;o voucher</a></header>
  <section id="voucherSummary" class="summary-grid" aria-label="T&#7893;ng quan voucher"></section>
  <section class="toolbar toolbar-admin-users" aria-label="B&#7897; l&#7885;c voucher">

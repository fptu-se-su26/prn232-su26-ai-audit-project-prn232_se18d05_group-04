    <label class="field"><span>Lo&#7841;i gi&#7843;m</span><select id="discountTypeFilter"><option value="">T&#7845;t c&#7843;</option><option value="percentage">Ph&#7847;n tr&#259;m</option><option value="fixed">S&#7889; ti&#7873;n c&#7889; &#273;&#7883;nh</option></select></label>

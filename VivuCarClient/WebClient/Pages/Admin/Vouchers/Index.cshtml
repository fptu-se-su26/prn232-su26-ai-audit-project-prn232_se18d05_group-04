@page "/admin/vouchers"
@model WebClient.Pages.Admin.Vouchers.IndexModel
@{
    ViewData["Title"] = "Quan ly voucher";
    ViewData["AdminPage"] = "vouchers";
}

<div data-admin-vouchers-page>
    <header class="page-heading">
        <div><p class="eyebrow">VOUCHER MANAGEMENT</p><h1>Quan ly voucher</h1><p>Theo di hnDa dung, s lut cn li v hiu qu tng chin dch.</p></div>
        <a class="btn btn-primary" href="/admin/vouchers/form">To voucher</a>
    </header>

    <section id="voucherSummary" class="summary-grid" aria-label="Tong quan voucher"></section>
    <section class="panel voucher-toolbar" aria-label="B lc voucher">
        <label class="field"><span>Tim kiem</span><input id="searchVoucherInput" placeholder="M hoc tn voucher" /></label>
        <label class="field"><span>Trang thai</span><select id="voucherStatusFilter"><option value="">Tat ca</option><option value="active">Dang hoat dong</option><option value="expired">Da het han</option><option value="used_up">Da dung het</option></select></label>
        <label class="field"><span>Loai giam</span><select id="discountTypeFilter"><option value="">Tat ca</option><option value="percentage">Phan tram</option><option value="fixed">S tin c dnh</option></select></label>
        <button class="btn btn-secondary" id="btnResetVoucherFilter" type="button">Dat lai</button>
    </section>

    <section class="panel">
        <div class="table-wrap"><table><thead><tr><th>Voucher</th><th>Loi</th><th>Gia tri</th><th>Dieu kien toi thieu</th><th>Da dung</th><th>Het han</th><th>Trang thai</th><th class="table-actions">Thao tac</th></tr></thead><tbody id="voucherTableBody"><tr><td colspan="8" class="empty-cell">Dang tai voucher</td></tr></tbody></table></div>
        <div class="pagination-bar"><p id="voucherPageInfo"></p><div><button class="btn btn-secondary" id="voucherPrev" type="button">Truoc</button><button class="btn btn-secondary" id="voucherNext" type="button">Suau</button></div></div>
    </section>

    <div id="drawerOverlay" class="drawer-overlay" hidden></div>
    <aside class="drawer" id="voucherPerformanceDrawer" aria-hidden="true"><div class="drawer-head"><div><p class="eyebrow">PERFORMANCE</p><h2>Hieu qua voucher</h2></div><button class="icon-button" id="btnClosePerformance" type="button" aria-label="ng"></button></div><div id="performanceContent"></div></aside>
</div>

@section Scripts { <script type="module" src="~/js/admin/vouchers/index.js" asp-append-version="true"></script> }



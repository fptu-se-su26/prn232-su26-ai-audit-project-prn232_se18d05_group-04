  <section class="panel"><div class="table-wrap"><table><thead><tr><th>Voucher</th><th>Lo&#7841;i</th><th>Gi&#225; tr&#7883;</th><th>&#272;&#417;n t&#7889;i thi&#7875;u</th><th>&#272;&#227; d&#249;ng</th><th>H&#7871;t h&#7841;n</th><th>Tr&#7841;ng th&#225;i</th><th>Thao t&#225;c</th></tr></thead><tbody id="voucherTableBody"><tr><td colspan="8" class="empty-cell">&#272;ang t&#7843;i voucher...</td></tr></tbody></table></div><div class="pagination-bar"><p id="voucherPageInfo"></p><div class="flex gap-2"><button class="btn btn-secondary" id="voucherPrev" type="button">Tr&#432;&#7899;c</button><button class="btn btn-secondary" id="voucherNext" type="button">Sau</button></div></div></section>

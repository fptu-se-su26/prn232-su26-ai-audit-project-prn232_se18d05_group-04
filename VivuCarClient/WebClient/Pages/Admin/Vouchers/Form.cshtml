@page "/admin/vouchers/form"
@model WebClient.Pages.Admin.Vouchers.FormModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "Sua voucher" : "To voucher";
    ViewData["AdminPage"] = "vouchers";
}

<div data-admin-voucher-form-page>
    <header class="page-heading"><div><p class="breadcrumb"><a href="/admin/vouchers">Voucher</a> / @(Model.Id.HasValue ? "Chnh sa" : "To mi")</p><h1>@(Model.Id.HasValue ? "Chnh sa voucher" : "To voucher")</h1><p>M voucher duc chun ha vit hoa; lut sDa dung duc tnh t lch s pDa dung.</p></div></header>
    <form id="voucherForm" class="voucher-form-layout" data-admin-voucher-form data-voucher-id="@Model.Id" novalidate>
        <div class="form-stack">
            <section class="form-card"><h2>Thng tin co bn</h2><div class="form-grid"><label class="field"><span>Tn chuong trnh</span><input id="name" name="name" maxlength="100" required placeholder="Khuyn mi ma h" /></label><label class="field"><span>M voucher</span><input id="code" name="code" maxlength="50" required placeholder="SUMMER2026" autocomplete="off" /></label></div></section>
            <section class="form-card"><h2>Mc gim</h2><div class="report-types"><label class="radio-card"><input name="discount_type" value="percentage" type="radio" checked />Theo phn tram</label><label class="radio-card"><input name="discount_type" value="fixed" type="radio" />S tin c dnh</label></div><div class="form-grid"><label class="field"><span>Gia tri gim</span><input id="discount_value" name="discount_value" type="number" min="0.01" step="0.01" required /></label><label class="field"><span>Gim ti da</span><input id="max_discount" name="max_discount" type="number" min="1" step="1000" required /></label></div></section>
            <section class="form-card"><h2>iu kin sDa dung</h2><div class="form-grid"><label class="field"><span>Gia tri don ti thiu</span><input id="min_order_amount" name="min_order_amount" type="number" min="0" step="1000" value="0" required /></label><label class="field"><span>Tong s lung</span><input id="quantity" name="quantity" type="number" min="0" step="1" required /></label><label class="field"><span>NgyDa het han</span><input id="expires_at" name="expires_at" type="datetime-local" /><small> trng nu khng gii hn thi gian.</small></label></div></section>
            <div id="voucherError" class="alert alert-error" hidden role="alert"></div><div class="sticky-actions"><a class="btn btn-secondary" href="/admin/vouchers">Huy</a><button class="btn btn-primary" id="btnSuaveVoucher" type="submit">Luu voucher</button></div>
        </div>
        <aside class="voucher-preview panel"><p class="eyebrow">LIVE PREVIEW</p><strong id="voucherPreviewCode">SUMMER2026</strong><h2 id="voucherPreviewValue">Gim 10%</h2><p id="voucherPreviewName">Khuyn mi ma h</p><p id="voucherPreviewCondition">on ti thiu 0 </p></aside>
    </form>
</div>

@section Scripts { <script type="module" src="~/js/admin/vouchers/form.js" asp-append-version="true"></script> }




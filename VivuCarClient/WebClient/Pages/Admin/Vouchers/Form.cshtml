@page "/admin/vouchers/form"
@model WebClient.Pages.Admin.Vouchers.FormModel
@{
    ViewData["Title"] = "Biểu mẫu voucher";
    ViewData["AdminPage"] = "vouchers";
}
@* UI-only fields is_active and usage_limit_per_user are not present in the current DB schema. *@
<div class="page-heading"><div><p class="breadcrumb">Admin / Khuyến mãi / Tạo voucher</p><h1>Tạo mã giảm giá</h1><p>Field bám bảng `vouchers`. `usage_limit_per_user`, `is_active`, `start_date` không được persist vì chưa có trong DB.</p></div></div>
    <div class="two-column">
      <form id="voucherForm" class="form-stack" data-admin-voucher-form data-voucher-id="@Model.Id" novalidate>
        <section class="form-card"><h2>Thông tin voucher</h2><div class="field"><label for="code">Mã voucher</label><input id="code" name="code" placeholder="SUMMER2026"></div><div class="field"><label for="name">Tên chương trình</label><input id="name" name="name" placeholder="Khuyến mãi hè 2026"></div></section>
        <section class="form-card"><h2>Giá trị giảm</h2><div class="report-types"><label class="radio-card"><input id="discountTypePercentage" name="discount_type" value="percentage" type="radio" checked>Giảm theo phần trăm</label><label class="radio-card"><input id="discountTypeFixed" name="discount_type" value="fixed" type="radio">Giảm số tiền cố định</label></div><div class="form-grid"><div class="field"><label for="discount_value">Giá trị giảm</label><input id="discount_value" name="discount_value" type="number" placeholder="10"></div><div class="field"><label for="max_discount">Giảm tối đa</label><input id="max_discount" name="max_discount" type="number" placeholder="250000"></div></div></section>
        <section class="form-card"><h2>Điều kiện</h2><div class="form-grid"><div class="field"><label for="min_order_amount">Đơn tối thiểu</label><input id="min_order_amount" name="min_order_amount" type="number" placeholder="500000"></div><div class="field"><label for="quantity">Số lượng voucher</label><input id="quantity" name="quantity" type="number" placeholder="100"></div><div class="field"><label for="expires_at">Ngày hết hạn</label><input id="expires_at" name="expires_at" type="datetime-local"></div><div class="field"><label for="usage_limit_per_user">Lượt mỗi khách</label><input id="usage_limit_per_user" type="number" placeholder="1"><small>UI-only field. Not present in current DB schema. Requires migration before backend integration.</small></div></div><label class="switch-row"><input id="is_active" type="checkbox" checked><span>Kích hoạt ngay</span></label><small class="muted">UI-only field. Not present in current DB schema. Requires migration before backend integration.</small></section>
        <div id="voucherError" class="alert alert-error hidden"></div><div class="sticky-actions"><a class="btn btn-secondary" href="/admin/vouchers">Hủy</a><button class="btn btn-secondary" id="btnSaveVoucherDraft" type="button">Lưu nháp</button><button class="btn btn-primary" id="btnCreateVoucher" type="submit">Tạo voucher</button></div>
      </form>
      <aside class="voucher-preview" id="voucherPreview"></aside>
    </div>
@section Scripts { <script type="module" src="~/js/admin/vouchers/form.js" asp-append-version="true"></script> }

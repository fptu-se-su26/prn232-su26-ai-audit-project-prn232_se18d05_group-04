@page
@model VivuCarClient.WebClient.Pages.Booking.CheckoutModel
@{
    Layout = "_UserLayout";
    ViewData["Title"] = "Đặt xe";
    ViewData["DataPage"] = "bookings";
}

<main class="page-shell booking-shell">
  <div id="breadcrumbMount"></div>
  <div class="flow-steps">
    <span class="flow-step active">Thông tin thuê</span>
    <span class="flow-step">Kiểm tra lịch</span>
    <span class="flow-step">Thanh toán cọc</span>
    <span class="flow-step">Xác nhận</span>
  </div>
  <section id="checkoutRoot" class="checkout-layout"></section>
</main>

@section Scripts {
  <script type="module" src="~/js/html/booking-checkout.js" asp-append-version="true"></script>
}

@{
    Layout = "_UserLayout";
    ViewData["DataLayout"] = "profile";
    ViewData["BodyClass"] = "min-h-[100dvh] bg-[#f7f7f5] text-[#1f1f1f] font-sans antialiased overflow-x-hidden";
}

<main class="page-shell profile-layout">
    <div id="profileSidebarMount"></div>
    <section id="profileRoot">
        @RenderBody()
    </section>
</main>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}

<!-- Overlay -->
<div id="chatbotOverlay" class="chatbot-overlay" onclick="VivuCarChatbot.closeChat()"></div>

<!-- Floating button -->
<button id="chatbotFloatingButton" class="chatbot-floating-btn float-anim" onclick="VivuCarChatbot.toggleChat()">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
    Hỗ trợ
    <span id="chatbotBadge" class="chatbot-badge" style="display:none">0</span>
</button>

<!-- Slide panel -->
<div id="chatbotPanel" class="chatbot-panel">
    <div class="chatbot-header">
        <div>
            <h5>VivuCar Assistant</h5>
            <small>Online</small>
        </div>
        <div class="chatbot-header-actions">
            <button class="chatbot-icon-btn" onclick="VivuCarChatbot.closeChat()">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>
        </div>
    </div>

    <div id="chatbotMessages" class="chatbot-messages">
        <!-- Messages -->
    </div>

    <div id="chatbotQuickReplies" class="chatbot-quick-replies">
        <button class="quick-reply-btn" onclick="VivuCarChatbot.sendQuickReply('Tôi muốn tìm xe')">Tìm xe</button>
        <button class="quick-reply-btn" onclick="VivuCarChatbot.sendQuickReply('Cách thanh toán tiền cọc')">Thanh toán cọc</button>
        <button class="quick-reply-btn" onclick="VivuCarChatbot.sendQuickReply('Tôi muốn hủy đơn')">Hủy đơn</button>
        <button class="quick-reply-btn" onclick="VivuCarChatbot.sendQuickReply('Tôi cần trả xe')">Trả xe</button>
    </div>

    <div class="chatbot-input-area">
        <div class="chatbot-input-row">
            <input type="text" id="chatbotInput" placeholder="Nhập câu hỏi..." onkeypress="VivuCarChatbot.handleEnter(event)" />
            <button onclick="VivuCarChatbot.sendMessage()">Gửi</button>
        </div>
    </div>
</div>

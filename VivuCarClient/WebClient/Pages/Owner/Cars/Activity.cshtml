@page
@model WebClient.Pages.Owner.Cars.ActivityModel
@{
    ViewData["Title"] = "Lịch sử hoạt động xe";
    ViewData["OwnerPage"] = "cars";
}

<div class="space-y-6 pb-12">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-4">
            <a href="/Owner/Cars/Index" class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-white border border-zinc-200 text-zinc-600 hover:text-primary hover:border-primary/30 hover:bg-primary/5 transition-colors">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            </a>
            <div>
                <h2 class="text-xl font-bold text-zinc-900">Lịch sử hoạt động xe</h2>
                <p class="text-sm text-zinc-500 mt-0.5" id="carSubtitle">Đang tải...</p>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <button id="btnExportHistoryCsv" class="inline-flex items-center gap-2 rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm font-medium text-zinc-700 hover:bg-zinc-50 transition-colors">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                Xuất CSV
            </button>
            <button id="btnExportHistoryPdf" class="inline-flex items-center gap-2 rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm font-medium text-zinc-700 hover:bg-zinc-50 transition-colors">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                In PDF
            </button>
        </div>
    </div>

    <!-- Car Header Card -->
    <div class="bg-white rounded-xl border border-zinc-200 shadow-sm p-6">
        <div id="carHeaderSkeleton" class="flex items-center gap-4">
            <div class="w-24 h-16 rounded-lg bg-zinc-100 animate-pulse"></div>
            <div class="flex-1 space-y-2">
                <div class="h-5 bg-zinc-100 rounded animate-pulse w-56"></div>
                <div class="h-3 bg-zinc-100 rounded animate-pulse w-40"></div>
                <div class="h-3 bg-zinc-100 rounded animate-pulse w-28"></div>
            </div>
        </div>
        <div id="carHeaderContent" class="hidden flex items-center gap-5">
            <img id="carImage" src="" alt="Car" class="w-24 h-16 rounded-lg object-cover border border-zinc-200" />
            <div class="flex-1 min-w-0">
                <div class="flex items-center gap-3 flex-wrap">
                    <h3 id="carName" class="font-bold text-zinc-900 text-lg"></h3>
                    <span id="currentStatusBadge"></span>
                </div>
                <div class="flex items-center gap-4 mt-1 flex-wrap">
                    <span id="carLicensePlate" class="font-mono bg-zinc-100 px-2 py-0.5 rounded text-xs border border-zinc-200"></span>
                    <span class="text-sm text-zinc-500 flex items-center gap-1">
                        <svg class="h-3.5 w-3.5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                        <span id="carRating"></span>
                    </span>
                    <span class="text-sm text-zinc-500"><span id="carTotalBookings" class="font-semibold text-zinc-700"></span> lượt thuê</span>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
        <div class="bg-white rounded-xl border border-zinc-200 shadow-sm p-4">
            <p class="text-xs text-zinc-500 font-medium uppercase tracking-wide">Tổng lượt thuê</p>
            <p class="text-2xl font-bold text-zinc-900 mt-1" id="totalRentals">-</p>
        </div>
        <div class="bg-white rounded-xl border border-zinc-200 shadow-sm p-4">
            <p class="text-xs text-zinc-500 font-medium uppercase tracking-wide">Tổng doanh thu</p>
            <p class="text-2xl font-bold text-zinc-900 mt-1" id="totalRevenue">-</p>
        </div>
        <div class="bg-white rounded-xl border border-zinc-200 shadow-sm p-4">
            <p class="text-xs text-zinc-500 font-medium uppercase tracking-wide">Số ngày hoạt động</p>
            <p class="text-2xl font-bold text-zinc-900 mt-1" id="activeDays">-</p>
        </div>
        <div class="bg-white rounded-xl border border-zinc-200 shadow-sm p-4">
            <p class="text-xs text-zinc-500 font-medium uppercase tracking-wide">Tỷ lệ khai thác</p>
            <p class="text-2xl font-bold text-zinc-900 mt-1" id="utilizationRate">-</p>
        </div>
        <div class="bg-white rounded-xl border border-zinc-200 shadow-sm p-4">
            <p class="text-xs text-zinc-500 font-medium uppercase tracking-wide">Số lần bảo trì</p>
            <p class="text-2xl font-bold text-zinc-900 mt-1" id="maintenanceCount">-</p>
        </div>
    </div>

    <!-- Filter -->
    <div class="bg-white rounded-xl border border-zinc-200 shadow-sm p-4">
        <div class="flex flex-col sm:flex-row gap-3 items-end">
            <div class="w-full sm:w-48">
                <label class="block text-xs font-medium text-zinc-500 mb-1">Khoảng thời gian</label>
                <select id="historyRange" class="block w-full px-3 py-2 border border-zinc-300 rounded-lg focus:ring-primary focus:border-primary text-sm">
                    <option value="LAST_30_DAYS">30 ngày gần đây</option>
                    <option value="LAST_3_MONTHS">3 tháng gần đây</option>
                    <option value="THIS_YEAR">Năm nay</option>
                    <option value="CUSTOM">Tùy chỉnh</option>
                </select>
            </div>
            <div id="customDateRange" class="hidden flex gap-3">
                <div>
                    <label class="block text-xs font-medium text-zinc-500 mb-1">Từ ngày</label>
                    <input type="date" id="historyDateFrom" class="block px-3 py-2 border border-zinc-300 rounded-lg focus:ring-primary focus:border-primary text-sm" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-zinc-500 mb-1">Đến ngày</label>
                    <input type="date" id="historyDateTo" class="block px-3 py-2 border border-zinc-300 rounded-lg focus:ring-primary focus:border-primary text-sm" />
                </div>
            </div>
            <button id="btnApplyHistoryFilter" class="inline-flex items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-medium text-white hover:bg-primary/90 transition-colors">
                Áp dụng
            </button>
        </div>
    </div>

    <!-- Activity Chart -->
    <div class="bg-white rounded-xl border border-zinc-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-zinc-200 bg-zinc-50/50">
            <h3 class="text-base font-semibold text-zinc-900">Biểu đồ hoạt động</h3>
            <p class="text-xs text-zinc-500 mt-0.5">Số ngày được thuê theo tuần/tháng</p>
        </div>
        <div class="p-6" id="activityChart">
            <div class="flex items-end gap-1 h-32" id="activityChartBars">
                <!-- Bars injected by JS -->
            </div>
            <div class="flex gap-1 mt-1" id="activityChartLabels">
                <!-- Labels injected by JS -->
            </div>
        </div>
    </div>

    <!-- Activity Timeline -->
    <div class="bg-white rounded-xl border border-zinc-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-zinc-200 bg-zinc-50/50">
            <h3 class="text-base font-semibold text-zinc-900">Timeline hoạt động</h3>
        </div>
        <div class="p-6">
            <div class="relative" id="carActivityTimeline">
                <div class="absolute left-4 top-0 h-full w-0.5 bg-zinc-200"></div>
                <ul class="space-y-4 relative" id="timelineItems">
                    <li class="pl-10 text-sm text-zinc-400 italic">Đang tải timeline...</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Rental History Table -->
    <div class="bg-white rounded-xl border border-zinc-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-zinc-200 bg-zinc-50/50">
            <h3 class="text-base font-semibold text-zinc-900">Lịch sử chuyến thuê</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left whitespace-nowrap">
                <thead class="text-xs text-zinc-500 uppercase bg-zinc-50 border-b border-zinc-200">
                    <tr>
                        <th class="px-6 py-3 font-semibold">Mã đơn</th>
                        <th class="px-6 py-3 font-semibold">Khách hàng</th>
                        <th class="px-6 py-3 font-semibold">Thời gian thuê</th>
                        <th class="px-6 py-3 font-semibold">Số ngày</th>
                        <th class="px-6 py-3 font-semibold">Tổng tiền</th>
                        <th class="px-6 py-3 font-semibold">Trạng thái</th>
                        <th class="px-6 py-3 font-semibold">Đánh giá</th>
                        <th class="px-6 py-3 text-right font-semibold">Hành động</th>
                    </tr>
                </thead>
                <tbody id="rentalHistoryTbody" class="divide-y divide-zinc-100">
                    <tr><td colspan="8" class="px-6 py-8 text-center text-zinc-400 text-sm">Đang tải...</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Maintenance History Table -->
    <div class="bg-white rounded-xl border border-zinc-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-zinc-200 bg-zinc-50/50">
            <h3 class="text-base font-semibold text-zinc-900">Lịch sử bảo trì</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left whitespace-nowrap">
                <thead class="text-xs text-zinc-500 uppercase bg-zinc-50 border-b border-zinc-200">
                    <tr>
                        <th class="px-6 py-3 font-semibold">Mã bảo trì</th>
                        <th class="px-6 py-3 font-semibold">Lý do</th>
                        <th class="px-6 py-3 font-semibold">Ngày bắt đầu</th>
                        <th class="px-6 py-3 font-semibold">Ngày kết thúc</th>
                        <th class="px-6 py-3 font-semibold">Ghi chú</th>
                        <th class="px-6 py-3 font-semibold">Trạng thái</th>
                    </tr>
                </thead>
                <tbody id="maintenanceHistoryTbody" class="divide-y divide-zinc-100">
                    <tr><td colspan="6" class="px-6 py-8 text-center text-zinc-400 text-sm italic">Chưa có lịch sử bảo trì nào được ghi nhận.</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const carId = @Model.Id;

        const activityHistoryState = {
            carId: carId,
            range: "LAST_30_DAYS",
            dateFrom: "",
            dateTo: ""
        };

        // ── Helpers ────────────────────────────────────────────────────────────
        function formatVnd(v) {
            return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND', maximumFractionDigits: 0 }).format(v || 0);
        }

        function renderStatusBadge(status) {
            const map = {
                completed:   ['bg-zinc-100 text-zinc-700',    'Hoàn tất'],
                approved:    ['bg-green-100 text-green-800',  'Đã xác nhận'],
                pending:     ['bg-amber-100 text-amber-800',  'Chờ duyệt'],
                cancelled:   ['bg-red-100 text-red-800',      'Đã hủy'],
                rejected:    ['bg-red-100 text-red-800',      'Từ chối'],
                available:   ['bg-green-100 text-green-800',  'Sẵn sàng'],
                maintenance: ['bg-amber-100 text-amber-800',  'Bảo trì'],
                rented:      ['bg-blue-100 text-blue-800',    'Đang thuê'],
                blocked:     ['bg-red-100 text-red-800',      'Đã khóa'],
            };
            const [cls, label] = map[status?.toLowerCase()] ?? ['bg-zinc-100 text-zinc-700', status];
            return `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${cls}">${label}</span>`;
        }

        function renderStars(rating) {
            if (!rating || rating <= 0) return '<span class="text-zinc-400 text-xs">Chưa đánh giá</span>';
            const filled = Math.round(rating);
            return Array.from({ length: 5 }, (_, i) =>
                `<svg class="h-3.5 w-3.5 ${i < filled ? 'text-yellow-400' : 'text-zinc-200'}" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>`
            ).join('');
        }

        // ── Load Car Info ──────────────────────────────────────────────────────
        async function loadCarInfo() {
            try {
                const res = await fetch(`/api/proxy/owner/cars/${carId}`, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('vivucar_token')}` }
                });
                if (!res.ok) throw new Error('Failed');
                const car = await res.json();

                document.getElementById('carHeaderSkeleton').classList.add('hidden');
                document.getElementById('carHeaderContent').classList.remove('hidden');

                if (car.primaryImageUrl) document.getElementById('carImage').src = car.primaryImageUrl;
                document.getElementById('carName').textContent = car.name;
                document.getElementById('currentStatusBadge').innerHTML = renderStatusBadge(car.status);
                document.getElementById('carLicensePlate').textContent = car.licensePlate;
                document.getElementById('carRating').textContent = car.averageRating > 0 ? `${car.averageRating} sao` : 'Chưa có';
                document.getElementById('carTotalBookings').textContent = car.totalBookings ?? 0;
                document.getElementById('carSubtitle').textContent = `${car.name} · ${car.licensePlate}`;
            } catch (e) {
                console.error(e);
            }
        }

        // ── Load Activity Data ─────────────────────────────────────────────────
        // GET /api/owner/cars/{carId}/activity
        async function loadActivity() {
            try {
                const params = new URLSearchParams({ range: activityHistoryState.range });
                if (activityHistoryState.range === 'CUSTOM') {
                    if (activityHistoryState.dateFrom) params.append('dateFrom', activityHistoryState.dateFrom);
                    if (activityHistoryState.dateTo) params.append('dateTo', activityHistoryState.dateTo);
                }

                const res = await fetch(`/api/proxy/owner/cars/${carId}/activity?${params.toString()}`, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('vivucar_token')}` }
                });

                if (!res.ok) throw new Error('Failed to load activity');
                const data = await res.json();

                // KPI
                document.getElementById('totalRentals').textContent = data.totalBookings ?? 0;
                document.getElementById('totalRevenue').textContent = formatVnd(data.totalRevenue);
                document.getElementById('activeDays').textContent = data.totalRentedDays ?? 0;
                document.getElementById('utilizationRate').textContent = data.utilizationRate ? `${data.utilizationRate}%` : '0%';
                document.getElementById('maintenanceCount').textContent = data.maintenanceCount ?? 0;

                // Chart
                renderChart(data.weeklyData || []);

                // Timeline
                renderTimeline(data.recentBookings || []);

                // Rental history
                renderRentalHistory(data.recentBookings || []);
            } catch (e) {
                console.error(e);
                // Show empty states
                ['totalRentals', 'totalRevenue', 'activeDays', 'utilizationRate', 'maintenanceCount'].forEach(id => {
                    document.getElementById(id).textContent = '—';
                });
                document.getElementById('rentalHistoryTbody').innerHTML =
                    `<tr><td colspan="8" class="px-6 py-8 text-center text-zinc-400 text-sm italic">Xe chưa có lịch sử hoạt động trong khoảng thời gian này.</td></tr>`;
                renderChart([]);
                renderTimeline([]);
            }
        }

        // ── Chart ──────────────────────────────────────────────────────────────
        function renderChart(weeklyData) {
            const barsEl = document.getElementById('activityChartBars');
            const labelsEl = document.getElementById('activityChartLabels');

            if (!weeklyData || weeklyData.length === 0) {
                barsEl.innerHTML = '<div class="flex-1 flex items-end justify-center text-xs text-zinc-400 italic pb-4">Chưa có dữ liệu</div>';
                labelsEl.innerHTML = '';
                return;
            }

            const maxVal = Math.max(...weeklyData.map(d => d.rentedDays || 0), 1);
            barsEl.innerHTML = weeklyData.map(d => {
                const pct = Math.round(((d.rentedDays || 0) / maxVal) * 100);
                return `
                    <div class="flex-1 flex flex-col items-center gap-1 group relative">
                        <div class="w-full rounded-t-sm bg-primary/20 group-hover:bg-primary/40 transition-colors" style="height: ${pct}%; min-height: 4px;" title="${d.label}: ${d.rentedDays} ngày · ${d.bookings} đơn · ${formatVnd(d.revenue)}"></div>
                    </div>`;
            }).join('');

            labelsEl.innerHTML = weeklyData.map(d =>
                `<div class="flex-1 text-center text-xs text-zinc-400 truncate">${d.label}</div>`
            ).join('');
        }

        // ── Timeline ───────────────────────────────────────────────────────────
        function renderTimeline(bookings) {
            const ul = document.getElementById('timelineItems');
            if (!bookings || bookings.length === 0) {
                ul.innerHTML = '<li class="pl-10 text-sm text-zinc-400 italic">Không có hoạt động nào trong khoảng thời gian này.</li>';
                return;
            }

            const eventTypeMap = {
                'created':    ['bg-blue-500',  'Đơn đặt xe mới'],
                'approved':   ['bg-green-500', 'Đã xác nhận'],
                'completed':  ['bg-zinc-500',  'Hoàn tất chuyến'],
                'cancelled':  ['bg-red-500',   'Đã hủy'],
                'rejected':   ['bg-red-500',   'Từ chối'],
            };

            ul.innerHTML = bookings.slice(0, 10).map(b => {
                const status = b.status?.toLowerCase() || 'created';
                const [dotColor, eventLabel] = eventTypeMap[status] ?? ['bg-zinc-300', status];
                const date = b.createdAt ? new Date(b.createdAt).toLocaleDateString('vi-VN') : '';
                return `
                    <li class="pl-10 relative">
                        <div class="absolute left-2.5 top-1 -ml-1 w-4 h-4 rounded-full ${dotColor} z-10"></div>
                        <div>
                            <h4 class="text-sm font-semibold text-zinc-900">${eventLabel}</h4>
                            <p class="text-xs text-zinc-500 mt-0.5">${date} · <a href="/Owner/Bookings/Detail?id=${b.id}" class="text-primary hover:underline">${b.bookingCode || `#${b.id}`}</a></p>
                        </div>
                    </li>`;
            }).join('');
        }

        // ── Rental History ─────────────────────────────────────────────────────
        function renderRentalHistory(bookings) {
            const tbody = document.getElementById('rentalHistoryTbody');
            if (!bookings || bookings.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" class="px-6 py-8 text-center text-zinc-400 text-sm italic">Xe chưa có lịch sử hoạt động trong khoảng thời gian này.</td></tr>`;
                return;
            }

            tbody.innerHTML = bookings.map(b => {
                const start = b.startDateTime ? new Date(b.startDateTime).toLocaleDateString('vi-VN') : '';
                const end = b.endDateTime ? new Date(b.endDateTime).toLocaleDateString('vi-VN') : '';
                const days = b.startDateTime && b.endDateTime
                    ? Math.ceil((new Date(b.endDateTime) - new Date(b.startDateTime)) / (1000 * 60 * 60 * 24))
                    : '—';
                return `
                    <tr class="hover:bg-zinc-50 transition-colors">
                        <td class="px-6 py-4 font-mono text-xs font-medium text-zinc-900">${b.bookingCode || `#${b.id}`}</td>
                        <td class="px-6 py-4">
                            <div class="font-medium text-zinc-900">${b.customerName || '—'}</div>
                            <div class="text-xs text-zinc-500">${b.customerPhone || ''}</div>
                        </td>
                        <td class="px-6 py-4 text-xs text-zinc-500">
                            <div>${start}</div>
                            <div>→ ${end}</div>
                        </td>
                        <td class="px-6 py-4 text-zinc-700 font-medium">${days} ngày</td>
                        <td class="px-6 py-4 font-semibold text-zinc-900">${formatVnd(b.totalAmount)}</td>
                        <td class="px-6 py-4">${renderStatusBadge(b.status)}</td>
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-0.5">${renderStars(b.rating)}</div>
                        </td>
                        <td class="px-6 py-4 text-right">
                            <a href="/Owner/Bookings/Detail?id=${b.id}" class="text-sm font-medium text-primary hover:underline">Xem đơn</a>
                        </td>
                    </tr>`;
            }).join('');
        }

        // ── Export CSV ─────────────────────────────────────────────────────────
        document.getElementById('btnExportHistoryCsv').addEventListener('click', () => {
            const rows = document.querySelectorAll('#rentalHistoryTbody tr');
            let csv = 'Mã đơn,Khách hàng,Từ ngày,Đến ngày,Số ngày,Tổng tiền,Trạng thái\n';
            rows.forEach(row => {
                const cells = row.querySelectorAll('td');
                if (cells.length > 1) {
                    csv += Array.from(cells).slice(0, 7).map(c => `"${c.textContent.trim().replace(/"/g, '""')}"`).join(',') + '\n';
                }
            });
            const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = `lich-su-xe-${carId}-${Date.now()}.csv`;
            a.click();
        });

        document.getElementById('btnExportHistoryPdf').addEventListener('click', () => {
            window.print();
        });

        // ── Filter ─────────────────────────────────────────────────────────────
        document.getElementById('historyRange').addEventListener('change', function() {
            activityHistoryState.range = this.value;
            document.getElementById('customDateRange').classList.toggle('hidden', this.value !== 'CUSTOM');
        });

        document.getElementById('btnApplyHistoryFilter').addEventListener('click', () => {
            activityHistoryState.dateFrom = document.getElementById('historyDateFrom').value;
            activityHistoryState.dateTo = document.getElementById('historyDateTo').value;
            loadActivity();
        });

        // ── Init ───────────────────────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', () => {
            loadCarInfo();
            loadActivity();
        });
    </script>
}

@page
@model WebClient.Pages.Owner.Cars.IndexModel
@{
    ViewData["Title"] = "Quản lý xe";
    ViewData["OwnerPage"] = "cars";
    
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <h2 class="text-xl font-bold text-zinc-900">Danh sách xe của tôi</h2>
        <a href="/Owner/Cars/Form" class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500/50 transition-colors shadow-sm">
            <svg class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            Đăng xe mới
        </a>
    </div>

    <!-- Filters -->
    <div class="bg-white rounded-xl border border-zinc-200 p-4 shadow-sm flex flex-col sm:flex-row gap-4">
        <div class="flex-1">
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <svg class="h-4 w-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </div>
                <input type="text" id="searchInput" class="block w-full pl-10 pr-3 py-2 border border-zinc-300 rounded-lg focus:ring-primary focus:border-primary sm:text-sm" placeholder="Tìm theo tên xe, biển số..." />
            </div>
        </div>
        <div class="w-full sm:w-48">
            <select id="statusFilter" class="block w-full py-2 pl-3 pr-10 border border-zinc-300 rounded-lg focus:ring-primary focus:border-primary sm:text-sm">
                <option value="">Tất cả trạng thái</option>
                <option value="available">Sẵn sàng</option>
                <option value="rented">Đang thuê</option>
                <option value="maintenance">Bảo trì</option>
                <option value="unavailable">Tạm ngưng</option>
                <option value="blocked">Đã khóa</option>
            </select>
        </div>
    </div>

    <!-- Data Grid -->
    <div class="bg-white rounded-xl border border-zinc-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left whitespace-nowrap">
                <thead class="text-xs text-zinc-500 uppercase bg-zinc-50 border-b border-zinc-200">
                    <tr>
                        <th scope="col" class="px-6 py-4 font-semibold">Xe</th>
                        <th scope="col" class="px-6 py-4 font-semibold">Biển số</th>
                        <th scope="col" class="px-6 py-4 font-semibold">Giá thuê (ngày)</th>
                        <th scope="col" class="px-6 py-4 font-semibold">Trạng thái</th>
                        <th scope="col" class="px-6 py-4 font-semibold">Chuyến/Đánh giá</th>
                        <th scope="col" class="px-6 py-4 text-right font-semibold">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="carsTbody" class="divide-y divide-zinc-100">
                    <tr>
                        <td colspan="6" class="px-6 py-8 text-center text-zinc-500">
                            <div class="flex justify-center mb-2">
                                <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-primary"></div>
                            </div>
                            Đang tải dữ liệu...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <!-- Pagination -->
        <div id="pagination" class="px-6 py-4 border-t border-zinc-200 bg-zinc-50 flex items-center justify-between">
            <div class="text-sm text-zinc-500" id="paginationInfo">Hiển thị 0 - 0 của 0 xe</div>
            <div class="flex gap-2" id="paginationControls"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        
        async function loadCars(page = 1) {
            currentPage = page;
            const status = document.getElementById('statusFilter').value;
            const search = document.getElementById('searchInput').value;
            
            const tbody = document.getElementById('carsTbody');
            tbody.innerHTML = `<tr><td colspan="6" class="px-6 py-8 text-center text-zinc-500"><div class="flex justify-center mb-2"><div class="animate-spin rounded-full h-6 w-6 border-b-2 border-primary"></div></div>Đang tải...</td></tr>`;
            
            try {
                const params = new URLSearchParams({ page, pageSize: 10 });
                if (status) params.append('status', status);
                if (search) params.append('search', search);

                const response = await fetch(`/api/proxy/owner/cars?${params.toString()}`, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('vivucar_token')}` }
                });

                if (!response.ok) {
                    if (response.status === 401) return window.location.href = '/Index';
                    throw new Error('Failed to load cars');
                }

                const data = await response.json();
                renderTable(data);
                renderPagination(data);
            } catch (error) {
                console.error('Error loading cars:', error);
                tbody.innerHTML = `<tr><td colspan="6" class="px-6 py-8 text-center text-red-500">Lỗi khi tải dữ liệu.</td></tr>`;
            }
        }

        function renderTable(data) {
            const tbody = document.getElementById('carsTbody');
            if (!data.items || data.items.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" class="px-6 py-12 text-center">
                            <div class="flex flex-col items-center justify-center text-zinc-400">
                                <svg class="h-12 w-12 mb-3 text-zinc-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                                <p>Không tìm thấy xe nào phù hợp.</p>
                            </div>
                        </td>
                    </tr>`;
                return;
            }

            tbody.innerHTML = data.items.map(car => `
                <tr class="hover:bg-zinc-50 transition-colors group">
                    <td class="px-6 py-4">
                        <div class="flex items-center gap-3">
                            ${car.primaryImageUrl 
                                ? `<img src="${car.primaryImageUrl}" class="w-16 h-12 rounded-lg object-cover border border-zinc-200" />`
                                : `<div class="w-16 h-12 rounded-lg bg-zinc-100 flex items-center justify-center border border-zinc-200"><svg class="w-5 h-5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L28 20M6 12a2 2 0 11-4 0 2 2 0 014 0z"/></svg></div>`
                            }
                            <div>
                                <div class="font-bold text-zinc-900 group-hover:text-primary transition-colors">${car.name}</div>
                                <div class="text-xs text-zinc-500 mt-0.5">${car.location}</div>
                            </div>
                        </div>
                    </td>
                    <td class="px-6 py-4">
                        <span class="inline-flex items-center px-2 py-1 rounded bg-zinc-100 text-xs font-mono font-medium text-zinc-800 border border-zinc-200">
                            ${car.licensePlate}
                        </span>
                    </td>
                    <td class="px-6 py-4 font-semibold text-zinc-900">
                        ${window.VivuCarUtils ? window.VivuCarUtils.formatVnd(car.dailyPrice) : car.dailyPrice.toLocaleString('vi-VN') + 'đ'}
                    </td>
                    <td class="px-6 py-4">
                        ${window.VivuCarUtils ? window.VivuCarUtils.renderCarStatusBadge(car.status) : `<span class="px-2.5 py-1 text-xs font-medium rounded-full bg-zinc-100 text-zinc-700">${car.status}</span>`}
                    </td>
                    <td class="px-6 py-4">
                        <div class="text-sm font-medium text-zinc-900">${car.totalBookings} <span class="text-xs font-normal text-zinc-500">chuyến</span></div>
                        <div class="text-xs text-zinc-500 mt-0.5 flex items-center gap-1">
                            <svg class="h-3 w-3 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                            ${car.averageRating > 0 ? car.averageRating : 'Chưa có'}
                        </div>
                    </td>
                    <td class="px-6 py-4 text-right space-x-3">
                         <a href="/Owner/Cars/Activity?id=${car.id}" class="text-sm font-medium text-zinc-500 hover:text-zinc-900 hover:underline">Lịch sử</a>
                         <a href="/Owner/Cars/Status?id=${car.id}" class="text-sm font-medium text-zinc-600 hover:text-zinc-900 hover:underline">Trạng thái</a>
                         <a href="/Owner/Cars/Images?id=${car.id}" class="text-sm font-medium text-zinc-600 hover:text-zinc-900 hover:underline">Ảnh</a>
                         <a href="/Owner/Cars/Form?id=${car.id}" class="text-sm font-medium text-primary hover:underline">Sửa</a>
                    </td>
                </tr>
            `).join('');
        }

        function renderPagination(data) {
            const info = document.getElementById('paginationInfo');
            const controls = document.getElementById('paginationControls');

            if (data.totalCount === 0) {
                info.textContent = 'Không có dữ liệu';
                controls.innerHTML = '';
                return;
            }

            const start = (data.page - 1) * data.pageSize + 1;
            const end = Math.min(data.page * data.pageSize, data.totalCount);
            info.textContent = `Hiển thị ${start} - ${end} của ${data.totalCount} xe`;

            let html = '';
            
            html += `<button onclick="loadCars(${data.page - 1})" ${data.page === 1 ? 'disabled class="px-3 py-1.5 rounded-md border border-zinc-200 text-sm font-medium text-zinc-400 bg-zinc-50 cursor-not-allowed"' : 'class="px-3 py-1.5 rounded-md border border-zinc-300 text-sm font-medium text-zinc-700 bg-white hover:bg-zinc-50"'}>Trước</button>`;
            html += `<button onclick="loadCars(${data.page + 1})" ${data.page >= data.totalPages ? 'disabled class="px-3 py-1.5 rounded-md border border-zinc-200 text-sm font-medium text-zinc-400 bg-zinc-50 cursor-not-allowed"' : 'class="px-3 py-1.5 rounded-md border border-zinc-300 text-sm font-medium text-zinc-700 bg-white hover:bg-zinc-50"'}>Sau</button>`;

            controls.innerHTML = html;
        }

        document.addEventListener('DOMContentLoaded', () => {
            loadCars(1);

            let searchTimeout;
            document.getElementById('searchInput').addEventListener('input', () => {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => loadCars(1), 500);
            });

            document.getElementById('statusFilter').addEventListener('change', () => loadCars(1));
        });
    </script>
}

@page
@model WebClient.Pages.Owner.Bookings.DetailModel
@{
    ViewData["Title"] = "Chi tiết đơn thuê xe";
    ViewData["OwnerPage"] = "bookings";
    
}

<div class="max-w-5xl mx-auto space-y-6 pb-12">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="flex items-center gap-4">
            <a href="/Owner/Bookings/Index" class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-white border border-zinc-200 text-zinc-600 hover:text-primary hover:border-primary/30 hover:bg-primary/5 transition-colors">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            </a>
            <div>
                <div class="flex items-center gap-3">
                    <h2 class="text-xl font-bold text-zinc-900">Chi tiết đơn: <span id="bookingCode" class="font-mono">Đang tải...</span></h2>
                    <span id="statusBadge"></span>
                </div>
                <p class="text-sm text-zinc-500 mt-1">Ngày tạo: <span id="createdAt">Đang tải...</span></p>
            </div>
        </div>
        
        <div id="actionButtons" class="flex items-center gap-3">
            <!-- Dynamic action buttons based on status -->
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main Content (Left Column) -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Timeline/Progress -->
            <div class="bg-white rounded-xl border border-zinc-200 p-6 shadow-sm">
                <h3 class="text-base font-semibold text-zinc-900 mb-4">Trạng thái chuyến đi</h3>
                <div class="relative">
                    <div class="absolute left-4 top-0 h-full w-0.5 bg-zinc-200"></div>
                    <ul class="space-y-6 relative" id="timelineList">
                        <!-- Timeline will be injected here -->
                    </ul>
                </div>
            </div>

            <!-- Car Information -->
            <div class="bg-white rounded-xl border border-zinc-200 shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-zinc-200 bg-zinc-50/50 flex justify-between items-center">
                    <h3 class="text-base font-semibold text-zinc-900">Thông tin xe</h3>
                    <a id="carLink" href="#" class="text-sm font-medium text-primary hover:underline">Xem chi tiết xe</a>
                </div>
                <div class="p-6">
                    <div class="flex items-start gap-4">
                        <img id="carImage" src="" class="w-24 h-16 rounded-lg object-cover border border-zinc-200" alt="Car" onerror="this.src='data:image/svg+xml;charset=utf-8,%3Csvg xmlns%3D\\'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg\\' width%3D\\'100%25\\' height%3D\\'100%25\\'%3E%3Crect width%3D\\'100%25\\' height%3D\\'100%25\\' fill%3D\\'%23f4f4f5\\'%2F%3E%3Ctext x%3D\\'50%25\\' y%3D\\'50%25\\' fill%3D\\'%23a1a1aa\\' font-family%3D\\'sans-serif\\' font-size%3D\\'12\\' text-anchor%3D\\'middle\\' dominant-baseline%3D\\'middle\\'%3ENo image%3C%2Ftext%3E%3C%2Fsvg%3E'" />
                        <div>
                            <h4 id="carName" class="font-bold text-lg text-zinc-900"></h4>
                            <p id="carSpecs" class="text-sm text-zinc-500 mt-1"></p>
                            <div class="mt-2 inline-flex items-center px-2 py-1 rounded bg-zinc-100 text-xs font-mono font-medium text-zinc-800 border border-zinc-200">
                                <span id="licensePlate"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Rental Details -->
            <div class="bg-white rounded-xl border border-zinc-200 shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-zinc-200 bg-zinc-50/50">
                    <h3 class="text-base font-semibold text-zinc-900">Thời gian & Địa điểm</h3>
                </div>
                <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <p class="text-sm text-zinc-500 mb-1">Nhận xe</p>
                        <p id="pickupTime" class="font-medium text-zinc-900"></p>
                        <div class="flex items-start gap-2 mt-2">
                            <svg class="h-4 w-4 text-zinc-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                            <p id="pickupLocation" class="text-sm text-zinc-700"></p>
                        </div>
                    </div>
                    <div>
                        <p class="text-sm text-zinc-500 mb-1">Trả xe</p>
                        <p id="returnTime" class="font-medium text-zinc-900"></p>
                        <div class="flex items-start gap-2 mt-2">
                            <svg class="h-4 w-4 text-zinc-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                            <p id="returnLocation" class="text-sm text-zinc-700"></p>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Sidebar (Right Column) -->
        <div class="space-y-6">
            <!-- Customer Info -->
            <div class="bg-white rounded-xl border border-zinc-200 shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-zinc-200 bg-zinc-50/50">
                    <h3 class="text-base font-semibold text-zinc-900">Thông tin khách hàng</h3>
                </div>
                <div class="p-6">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="h-10 w-10 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-sm" id="customerAvatar">
                            KH
                        </div>
                        <div>
                            <p id="customerName" class="font-semibold text-zinc-900"></p>
                            <p id="customerPhone" class="text-sm text-zinc-500"></p>
                        </div>
                    </div>
                    <div class="pt-4 border-t border-zinc-100 flex gap-2">
                        <a id="btnChat" href="#" class="flex-1 inline-flex justify-center items-center rounded-lg bg-zinc-100 px-3 py-2 text-sm font-medium text-zinc-700 hover:bg-zinc-200 transition-colors">
                            <svg class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                            Nhắn tin
                        </a>
                        <a id="btnCall" href="#" class="flex-1 inline-flex justify-center items-center rounded-lg bg-zinc-100 px-3 py-2 text-sm font-medium text-zinc-700 hover:bg-zinc-200 transition-colors">
                            <svg class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                            Gọi điện
                        </a>
                    </div>
                </div>
            </div>

            <!-- Financial Summary -->
            <div class="bg-white rounded-xl border border-zinc-200 shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-zinc-200 bg-zinc-50/50">
                    <h3 class="text-base font-semibold text-zinc-900">Chi tiết thanh toán</h3>
                </div>
                <div class="p-6">
                    <div class="space-y-3 text-sm">
                        <div class="flex justify-between">
                            <span class="text-zinc-500" id="rentalDaysLabel">Đơn giá thuê</span>
                            <span class="font-medium text-zinc-900" id="rentalPrice"></span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-zinc-500">Phí giao nhận</span>
                            <span class="font-medium text-zinc-900" id="deliveryFee"></span>
                        </div>
                        <div class="pt-3 border-t border-zinc-100 flex justify-between">
                            <span class="font-semibold text-zinc-900">Tổng cộng</span>
                            <span class="font-bold text-lg text-primary" id="totalAmount"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Documents -->
            <div class="bg-white rounded-xl border border-zinc-200 shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-zinc-200 bg-zinc-50/50">
                    <h3 class="text-base font-semibold text-zinc-900">Chứng từ & Hợp đồng</h3>
                </div>
                <div class="p-6 space-y-3">
                    <a id="btnContract" href="#" target="_blank" class="flex items-center gap-3 p-3 rounded-lg border border-zinc-200 hover:border-primary hover:bg-primary/5 transition-colors group">
                        <div class="p-2 bg-zinc-100 rounded text-zinc-500 group-hover:bg-primary/10 group-hover:text-primary transition-colors">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                        </div>
                        <div class="flex-1">
                            <div class="text-sm font-medium text-zinc-900 group-hover:text-primary">Hợp đồng điện tử</div>
                            <div class="text-xs text-zinc-500">Xem hoặc in PDF</div>
                        </div>
                        <svg class="h-4 w-4 text-zinc-400 group-hover:text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Reject -->
<div id="modalReject" class="fixed inset-0 z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-zinc-900/50 backdrop-blur-sm transition-opacity"></div>
    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
            <div class="relative transform overflow-hidden rounded-xl bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg border border-zinc-200">
                <div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
                    <div class="sm:flex sm:items-start">
                        <div class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
                            <svg class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                        </div>
                        <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left w-full">
                            <h3 class="text-base font-semibold leading-6 text-zinc-900" id="modal-title">Từ chối đơn đặt xe</h3>
                            <div class="mt-2">
                                <p class="text-sm text-zinc-500 mb-2">Vui lòng cho biết lý do từ chối để khách hàng được biết.</p>
                                <textarea id="rejectReason" rows="3" class="block w-full rounded-md border-zinc-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm px-3 py-2 border" placeholder="Ví dụ: Xe đang bảo trì đột xuất..."></textarea>
                                <p id="rejectError" class="text-sm text-red-600 mt-1 hidden"></p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="bg-zinc-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6 border-t border-zinc-200">
                    <button type="button" id="btnConfirmReject" class="inline-flex w-full justify-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500 sm:ml-3 sm:w-auto">Xác nhận từ chối</button>
                    <button type="button" onclick="document.getElementById('modalReject').classList.add('hidden')" class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-zinc-900 shadow-sm ring-1 ring-inset ring-zinc-300 hover:bg-zinc-50 sm:mt-0 sm:w-auto">Hủy bỏ</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const bookingId = @Model.Id;
        
        document.addEventListener('DOMContentLoaded', () => {
            loadBookingDetail();
            
            document.getElementById('btnConfirmReject').addEventListener('click', handleReject);
        });

        async function loadBookingDetail() {
            try {
                const response = await fetch(`/api/proxy/owner/bookings/${bookingId}`, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('vivucar_token')}` }
                });

                if (!response.ok) {
                    if (response.status === 401) return window.location.href = '/Index';
                    throw new Error('Lỗi tải dữ liệu');
                }

                const b = await response.json();
                renderDetail(b);
                renderActions(b);
                renderTimeline(b);
            } catch (error) {
                console.error(error);
                window.VivuCarUtils.showToast('Lỗi khi tải chi tiết đơn', 'error');
            }
        }

        function renderDetail(b) {
            document.getElementById('bookingCode').textContent = b.bookingCode;
            document.getElementById('createdAt').textContent = new Date(b.createdAt).toLocaleString('vi-VN');
            document.getElementById('statusBadge').innerHTML = window.VivuCarUtils.renderBookingStatusBadge(b.status);
            
            // Car Info
            if (b.carImageUrl) document.getElementById('carImage').src = b.carImageUrl;
            document.getElementById('carName').textContent = b.carName;
            document.getElementById('carSpecs').textContent = 'Xe tự lái';
            document.getElementById('licensePlate').textContent = b.licensePlate;
            document.getElementById('carLink').href = `/Owner/Cars/Form?id=${b.carId}`;

            // Rental
            document.getElementById('pickupTime').textContent = new Date(b.startDateTime).toLocaleString('vi-VN');
            document.getElementById('pickupLocation').textContent = b.pickupAddress || 'Tại địa chỉ chủ xe';
            document.getElementById('returnTime').textContent = new Date(b.endDateTime).toLocaleString('vi-VN');
            document.getElementById('returnLocation').textContent = b.pickupAddress || 'Tại địa chỉ chủ xe';

            // Customer
            document.getElementById('customerName').textContent = b.customerName;
            document.getElementById('customerPhone').textContent = b.customerPhone;
            document.getElementById('customerAvatar').textContent = b.customerName.charAt(0).toUpperCase();
            document.getElementById('btnCall').href = `tel:${b.customerPhone}`;

            // Financial
            const formatVnd = window.VivuCarUtils.formatVnd;
            // calculating days roughly
            const days = Math.ceil((new Date(b.endDateTime) - new Date(b.startDateTime)) / (1000 * 60 * 60 * 24)) || 1;
            document.getElementById('rentalDaysLabel').textContent = `Tiền thuê (${days} ngày)`;
            
            // In API we just have totalAmount, maybe we can mock breakdown
            document.getElementById('rentalPrice').textContent = formatVnd(b.totalAmount);
            document.getElementById('deliveryFee').textContent = formatVnd(0);
            document.getElementById('totalAmount').textContent = formatVnd(b.totalAmount);

            // Contract
            document.getElementById('btnContract').href = `/api/proxy/bookings/${bookingId}/contract/pdf`;
        }

        function renderActions(b) {
            const container = document.getElementById('actionButtons');
            let html = '';
            const status = b.status.toLowerCase();

            if (status === 'pendingapproval') {
                html += `
                    <button onclick="document.getElementById('modalReject').classList.remove('hidden')" class="inline-flex items-center justify-center rounded-lg bg-white border border-zinc-300 px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-50 focus:outline-none transition-colors">
                        Từ chối
                    </button>
                    <button onclick="handleApprove()" class="inline-flex items-center justify-center rounded-lg bg-green-600 px-4 py-2 text-sm font-medium text-white hover:bg-green-700 focus:outline-none transition-colors shadow-sm">
                        Chấp nhận yêu cầu
                    </button>
                `;
            } else if (status === 'waitingpickup') {
                html += `
                    <a href="/Owner/Bookings/Handover?id=${b.id}" class="inline-flex items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-medium text-white hover:bg-primary/90 focus:outline-none transition-colors shadow-sm">
                        Bàn giao xe
                    </a>
                `;
            } else if (status === 'returnrequested') {
                html += `
                    <a href="/Owner/Bookings/Return?id=${b.id}" class="inline-flex items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-medium text-white hover:bg-primary/90 focus:outline-none transition-colors shadow-sm">
                        Nhận lại xe
                    </a>
                `;
            } else if (status === 'inprogress') {
                // If it's in progress but no return requested, maybe owner can force return? 
                // In VivuCar, usually Customer requests return, but Owner can also initiate.
                html += `
                    <a href="/Owner/Bookings/Return?id=${b.id}" class="inline-flex items-center justify-center rounded-lg bg-white border border-primary text-primary px-4 py-2 text-sm font-medium hover:bg-primary/5 focus:outline-none transition-colors">
                        Thực hiện nhận lại xe
                    </a>
                `;
            }

            container.innerHTML = html;
        }

        function renderTimeline(b) {
            const tl = document.getElementById('timelineList');
            const status = b.status.toLowerCase();
            
            // Generate basic timeline steps based on status
            const steps = [
                { title: 'Tạo yêu cầu', desc: 'Khách hàng đã gửi yêu cầu đặt xe.', active: true, done: true },
                { title: 'Xác nhận', desc: 'Chủ xe duyệt và khách đặt cọc.', active: status !== 'pendingapproval' && status !== 'cancelled' && status !== 'rejected', done: status !== 'pendingapproval' && status !== 'waitingdeposit' && status !== 'cancelled' && status !== 'rejected' },
                { title: 'Bàn giao xe', desc: 'Giao xe cho khách hàng.', active: ['waitingpickup', 'inprogress', 'returnrequested', 'completed'].includes(status), done: ['inprogress', 'returnrequested', 'completed'].includes(status) },
                { title: 'Khách hàng sử dụng', desc: 'Trong thời gian thuê xe.', active: ['inprogress', 'returnrequested', 'completed'].includes(status), done: ['returnrequested', 'completed'].includes(status) },
                { title: 'Hoàn tất trả xe', desc: 'Nhận lại xe và thanh toán đủ.', active: ['returnrequested', 'completed'].includes(status), done: status === 'completed' }
            ];

            if (status === 'cancelled') {
                steps.push({ title: 'Đã hủy', desc: 'Chuyến đi đã bị hủy.', active: true, done: true, isError: true });
            } else if (status === 'rejected') {
                steps.push({ title: 'Từ chối', desc: 'Chủ xe đã từ chối yêu cầu.', active: true, done: true, isError: true });
            }

            tl.innerHTML = steps.map((s, idx) => {
                const isLast = idx === steps.length - 1;
                const dotColor = s.isError ? 'bg-red-500' : (s.done ? 'bg-green-500' : (s.active ? 'bg-primary border-4 border-primary/20' : 'bg-zinc-300'));
                const textColor = s.isError ? 'text-red-600' : (s.done || s.active ? 'text-zinc-900' : 'text-zinc-400');
                
                return `
                <li class="pl-10 relative">
                    <div class="absolute left-2.5 top-1 -ml-1 w-4 h-4 rounded-full ${dotColor} z-10 ${s.active && !s.done && !s.isError ? 'animate-pulse' : ''}"></div>
                    <div>
                        <h4 class="text-sm font-semibold ${textColor}">${s.title}</h4>
                        <p class="text-xs text-zinc-500 mt-0.5">${s.desc}</p>
                    </div>
                </li>
                `;
            }).join('');
        }

        async function handleApprove() {
            if (!confirm('Bạn xác nhận chấp nhận yêu cầu thuê xe này?')) return;
            
            try {
                const res = await fetch(`/api/proxy/owner/bookings/${bookingId}/approve`, {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('vivucar_token')}` }
                });
                if (!res.ok) {
                    const err = await res.json();
                    throw new Error(err.message || 'Lỗi xử lý');
                }
                window.VivuCarUtils.showToast('Đã chấp nhận yêu cầu', 'success');
                loadBookingDetail();
            } catch (error) {
                window.VivuCarUtils.showToast(error.message, 'error');
            }
        }

        async function handleReject() {
            const reason = document.getElementById('rejectReason').value.trim();
            const err = document.getElementById('rejectError');
            
            if (!reason) {
                err.textContent = 'Vui lòng nhập lý do từ chối';
                err.classList.remove('hidden');
                return;
            }
            err.classList.add('hidden');
            
            const btn = document.getElementById('btnConfirmReject');
            btn.disabled = true;
            btn.textContent = 'Đang xử lý...';

            try {
                const res = await fetch(`/api/proxy/owner/bookings/${bookingId}/reject`, {
                    method: 'POST',
                    headers: { 
                        'Authorization': `Bearer ${localStorage.getItem('vivucar_token')}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ reason: reason || null })
                });
                
                if (!res.ok) {
                    const errorObj = await res.json().catch(() => ({}));
                    throw new Error(errorObj.message || 'Lỗi xử lý');
                }
                
                document.getElementById('modalReject').classList.add('hidden');
                window.VivuCarUtils.showToast('Đã từ chối yêu cầu', 'success');
                loadBookingDetail();
            } catch (error) {
                err.textContent = error.message;
                err.classList.remove('hidden');
            } finally {
                btn.disabled = false;
                btn.textContent = 'Xác nhận từ chối';
            }
        }
    </script>
}

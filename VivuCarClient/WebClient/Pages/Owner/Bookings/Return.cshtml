@page
@model WebClient.Pages.Owner.Bookings.ReturnModel
@{
    ViewData["Title"] = "Biên bản Nhận lại xe";
    ViewData["OwnerPage"] = "bookings";
    
}

<div class="max-w-4xl mx-auto space-y-6 pb-12">
    <div class="flex items-center gap-4">
        <a href="/Owner/Bookings/Detail?id=@Model.Id" class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-white border border-zinc-200 text-zinc-600 hover:text-primary hover:border-primary/30 hover:bg-primary/5 transition-colors">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        </a>
        <div>
            <h2 class="text-xl font-bold text-zinc-900">@ViewData["Title"]</h2>
            <p class="text-sm text-zinc-500">Mã đơn: <span id="bookingCode" class="font-mono text-zinc-900 font-medium">Đang tải...</span></p>
        </div>
    </div>

    <form id="returnForm" class="space-y-6">
        <div class="bg-white rounded-xl border border-zinc-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-zinc-200 bg-zinc-50/50">
                <h3 class="text-base font-semibold text-zinc-900">Thông tin hiện trạng xe khi nhận</h3>
            </div>
            <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-zinc-700 mb-1">Số ODO (km) <span class="text-red-500">*</span></label>
                    <input type="number" id="odometerKm" required min="0" class="block w-full px-3 py-2 border border-zinc-300 rounded-lg focus:ring-primary focus:border-primary sm:text-sm" placeholder="Ví dụ: 15300" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-zinc-700 mb-1">Mức nhiên liệu (%) <span class="text-red-500">*</span></label>
                    <input type="number" id="fuelLevel" required min="0" max="100" class="block w-full px-3 py-2 border border-zinc-300 rounded-lg focus:ring-primary focus:border-primary sm:text-sm" placeholder="Ví dụ: 70" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-zinc-700 mb-1">Phụ phí phát sinh (VNĐ)</label>
                    <input type="number" id="extraFee" min="0" step="10000" class="block w-full px-3 py-2 border border-zinc-300 rounded-lg focus:ring-primary focus:border-primary sm:text-sm" value="0" />
                    <p class="text-xs text-zinc-500 mt-1">Phí quá giờ, phí rửa xe, vi phạm (nếu có)</p>
                </div>
                <div>
                    <label class="block text-sm font-medium text-zinc-700 mb-1">Trạng thái xe sau khi nhận</label>
                    <select id="nextCarStatus" class="block w-full px-3 py-2 border border-zinc-300 rounded-lg focus:ring-primary focus:border-primary sm:text-sm">
                        <option value="available">Sẵn sàng nhận khách (Available)</option>
                        <option value="maintenance">Bảo trì/Sửa chữa (Maintenance)</option>
                        <option value="unavailable">Tạm ngưng (Unavailable)</option>
                    </select>
                </div>
                <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-zinc-700 mb-1">Ghi chú vết xước/hư hỏng phát sinh</label>
                    <textarea id="damageNotes" rows="3" class="block w-full px-3 py-2 border border-zinc-300 rounded-lg focus:ring-primary focus:border-primary sm:text-sm" placeholder="Ghi chú chi tiết nếu có hư hỏng mới..."></textarea>
                </div>
                <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-zinc-700 mb-1">Ghi chú chung</label>
                    <textarea id="note" rows="2" class="block w-full px-3 py-2 border border-zinc-300 rounded-lg focus:ring-primary focus:border-primary sm:text-sm" placeholder="Trừ tiền cọc, giải quyết tranh chấp..."></textarea>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl border border-zinc-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-zinc-200 bg-zinc-50/50 flex justify-between items-center">
                <div>
                    <h3 class="text-base font-semibold text-zinc-900">Hình ảnh xác nhận</h3>
                    <p class="text-sm text-zinc-500">Cung cấp hình ảnh lúc nhận lại xe (tùy chọn nhưng khuyến khích).</p>
                </div>
                <button type="button" id="btnAddImageRow" class="text-sm font-medium text-primary hover:underline flex items-center">
                    <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                    Thêm ảnh
                </button>
            </div>
            <div class="p-6">
                <div class="space-y-4" id="imagesContainer">
                    <!-- Dynamic image rows -->
                </div>
                <div id="noImageMessage" class="text-sm text-zinc-500 italic py-2">
                    Chưa có hình ảnh nào được thêm.
                </div>
            </div>
        </div>

        <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 flex gap-3">
            <div class="shrink-0 pt-0.5">
                <svg class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <div>
                <h4 class="text-sm font-medium text-blue-900">Hoàn tất chuyến xe</h4>
                <p class="text-sm text-blue-700 mt-1">Khi bạn bấm xác nhận, chuyến xe sẽ được cập nhật biên bản nhận xe, sau đó sẽ <strong>tự động chuyển sang trạng thái Hoàn tất</strong>. Doanh thu sẽ được ghi nhận vào tháng hiện tại.</p>
                
                <div class="mt-3 flex items-center">
                    <input id="confirmCheckbox" required type="checkbox" class="h-4 w-4 rounded border-blue-300 text-blue-600 focus:ring-blue-500 bg-white">
                    <label for="confirmCheckbox" class="ml-2 block text-sm text-blue-900 font-medium">
                        Tôi xác nhận đã nhận lại xe và đồng ý hoàn tất chuyến đi này.
                    </label>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-4 pt-2">
            <button type="submit" id="btnSubmit" class="inline-flex items-center justify-center rounded-lg bg-primary px-6 py-2.5 text-sm font-medium text-white hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-primary/50 transition-colors shadow-sm disabled:opacity-50 disabled:cursor-not-allowed">
                Nhận lại xe & Hoàn tất
            </button>
            <a href="/Owner/Bookings/Detail?id=@Model.Id" class="inline-flex items-center justify-center rounded-lg bg-white border border-zinc-300 px-6 py-2.5 text-sm font-medium text-zinc-700 hover:bg-zinc-50 focus:outline-none transition-colors">
                Hủy bỏ
            </a>
        </div>
        
        <div id="formError" class="hidden rounded-md bg-red-50 p-4 mt-4">
            <p class="text-sm font-medium text-red-800" id="formErrorMsg"></p>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const bookingId = @Model.Id;

        document.addEventListener('DOMContentLoaded', async () => {
            try {
                const response = await fetch(`/api/proxy/owner/bookings/${bookingId}`, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('vivucar_token')}` }
                });
                if(response.ok) {
                    const data = await response.json();
                    document.getElementById('bookingCode').textContent = data.bookingCode;
                }
            } catch (e) {}

            document.getElementById('btnAddImageRow').addEventListener('click', () => {
                document.getElementById('noImageMessage').classList.add('hidden');
                const container = document.getElementById('imagesContainer');
                const row = document.createElement('div');
                row.className = 'flex gap-4 items-start image-row';
                row.innerHTML = `
                    <div class="flex-1">
                        <input type="url" class="img-url block w-full px-3 py-2 border border-zinc-300 rounded-lg focus:ring-primary focus:border-primary sm:text-sm" placeholder="https://..." required />
                    </div>
                    <div class="w-1/3">
                        <input type="text" class="img-caption block w-full px-3 py-2 border border-zinc-300 rounded-lg focus:ring-primary focus:border-primary sm:text-sm" placeholder="Ghi chú ảnh" />
                    </div>
                    <button type="button" class="btn-remove-img text-zinc-400 hover:text-red-500 p-2">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                    </button>
                `;
                container.appendChild(row);

                row.querySelector('.btn-remove-img').addEventListener('click', function() {
                    row.remove();
                    if (container.children.length === 0) {
                        document.getElementById('noImageMessage').classList.remove('hidden');
                    }
                });
            });

            document.getElementById('returnForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                
                const btn = document.getElementById('btnSubmit');
                const err = document.getElementById('formError');
                const errMsg = document.getElementById('formErrorMsg');
                
                btn.disabled = true;
                btn.textContent = 'Đang xử lý...';
                err.classList.add('hidden');

                const imageRows = document.querySelectorAll('.image-row');
                const images = Array.from(imageRows).map(row => ({
                    imageUrl: row.querySelector('.img-url').value.trim(),
                    caption: row.querySelector('.img-caption').value.trim()
                })).filter(x => x.imageUrl);

                const payload = {
                    odometerKm: parseFloat(document.getElementById('odometerKm').value),
                    fuelLevel: parseFloat(document.getElementById('fuelLevel').value),
                    extraFee: parseFloat(document.getElementById('extraFee').value) || 0,
                    damageNotes: document.getElementById('damageNotes').value,
                    note: document.getElementById('note').value,
                    images: images
                };

                const nextCarStatus = document.getElementById('nextCarStatus').value;

                try {
                    // 1. Return Inspection
                    const res = await fetch(`/api/proxy/owner/bookings/${bookingId}/return`, {
                        method: 'POST',
                        headers: {
                            'Authorization': `Bearer ${localStorage.getItem('vivucar_token')}`,
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(payload)
                    });

                    if (!res.ok) {
                        const errorObj = await res.json();
                        throw new Error(errorObj.message || 'Lỗi xử lý nhận lại xe');
                    }

                    // 2. Complete Booking
                    const resComplete = await fetch(`/api/proxy/owner/bookings/${bookingId}/complete`, {
                        method: 'POST',
                        headers: {
                            'Authorization': `Bearer ${localStorage.getItem('vivucar_token')}`,
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ nextCarStatus })
                    });

                    if (!resComplete.ok) {
                        const errorObj = await resComplete.json();
                        throw new Error(errorObj.message || 'Lỗi xử lý hoàn tất chuyến xe');
                    }

                    window.VivuCarUtils.showToast('Hoàn tất chuyến xe thành công', 'success');
                    setTimeout(() => window.location.href = `/Owner/Bookings/Detail?id=${bookingId}`, 1500);
                } catch (error) {
                    errMsg.textContent = error.message;
                    err.classList.remove('hidden');
                    btn.disabled = false;
                    btn.textContent = 'Nhận lại xe & Hoàn tất';
                }
            });
        });
    </script>
}

@page
@model WebClient.Pages.Owner.Bookings.HandoverModel
@{
    ViewData["Title"] = "Biên bản Bàn giao xe";
    ViewData["OwnerPage"] = "bookings";
    
}

<div class="max-w-4xl mx-auto space-y-6 pb-12">
    <div class="flex items-center gap-4">
        <a href="/Owner/Bookings/Detail?id=@Model.Id" class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-white border border-zinc-200 text-zinc-600 hover:text-primary hover:border-primary/30 hover:bg-primary/5 transition-colors">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        </a>
        <div>
            <h2 class="text-xl font-bold text-zinc-900">@ViewData["Title"]</h2>
            <p class="text-sm text-zinc-500">Mã đơn: <span id="bookingCode" class="font-mono text-zinc-900 font-medium">Đang tải...</span></p>
        </div>
    </div>

    <form id="handoverForm" class="space-y-6">
        <div class="bg-white rounded-xl border border-zinc-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-zinc-200 bg-zinc-50/50">
                <h3 class="text-base font-semibold text-zinc-900">Thông tin hiện trạng xe khi giao</h3>
            </div>
            <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-zinc-700 mb-1">Số ODO (km) <span class="text-red-500">*</span></label>
                    <input type="number" id="odometerKm" required min="0" class="block w-full px-3 py-2 border border-zinc-300 rounded-lg focus:ring-primary focus:border-primary sm:text-sm" placeholder="Ví dụ: 15200" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-zinc-700 mb-1">Mức nhiên liệu (%) <span class="text-red-500">*</span></label>
                    <input type="number" id="fuelLevel" required min="0" max="100" class="block w-full px-3 py-2 border border-zinc-300 rounded-lg focus:ring-primary focus:border-primary sm:text-sm" placeholder="Ví dụ: 80" />
                </div>
                <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-zinc-700 mb-1">Ghi chú vết xước/hư hỏng có sẵn (nếu có)</label>
                    <textarea id="damageNotes" rows="3" class="block w-full px-3 py-2 border border-zinc-300 rounded-lg focus:ring-primary focus:border-primary sm:text-sm" placeholder="Ghi chú chi tiết tình trạng ngoại thất, nội thất..."></textarea>
                </div>
                <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-zinc-700 mb-1">Ghi chú chung</label>
                    <textarea id="note" rows="2" class="block w-full px-3 py-2 border border-zinc-300 rounded-lg focus:ring-primary focus:border-primary sm:text-sm" placeholder="Nhắc nhở khách hàng, các giấy tờ đi kèm..."></textarea>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl border border-zinc-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-zinc-200 bg-zinc-50/50">
                <h3 class="text-base font-semibold text-zinc-900">Hình ảnh xác nhận</h3>
                <p class="text-sm text-zinc-500">Vui lòng cung cấp URL hình ảnh chụp thực tế xe lúc bàn giao.</p>
            </div>
            <div class="p-6">
                <div class="space-y-4" id="imagesContainer">
                    <div class="flex gap-4 items-start image-row">
                        <div class="flex-1">
                            <input type="url" class="img-url block w-full px-3 py-2 border border-zinc-300 rounded-lg focus:ring-primary focus:border-primary sm:text-sm" placeholder="https://..." required />
                        </div>
                        <div class="w-1/3">
                            <input type="text" class="img-caption block w-full px-3 py-2 border border-zinc-300 rounded-lg focus:ring-primary focus:border-primary sm:text-sm" placeholder="Ghi chú ảnh (vd: Góc trái)" />
                        </div>
                        <button type="button" class="btn-remove-img text-zinc-400 hover:text-red-500 p-2 hidden">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                        </button>
                    </div>
                </div>
                <button type="button" id="btnAddImageRow" class="mt-4 text-sm font-medium text-primary hover:underline flex items-center">
                    <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                    Thêm ảnh khác
                </button>
            </div>
        </div>

        <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 flex gap-3">
            <div class="shrink-0 pt-0.5">
                <svg class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <div>
                <h4 class="text-sm font-medium text-blue-900">Xác nhận bàn giao xe</h4>
                <p class="text-sm text-blue-700 mt-1">Khi bạn bấm xác nhận, chuyến xe sẽ chính thức chuyển sang trạng thái <strong>Đang thuê</strong>. Khách hàng sẽ phải chịu trách nhiệm đối với phương tiện từ thời điểm này.</p>
                
                <div class="mt-3 flex items-center">
                    <input id="confirmCheckbox" required type="checkbox" class="h-4 w-4 rounded border-blue-300 text-blue-600 focus:ring-blue-500 bg-white">
                    <label for="confirmCheckbox" class="ml-2 block text-sm text-blue-900 font-medium">
                        Tôi xác nhận đã bàn giao xe và giấy tờ cho khách hàng đúng với thông tin trên.
                    </label>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-4 pt-2">
            <button type="submit" id="btnSubmit" class="inline-flex items-center justify-center rounded-lg bg-primary px-6 py-2.5 text-sm font-medium text-white hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-primary/50 transition-colors shadow-sm disabled:opacity-50 disabled:cursor-not-allowed">
                Xác nhận Bàn giao
            </button>
            <a href="/Owner/Bookings/Detail?id=@Model.Id" class="inline-flex items-center justify-center rounded-lg bg-white border border-zinc-300 px-6 py-2.5 text-sm font-medium text-zinc-700 hover:bg-zinc-50 focus:outline-none transition-colors">
                Hủy bỏ
            </a>
        </div>
        
        <div id="formError" class="hidden rounded-md bg-red-50 p-4 mt-4">
            <p class="text-sm font-medium text-red-800" id="formErrorMsg"></p>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const bookingId = @Model.Id;

        document.addEventListener('DOMContentLoaded', async () => {
            // Load code just for UI display
            try {
                const response = await fetch(`/api/proxy/owner/bookings/${bookingId}`, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('vivucar_token')}` }
                });
                if(response.ok) {
                    const data = await response.json();
                    document.getElementById('bookingCode').textContent = data.bookingCode;
                }
            } catch (e) {}

            document.getElementById('btnAddImageRow').addEventListener('click', () => {
                const container = document.getElementById('imagesContainer');
                const row = document.createElement('div');
                row.className = 'flex gap-4 items-start image-row';
                row.innerHTML = `
                    <div class="flex-1">
                        <input type="url" class="img-url block w-full px-3 py-2 border border-zinc-300 rounded-lg focus:ring-primary focus:border-primary sm:text-sm" placeholder="https://..." required />
                    </div>
                    <div class="w-1/3">
                        <input type="text" class="img-caption block w-full px-3 py-2 border border-zinc-300 rounded-lg focus:ring-primary focus:border-primary sm:text-sm" placeholder="Ghi chú ảnh" />
                    </div>
                    <button type="button" class="btn-remove-img text-zinc-400 hover:text-red-500 p-2">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                    </button>
                `;
                container.appendChild(row);

                row.querySelector('.btn-remove-img').addEventListener('click', function() {
                    row.remove();
                });
            });

            document.getElementById('handoverForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                
                const btn = document.getElementById('btnSubmit');
                const err = document.getElementById('formError');
                const errMsg = document.getElementById('formErrorMsg');
                
                btn.disabled = true;
                btn.textContent = 'Đang xử lý...';
                err.classList.add('hidden');

                const imageRows = document.querySelectorAll('.image-row');
                const images = Array.from(imageRows).map(row => ({
                    imageUrl: row.querySelector('.img-url').value.trim(),
                    caption: row.querySelector('.img-caption').value.trim()
                })).filter(x => x.imageUrl);

                const payload = {
                    odometerKm: parseFloat(document.getElementById('odometerKm').value),
                    fuelLevel: parseFloat(document.getElementById('fuelLevel').value),
                    damageNotes: document.getElementById('damageNotes').value,
                    note: document.getElementById('note').value,
                    images: images
                };

                try {
                    const res = await fetch(`/api/proxy/owner/bookings/${bookingId}/handover`, {
                        method: 'POST',
                        headers: {
                            'Authorization': `Bearer ${localStorage.getItem('vivucar_token')}`,
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(payload)
                    });

                    if (!res.ok) {
                        const errorObj = await res.json();
                        throw new Error(errorObj.message || 'Lỗi xử lý bàn giao');
                    }

                    window.VivuCarUtils.showToast('Bàn giao thành công', 'success');
                    setTimeout(() => window.location.href = `/Owner/Bookings/Detail?id=${bookingId}`, 1500);
                } catch (error) {
                    errMsg.textContent = error.message;
                    err.classList.remove('hidden');
                    btn.disabled = false;
                    btn.textContent = 'Xác nhận Bàn giao';
                }
            });
        });
    </script>
}

@page
@model WebClient.Pages.Owner.DashboardModel
@{
    ViewData["Title"] = "Dashboard Chủ Xe";
    ViewData["OwnerPage"] = "dashboard";
    
}

<div class="space-y-6">
    <!-- Stat Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white rounded-xl border border-zinc-200 p-6 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-sm font-medium text-zinc-500">Tổng xe</p>
                    <p class="text-3xl font-bold text-zinc-900 mt-2" id="statTotalCars">-</p>
                </div>
                <div class="p-2 bg-blue-50 text-blue-600 rounded-lg">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
                </div>
            </div>
            <div class="mt-4 flex gap-4 text-sm">
                <div class="flex items-center text-green-600">
                    <span class="w-2 h-2 rounded-full bg-green-500 mr-2"></span>
                    Rảnh: <span id="statAvailableCars" class="ml-1 font-semibold">-</span>
                </div>
                <div class="flex items-center text-orange-600">
                    <span class="w-2 h-2 rounded-full bg-orange-500 mr-2"></span>
                    Đang thuê: <span id="statRentedCars" class="ml-1 font-semibold">-</span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl border border-zinc-200 p-6 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-sm font-medium text-zinc-500">Yêu cầu thuê chờ duyệt</p>
                    <p class="text-3xl font-bold text-zinc-900 mt-2" id="statPendingBookings">-</p>
                </div>
                <div class="p-2 bg-amber-50 text-amber-600 rounded-lg">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
            </div>
            <div class="mt-4">
                <a asp-page="/Owner/Bookings/Index" asp-route-status="pendingapproval" class="text-sm text-primary font-medium hover:underline">Xem yêu cầu &rarr;</a>
            </div>
        </div>

        <div class="bg-white rounded-xl border border-zinc-200 p-6 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-sm font-medium text-zinc-500">Đang thực hiện</p>
                    <p class="text-3xl font-bold text-zinc-900 mt-2" id="statActiveBookings">-</p>
                </div>
                <div class="p-2 bg-indigo-50 text-indigo-600 rounded-lg">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                </div>
            </div>
            <div class="mt-4">
                <a asp-page="/Owner/Bookings/Index" asp-route-status="inprogress" class="text-sm text-primary font-medium hover:underline">Quản lý chuyến &rarr;</a>
            </div>
        </div>

        <div class="bg-white rounded-xl border border-zinc-200 p-6 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-sm font-medium text-zinc-500">Doanh thu tháng này</p>
                    <p class="text-3xl font-bold text-green-600 mt-2" id="statMonthlyRevenue">-</p>
                </div>
                <div class="p-2 bg-green-50 text-green-600 rounded-lg">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Bookings Table -->
    <div class="bg-white rounded-xl border border-zinc-200 shadow-sm overflow-hidden">
        <div class="px-6 py-5 border-b border-zinc-200 flex justify-between items-center bg-zinc-50/50">
            <h2 class="text-lg font-bold text-zinc-900">Đơn thuê xe gần đây</h2>
            <a asp-page="/Owner/Bookings/Index" class="text-sm font-medium text-primary hover:underline">Xem tất cả</a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left whitespace-nowrap">
                <thead class="text-xs text-zinc-500 uppercase bg-zinc-50 border-b border-zinc-200">
                    <tr>
                        <th scope="col" class="px-6 py-4 font-semibold">Mã đơn</th>
                        <th scope="col" class="px-6 py-4 font-semibold">Xe</th>
                        <th scope="col" class="px-6 py-4 font-semibold">Khách hàng</th>
                        <th scope="col" class="px-6 py-4 font-semibold">Thời gian</th>
                        <th scope="col" class="px-6 py-4 font-semibold">Tổng tiền</th>
                        <th scope="col" class="px-6 py-4 font-semibold">Trạng thái</th>
                        <th scope="col" class="px-6 py-4 text-right font-semibold">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="recentBookingsTbody" class="divide-y divide-zinc-100">
                    <tr>
                        <td colspan="7" class="px-6 py-8 text-center text-zinc-500">
                            <div class="flex justify-center mb-2">
                                <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-primary"></div>
                            </div>
                            Đang tải dữ liệu...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            try {
                const response = await fetch('/api/proxy/owner/dashboard', {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('vivucar_token')}` }
                });
                
                if (!response.ok) {
                    if (response.status === 401) {
                        window.location.href = '/Index';
                        return;
                    }
                    throw new Error('Failed to load dashboard data');
                }

                const data = await response.json();
                
                document.getElementById('statTotalCars').textContent = data.totalCars;
                document.getElementById('statAvailableCars').textContent = data.availableCars;
                document.getElementById('statRentedCars').textContent = data.rentedCars;
                document.getElementById('statPendingBookings').textContent = data.pendingBookings;
                document.getElementById('statActiveBookings').textContent = data.activeBookings;
                document.getElementById('statMonthlyRevenue').textContent = window.VivuCarUtils ? window.VivuCarUtils.formatVnd(data.monthlyRevenue) : data.monthlyRevenue.toLocaleString('vi-VN') + 'đ';

                const tbody = document.getElementById('recentBookingsTbody');
                if (data.recentBookings && data.recentBookings.length > 0) {
                    tbody.innerHTML = data.recentBookings.map(b => `
                        <tr class="hover:bg-zinc-50 transition-colors">
                            <td class="px-6 py-4 font-medium text-zinc-900">${b.bookingCode}</td>
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    ${b.carImageUrl 
                                        ? `<img src="${b.carImageUrl}" class="w-10 h-10 rounded object-cover" />`
                                        : `<div class="w-10 h-10 rounded bg-zinc-200 flex items-center justify-center"><svg class="w-5 h-5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L28 20M6 12a2 2 0 11-4 0 2 2 0 014 0z"/></svg></div>`
                                    }
                                    <div>
                                        <div class="font-medium text-zinc-900">${b.carName}</div>
                                        <div class="text-xs text-zinc-500">${b.licensePlate}</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="font-medium text-zinc-900">${b.customerName}</div>
                                <div class="text-xs text-zinc-500">${b.customerPhone}</div>
                            </td>
                            <td class="px-6 py-4 text-xs text-zinc-500">
                                <div>${new Date(b.startDateTime).toLocaleDateString('vi-VN')}</div>
                                <div>${new Date(b.endDateTime).toLocaleDateString('vi-VN')}</div>
                            </td>
                            <td class="px-6 py-4 font-semibold text-zinc-900">
                                ${window.VivuCarUtils ? window.VivuCarUtils.formatVnd(b.totalAmount) : b.totalAmount.toLocaleString('vi-VN') + 'đ'}
                            </td>
                            <td class="px-6 py-4">
                                ${window.VivuCarUtils ? window.VivuCarUtils.renderBookingStatusBadge(b.status) : `<span class="px-2.5 py-1 text-xs font-medium rounded-full bg-zinc-100 text-zinc-700">${b.status}</span>`}
                            </td>
                            <td class="px-6 py-4 text-right">
                                <a href="/Owner/Bookings/Detail?id=${b.id}" class="text-primary font-medium hover:underline">Chi tiết</a>
                            </td>
                        </tr>
                    `).join('');
                } else {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="7" class="px-6 py-12 text-center">
                                <div class="flex flex-col items-center justify-center text-zinc-400">
                                    <svg class="h-12 w-12 mb-3 text-zinc-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                    </svg>
                                    <p>Chưa có đơn thuê xe nào.</p>
                                </div>
                            </td>
                        </tr>
                    `;
                }
            } catch (error) {
                console.error('Lỗi khi tải dashboard:', error);
                document.getElementById('recentBookingsTbody').innerHTML = `
                    <tr><td colspan="7" class="px-6 py-8 text-center text-red-500">Lỗi khi tải dữ liệu. Vui lòng thử lại sau.</td></tr>
                `;
            }
        });
    </script>
}

@page "/cars/detail"
@model WebClient.Pages.Cars.DetailModel
@{
    ViewData["Title"] = "Car Detail - VivuCar";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title id="pageTitle">@ViewData["Title"]</title>
    <meta name="description" content="Car rental details: specs, photos, pricing, policies, owner info, and reviews." />
    <script>
        tailwind = { config: { theme: { extend: { colors: { primary: { DEFAULT:'#16a34a',50:'#f0fdf4',100:'#dcfce7',700:'#15803d' } }, fontFamily: { sans:['Be Vietnam Pro','Segoe UI','Arial','sans-serif'] } } } } };
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        .tab-btn { cursor:pointer; padding:10px 18px; font-size:.875rem; font-weight:600; border-bottom:2px solid transparent; color:#71717a; transition:all .15s; }
        .tab-btn.active { border-bottom-color:#16a34a; color:#16a34a; }
        .gallery-thumb { cursor:pointer; border:2px solid transparent; border-radius:8px; overflow:hidden; transition:border-color .15s; }
        .gallery-thumb.active, .gallery-thumb:hover { border-color:#16a34a; }
        .skeleton { background:linear-gradient(90deg,#f0f0f0 25%,#e0e0e0 50%,#f0f0f0 75%); background-size:200% 100%; animation:shimmer 1.5s infinite; border-radius:12px; }
        @@keyframes shimmer { 0%{background-position:200% 0} 100%{background-position:-200% 0} }
    </style>
</head>
<body class="bg-zinc-50 text-zinc-900 font-sans antialiased">

    <!-- Navbar -->
    <partial name="_Navbar" />

    <!-- Breadcrumb -->
    <div class="bg-white border-b border-zinc-100 px-4 py-3 text-sm text-zinc-500">
        <div class="max-w-7xl mx-auto flex items-center gap-2">
            <a href="/cars" class="hover:text-primary transition-colors">Home</a>
            <span>›</span>
            <a href="/cars/search" class="hover:text-primary transition-colors">Browse Cars</a>
            <span>›</span>
            <span id="breadcrumbName" class="text-zinc-900 font-medium">Car Detail</span>
        </div>
    </div>

    <!-- Loading -->
    <div id="loadingState" class="max-w-7xl mx-auto px-4 py-10">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="lg:col-span-2 space-y-4">
                <div class="skeleton h-80 w-full"></div>
                <div class="flex gap-2"><div class="skeleton h-20 w-28"></div><div class="skeleton h-20 w-28"></div><div class="skeleton h-20 w-28"></div></div>
                <div class="skeleton h-48 w-full"></div>
            </div>
            <div><div class="skeleton h-96 w-full"></div></div>
        </div>
    </div>

    <!-- Error -->
    <div id="errorState" class="hidden max-w-7xl mx-auto px-4 py-24 text-center">
        <svg class="h-16 w-16 mx-auto mb-4 text-zinc-200" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        <h2 class="font-bold text-xl text-zinc-700 mb-2">Car Not Found</h2>
        <p class="text-zinc-400 mb-6">This car no longer exists or has been removed.</p>
        <a href="/cars/search" class="px-6 py-2.5 bg-primary text-white rounded-xl font-semibold text-sm hover:bg-green-700 transition-colors">← Back to Browse</a>
    </div>

    <!-- Main Content -->
    <main id="detailContent" class="hidden max-w-7xl mx-auto px-4 py-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

            <!-- Left: Gallery + Tabs -->
            <div class="lg:col-span-2 space-y-5">
                <!-- Gallery -->
                <div class="bg-white rounded-2xl border border-zinc-200 overflow-hidden">
                    <div class="relative bg-zinc-100">
                        <img id="mainImage" src="" alt="" class="w-full h-80 object-cover" />
                        <button id="prevImg" class="absolute left-3 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/70 text-white rounded-full p-2 transition-colors">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                        </button>
                        <button id="nextImg" class="absolute right-3 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/70 text-white rounded-full p-2 transition-colors">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                        </button>
                        <span id="imgCounter" class="absolute bottom-3 right-3 bg-black/60 text-white text-xs px-2 py-1 rounded-full"></span>
                    </div>
                    <div id="thumbRow" class="flex gap-2 p-3 overflow-x-auto"></div>
                </div>

                <!-- Tabs -->
                <div class="bg-white rounded-2xl border border-zinc-200 overflow-hidden">
                    <div class="flex border-b border-zinc-200">
                        <button class="tab-btn active" data-tab="description">Description</button>
                        <button class="tab-btn" data-tab="specs">Specifications</button>
                        <button class="tab-btn" data-tab="rules">Rental Policy</button>
                        <button class="tab-btn" data-tab="reviews">Reviews</button>
                    </div>
                    <div id="tabContent" class="p-6 min-h-[200px]"></div>
                </div>
            </div>

            <!-- Right: Booking + Owner -->
            <div class="space-y-5 sticky top-20 self-start">
                <!-- Booking Card -->
                <div class="bg-white rounded-2xl border border-zinc-200 p-5 space-y-4">
                    <div>
                        <p id="cardBrand" class="text-xs text-zinc-400 font-semibold uppercase tracking-wide mb-1"></p>
                        <h1 id="cardName" class="text-xl font-bold text-zinc-900 leading-tight"></h1>
                        <p id="cardLocation" class="text-sm text-zinc-500 mt-1 flex items-center gap-1">
                            <svg class="h-4 w-4 text-zinc-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                            <span></span>
                        </p>
                    </div>

                    <div class="flex flex-wrap gap-2">
                        <span id="statusBadge" class="text-xs font-semibold px-3 py-1 rounded-full bg-green-100 text-green-700">Available</span>
                        <span id="ratingBadge" class="text-xs font-semibold px-3 py-1 rounded-full bg-amber-50 text-amber-700"></span>
                    </div>

                    <div class="py-3 border-y border-zinc-100">
                        <div class="flex items-baseline gap-1">
                            <span id="dailyPrice" class="text-2xl font-extrabold text-zinc-900"></span>
                            <span class="text-zinc-400 text-sm">/day</span>
                        </div>
                        <p id="depositInfo" class="text-xs text-zinc-400 mt-1"></p>
                    </div>

                    <!-- Date Pickers -->
                    <div class="space-y-3">
                        <div>
                            <label class="block text-xs font-semibold text-zinc-500 mb-1">Pickup Date</label>
                            <input id="pickupDate" type="date" class="w-full border border-zinc-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-zinc-500 mb-1">Return Date</label>
                            <input id="returnDate" type="date" class="w-full border border-zinc-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
                        </div>
                    </div>

                    <!-- Price Estimate -->
                    <div id="priceEstimate" class="hidden bg-zinc-50 rounded-xl p-3 space-y-1 text-sm">
                        <div class="flex justify-between text-zinc-600"><span>Rental days</span><span id="totalDays" class="font-semibold">1 day</span></div>
                        <div class="flex justify-between text-zinc-600"><span>Rental fee</span><span id="rentalSubtotal" class="font-semibold"></span></div>
                        <div class="flex justify-between text-zinc-600"><span>Insurance</span><span id="insuranceSubtotal" class="font-semibold"></span></div>
                        <div class="flex justify-between font-bold text-zinc-900 pt-1 border-t border-zinc-200">
                            <span>Estimated Total</span><span id="totalEstimate" class="text-primary"></span>
                        </div>
                    </div>

                    <!-- Date validation error msg -->
                    <p id="dateError" class="hidden text-xs font-semibold text-red-600 bg-red-50 px-3 py-2 rounded-lg"></p>

                    <!-- CTAs -->
                    <div class="space-y-2">
                        <button id="btnBook" type="button"
                           style="display:block;width:100%;text-align:center;background:#16a34a;color:#ffffff;font-weight:700;padding:12px 0;border-radius:12px;font-size:0.875rem;border:none;cursor:pointer;transition:background 0.2s;"
                           onmouseover="if(this.dataset.available!=='false') this.style.background='#15803d'"
                           onmouseout="if(this.dataset.available!=='false') this.style.background='#16a34a'">
                            Book Car
                        </button>
                        <button id="btnContact"
                                class="w-full border border-zinc-200 text-zinc-700 font-semibold py-3 rounded-xl text-sm hover:bg-zinc-50 transition-colors">
                            Message Owner
                        </button>
                    </div>
                </div>

                <!-- Owner Info Card -->
                <div id="ownerCard" class="bg-white rounded-2xl border border-zinc-200 p-5">
                    <h3 class="text-sm font-bold text-zinc-700 mb-3">Car Owner</h3>
                    <div class="flex items-center gap-3">
                        <div id="ownerAvatar" class="w-12 h-12 rounded-full bg-zinc-200 flex items-center justify-center text-zinc-400 shrink-0 overflow-hidden">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                        </div>
                        <div>
                            <p id="ownerName" class="font-semibold text-zinc-900 text-sm"></p>
                            <p class="text-xs text-zinc-400">Verified VivuCar Owner</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="border-t border-zinc-200 bg-white py-8 mt-10 text-center text-sm text-zinc-500">
        &copy; 2026 VivuCar &mdash; Self-Drive Car Rental
    </footer>

    <script type="module">
        import { authService } from '/js/shared/auth-service.js';
        window.VivuCarAuthService = authService;
        authService.refresh().then(s => {
            const u = s?.user ?? null;
            if (u) {
                document.getElementById('navUserName').textContent = u.fullName;
                document.getElementById('navUserName').classList.remove('hidden');
                document.getElementById('navLoginBtn').classList.add('hidden');
                document.getElementById('navLogoutBtn').classList.remove('hidden');
            }
        });
        document.getElementById('navLogoutBtn').addEventListener('click', async () => { await authService.logout(); window.location.href = '/'; });
    </script>
    <script>
        const carId = new URLSearchParams(location.search).get('id');
        let CAR = null, images = [], currentImg = 0;

        const fmt = n => (n||0).toLocaleString('vi-VN') + '₫';
        const fuelMap = { Gasoline:'Gasoline', Electric:'Electric', Diesel:'Diesel', Hybrid:'Hybrid' };
        const transMap = { Automatic:'Automatic', Manual:'Manual', Cvt:'CVT' };

        function showError() { document.getElementById('loadingState').classList.add('hidden'); document.getElementById('errorState').classList.remove('hidden'); }
        function showContent() { document.getElementById('loadingState').classList.add('hidden'); document.getElementById('detailContent').classList.remove('hidden'); }

        async function loadCar() {
            if (!carId) { showError(); return; }
            try {
                const r = await fetch(`/api/proxy/cars/${carId}`);
                if (!r.ok) { showError(); return; }
                CAR = await r.json();
                renderCar();
            } catch(e) { console.error('Failed to load car detail:', e); showError(); }
        }

        function renderCar() {
            images = CAR.images || [];
            const primary = images.findIndex(i => i.isPrimary);
            currentImg = primary >= 0 ? primary : 0;

            document.title = `${CAR.name} – VivuCar`;
            document.getElementById('pageTitle').textContent = `${CAR.name} – VivuCar`;
            document.getElementById('breadcrumbName').textContent = CAR.name;
            document.getElementById('cardBrand').textContent = CAR.brandName || '';
            document.getElementById('cardName').textContent = CAR.name;
            document.getElementById('cardLocation').querySelector('span').textContent = CAR.location || 'Da Nang';
            document.getElementById('dailyPrice').textContent = fmt(CAR.dailyPrice);
            document.getElementById('depositInfo').textContent = `Deposit: ${fmt(CAR.depositAmount)}  ·  Insurance: ${fmt(CAR.insuranceFeePerDay)}/day`;
            document.getElementById('ratingBadge').textContent = `★ ${(CAR.averageRating||0).toFixed(1)}  (${(CAR.reviews||[]).length} reviews)`;

            const st = (CAR.status||'Available').toLowerCase();
            const ok = st === 'available';
            const sb = document.getElementById('statusBadge');
            if (st === 'available') {
                sb.textContent = '✓ Available';
                sb.className = 'text-xs font-semibold px-3 py-1 rounded-full bg-green-100 text-green-700';
            } else if (st === 'rented') {
                sb.textContent = 'Rented';
                sb.className = 'text-xs font-semibold px-3 py-1 rounded-full bg-amber-100 text-amber-700';
            } else if (st === 'maintenance') {
                sb.textContent = 'Maintenance';
                sb.className = 'text-xs font-semibold px-3 py-1 rounded-full bg-orange-100 text-orange-700';
            } else {
                sb.textContent = CAR.status || 'Unavailable';
                sb.className = 'text-xs font-semibold px-3 py-1 rounded-full bg-zinc-100 text-zinc-500';
            }

            const btnBook = document.getElementById('btnBook');
            if (ok) {
                btnBook.textContent = 'Book Car';
                btnBook.dataset.available = 'true';
                btnBook.style.cssText = 'display:block;width:100%;text-align:center;background:#16a34a;color:#ffffff;font-weight:700;padding:12px 0;border-radius:12px;font-size:0.875rem;border:none;cursor:pointer;transition:background 0.2s;';
            } else {
                btnBook.textContent = st === 'rented' ? 'Currently Rented' : (st === 'maintenance' ? 'Under Maintenance' : 'Unavailable');
                btnBook.dataset.available = 'false';
                btnBook.style.cssText = 'display:block;width:100%;text-align:center;background:#e4e4e7;color:#a1a1aa;font-weight:700;padding:12px 0;border-radius:12px;font-size:0.875rem;border:none;cursor:not-allowed;';
            }

            document.getElementById('ownerName').textContent = CAR.ownerFullName || 'Car Owner';
            if (CAR.ownerAvatarUrl) document.getElementById('ownerAvatar').innerHTML = `<img src="${CAR.ownerAvatarUrl}" class="w-full h-full object-cover" />`;

            renderGallery();
            renderTab('description');
            showContent();
        }

        function renderGallery() {
            const main = document.getElementById('mainImage');
            if (!images.length) {
                main.closest('.relative').innerHTML = '<div class="w-full h-80 bg-zinc-100 flex items-center justify-center text-zinc-300 text-6xl">🚗</div>';
                return;
            }
            main.src = images[currentImg].imageUrl;
            main.alt = CAR.name;
            updateCounter();
            document.getElementById('thumbRow').innerHTML = images.map((img, i) =>
                `<div class="gallery-thumb shrink-0 ${i===currentImg?'active':''}" data-idx="${i}">
                    <img src="${img.imageUrl}" alt="${i+1}" class="h-20 w-28 object-cover" />
                 </div>`
            ).join('');
        }

        function updateCounter() {
            const el = document.getElementById('imgCounter');
            if (el) el.textContent = `${currentImg+1} / ${images.length}`;
        }

        function setImage(idx) {
            currentImg = ((idx % images.length) + images.length) % images.length;
            document.getElementById('mainImage').src = images[currentImg].imageUrl;
            document.querySelectorAll('.gallery-thumb').forEach((el,i) => el.classList.toggle('active', i===currentImg));
            updateCounter();
        }

        document.getElementById('prevImg').addEventListener('click', () => setImage(currentImg-1));
        document.getElementById('nextImg').addEventListener('click', () => setImage(currentImg+1));
        document.getElementById('thumbRow').addEventListener('click', e => {
            const t = e.target.closest('[data-idx]');
            if (t) setImage(+t.dataset.idx);
        });

        // Tabs
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                renderTab(btn.dataset.tab);
            });
        });

        function renderTab(tab) {
            const el = document.getElementById('tabContent');
            if (tab === 'description') {
                el.innerHTML = `
                    <h2 class="font-bold text-zinc-900 text-lg mb-3">About This Car</h2>
                    <p class="text-zinc-600 text-sm leading-relaxed">${CAR.description || 'No description available.'}</p>`;
            } else if (tab === 'specs') {
                const rows = [
                    ['Brand', CAR.brandName], ['Model', CAR.modelName],
                    ['License Plate', CAR.licensePlate], ['Seats', `${CAR.seatCount} seats`],
                    ['Transmission', transMap[CAR.transmissionType]||CAR.transmissionType],
                    ['Fuel', fuelMap[CAR.fuelType]||CAR.fuelType],
                    ['Delivery Fee', fmt(CAR.deliveryFee)],
                ];
                el.innerHTML = `
                    <h2 class="font-bold text-zinc-900 text-lg mb-4">Specifications</h2>
                    <table class="w-full text-sm">
                        <tbody class="divide-y divide-zinc-100">
                            ${rows.map(([k,v]) => `<tr><td class="py-2.5 pr-4 text-zinc-500 font-medium w-40">${k}</td><td class="py-2.5 font-semibold text-zinc-900">${v||'—'}</td></tr>`).join('')}
                        </tbody>
                    </table>`;
            } else if (tab === 'rules') {
                el.innerHTML = `
                    <h2 class="font-bold text-zinc-900 text-lg mb-4">Rental Policy</h2>
                    <ul class="space-y-3 text-sm text-zinc-600">
                        <li class="flex items-start gap-3"><span class="text-green-500">✓</span>Valid B2 driving license required.</li>
                        <li class="flex items-start gap-3"><span class="text-green-500">✓</span>Security deposit: ${fmt(CAR.depositAmount)} before pickup.</li>
                        <li class="flex items-start gap-3"><span class="text-green-500">✓</span>Insurance fee: ${fmt(CAR.insuranceFeePerDay)}/day.</li>
                        <li class="flex items-start gap-3"><span class="text-amber-400">⚠</span>No smoking inside the car. Fine: 500,000₫.</li>
                        <li class="flex items-start gap-3"><span class="text-amber-400">⚠</span>Return on time. Late returns incur hourly surcharges.</li>
                        <li class="flex items-start gap-3"><span class="text-amber-400">⚠</span>Full liability for damage not covered by insurance.</li>
                    </ul>`;
            } else if (tab === 'reviews') {
                const reviews = CAR.reviews || [];
                const avg = CAR.averageRating || 0;
                const stars = r => '★'.repeat(Math.round(r)) + '☆'.repeat(5-Math.round(r));
                el.innerHTML = `
                    <h2 class="font-bold text-zinc-900 text-lg mb-4">Customer Reviews</h2>
                    <div class="flex items-center gap-4 mb-5 p-4 bg-zinc-50 rounded-xl">
                        <div class="text-4xl font-extrabold text-zinc-900">${avg.toFixed(1)}</div>
                        <div><div class="text-lg text-amber-400">${stars(avg)}</div><div class="text-sm text-zinc-500">${reviews.length} review${reviews.length!==1?'s':''}</div></div>
                    </div>
                    ${reviews.length
                        ? reviews.map(r => `
                            <div class="border-b border-zinc-100 py-4 last:border-0">
                                <div class="flex items-center gap-3 mb-2">
                                    ${r.customerAvatarUrl
                                        ? `<img src="${r.customerAvatarUrl}" class="w-9 h-9 rounded-full object-cover" />`
                                        : `<div class="w-9 h-9 rounded-full bg-zinc-200 flex items-center justify-center text-zinc-400 font-semibold text-sm">${(r.customerName||'U').charAt(0).toUpperCase()}</div>`}
                                    <div>
                                        <p class="font-semibold text-sm text-zinc-900">${r.customerName||'Customer'}</p>
                                        <p class="text-xs text-zinc-400">${new Date(r.createdAt).toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'})}</p>
                                    </div>
                                    <div class="ml-auto text-amber-400 text-sm">${stars(r.rating)}</div>
                                </div>
                                <p class="text-sm text-zinc-600 leading-relaxed">${r.comment||''}</p>
                            </div>`).join('')
                        : '<p class="text-zinc-400 text-sm">No reviews yet — be the first!</p>'
                    }`;
            }
        }

        // Price calculator
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('pickupDate').min = today;
        document.getElementById('returnDate').min = today;

        function updatePrice() {
            const p = document.getElementById('pickupDate').value;
            const r = document.getElementById('returnDate').value;
            if (!p || !r || !CAR) { document.getElementById('priceEstimate').classList.add('hidden'); return; }
            const days = Math.max(1, Math.ceil((new Date(r)-new Date(p))/86400000));
            const rental    = days * CAR.dailyPrice;
            const insurance = days * (CAR.insuranceFeePerDay||0);
            document.getElementById('totalDays').textContent = `${days} day${days>1?'s':''}`;
            document.getElementById('rentalSubtotal').textContent = fmt(rental);
            document.getElementById('insuranceSubtotal').textContent = fmt(insurance);
            document.getElementById('totalEstimate').textContent = fmt(rental+insurance);
            document.getElementById('priceEstimate').classList.remove('hidden');
        }

        function updateBookLink() {
            // No longer sets href - handled via click handler below
        }

        ['pickupDate','returnDate'].forEach(id => document.getElementById(id).addEventListener('change', () => {
            updatePrice();
            // Clear error on date change
            const errEl = document.getElementById('dateError');
            if (errEl) { errEl.textContent = ''; errEl.classList.add('hidden'); }
            ['pickupDate','returnDate'].forEach(f => document.getElementById(f).style.borderColor = '');
        }));
        document.getElementById('pickupDate').addEventListener('change', () => {
            document.getElementById('returnDate').min = document.getElementById('pickupDate').value;
        });

        // Book Car click - validate dates first
        document.getElementById('btnBook').addEventListener('click', async () => {
            const btn = document.getElementById('btnBook');
            if (!CAR || btn.dataset.available === 'false') return;

            if (window.VivuCarAuthService) {
                const s = await window.VivuCarAuthService.refresh();
                if (!s || !s.user) {
                    alert('Phiên đăng nhập đã hết hạn hoặc chưa đăng nhập. Vui lòng đăng nhập để đặt xe.');
                    window.location.href = '/';
                    return;
                }
            }

            const pickup = document.getElementById('pickupDate').value;
            const ret    = document.getElementById('returnDate').value;
            const errEl  = document.getElementById('dateError');

            // Reset
            ['pickupDate','returnDate'].forEach(f => document.getElementById(f).style.borderColor = '');
            errEl.classList.add('hidden');

            if (!pickup && !ret) {
                errEl.textContent = 'Vui lòng chọn ngày nhận xe và trả xe.';
                errEl.classList.remove('hidden');
                ['pickupDate','returnDate'].forEach(f => { document.getElementById(f).style.borderColor = '#ef4444'; });
                document.getElementById('pickupDate').focus();
                return;
            }
            if (!pickup) {
                errEl.textContent = 'Vui lòng chọn ngày nhận xe.';
                errEl.classList.remove('hidden');
                document.getElementById('pickupDate').style.borderColor = '#ef4444';
                document.getElementById('pickupDate').focus();
                return;
            }
            if (!ret) {
                errEl.textContent = 'Vui lòng chọn ngày trả xe.';
                errEl.classList.remove('hidden');
                document.getElementById('returnDate').style.borderColor = '#ef4444';
                document.getElementById('returnDate').focus();
                return;
            }
            if (new Date(ret) <= new Date(pickup)) {
                errEl.textContent = 'Ngày trả xe phải sau ngày nhận xe.';
                errEl.classList.remove('hidden');
                document.getElementById('returnDate').style.borderColor = '#ef4444';
                document.getElementById('returnDate').focus();
                return;
            }

            // All good - navigate
            window.location.href = `/Booking/Checkout?carId=${CAR.id}&pickupDate=${pickup}&returnDate=${ret}`;
        });

        document.getElementById('btnContact').addEventListener('click', () => {
            alert(`Contact owner: ${CAR?.ownerFullName||'Car Owner'}\nPlease submit a booking request to contact the owner.`);
        });

        loadCar();
    </script>
</body>
</html>

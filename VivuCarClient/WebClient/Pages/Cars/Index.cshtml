@page "/home"
@model WebClient.Pages.Cars.IndexModel
@{
    ViewData["Title"] = "Browse Cars - VivuCar";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="VivuCar - Da Nang's #1 self-drive car rental platform. Find the perfect car at the best price." />
    <script>
        tailwind = { config: { theme: { extend: { colors: { primary: { DEFAULT: '#16a34a', 50:'#f0fdf4', 100:'#dcfce7', 700:'#15803d' } }, fontFamily: { sans: ['Be Vietnam Pro','Segoe UI','Arial','sans-serif'] } } } } };
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/chat.css" />
    <style>
        .car-card { transition: transform .2s, box-shadow .2s; }
        .car-card:hover { transform: translateY(-4px); box-shadow: 0 20px 40px rgba(0,0,0,.1); }
        .hero-gradient { background: linear-gradient(135deg,#0f172a 0%,#064e3b 50%,#0f172a 100%); }
        .skeleton { background: linear-gradient(90deg,#f0f0f0 25%,#e0e0e0 50%,#f0f0f0 75%); background-size:200% 100%; animation:shimmer 1.5s infinite; border-radius:12px; height:280px; }
        @@keyframes shimmer { 0%{background-position:200% 0} 100%{background-position:-200% 0} }
    </style>
</head>
<body class="bg-zinc-50 text-zinc-900 font-sans antialiased">

    <!-- Navbar -->
    <partial name="_Navbar" />

    <!-- Hero Section -->
    <section class="hero-gradient text-white py-20 px-4">
        <div class="max-w-7xl mx-auto">
            <div class="max-w-2xl mb-10">
                <p class="text-green-300 text-sm font-semibold uppercase tracking-widest mb-3">#1 Self-Drive Car Rental Platform</p>
                <h1 class="text-4xl md:text-6xl font-extrabold leading-tight mb-5">Find the perfect car<br class="hidden md:block"/> for every journey</h1>
                <p class="text-zinc-300 text-lg">Hundreds of quality cars in Da Nang, great prices, simple process.</p>
            </div>

            <!-- Quick Search Card -->
            <div class="bg-white rounded-2xl shadow-2xl p-6 max-w-4xl text-zinc-950">
                <h2 class="text-zinc-900 font-bold text-lg mb-4">Quick Search</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                    <div class="md:col-span-3">
                        <label class="block text-xs font-semibold text-zinc-500 mb-1 uppercase tracking-wide">Car name or brand</label>
                        <input id="homeSearchInput" type="text" autocomplete="off" placeholder="Toyota Vios, Mazda CX-5, VinFast..."
                               class="w-full border border-zinc-200 rounded-xl px-4 py-3 text-sm text-zinc-900 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" style="color: #09090b;" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-zinc-500 mb-1 uppercase tracking-wide">Area</label>
                        <select id="homeLocationSelect" class="w-full border border-zinc-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary bg-white text-zinc-900" style="color: #09090b;">
                            <option value="" style="color: #09090b;">All areas</option>
                            <option style="color: #09090b;">Hai Chau</option><option style="color: #09090b;">Thanh Khe</option><option style="color: #09090b;">Son Tra</option>
                            <option style="color: #09090b;">Ngu Hanh Son</option><option style="color: #09090b;">Lien Chieu</option><option style="color: #09090b;">Cam Le</option><option style="color: #09090b;">Hoa Vang</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-zinc-500 mb-1 uppercase tracking-wide">Seats</label>
                        <select id="seatQuickSelect" class="w-full border border-zinc-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary bg-white text-zinc-900" style="color: #09090b;">
                            <option value="" style="color: #09090b;">All</option>
                            <option value="4" style="color: #09090b;">4 seats</option><option value="5" style="color: #09090b;">5 seats</option><option value="7" style="color: #09090b;">7 seats</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-zinc-500 mb-1 uppercase tracking-wide">Sort by</label>
                        <select id="homeSortSelect" class="w-full border border-zinc-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary bg-white text-zinc-900" style="color: #09090b;">
                            <option value="" style="color: #09090b;">Most relevant</option>
                            <option value="price_asc" style="color: #09090b;">Price: Low to High</option>
                            <option value="price_desc" style="color: #09090b;">Price: High to Low</option>
                            <option value="rating_desc" style="color: #09090b;">Highest Rated</option>
                        </select>
                    </div>
                </div>
                <button id="btnQuickSearch" style="display:block;width:100%;background:#16a34a;color:#fff;font-weight:700;padding:12px 24px;border-radius:12px;font-size:.875rem;border:none;cursor:pointer;" onmouseover="this.style.background='#15803d'" onmouseout="this.style.background='#16a34a'">
                    Search Cars
                </button>
            </div>
        </div>
    </section>

    <!-- Stats Band -->
    <section class="bg-white border-b border-zinc-100 py-8 px-4">
        <div class="max-w-7xl mx-auto">
            <div id="homeStats" class="grid grid-cols-3 gap-6 text-center">
                <div class="animate-pulse h-12 bg-zinc-100 rounded-xl col-span-3"></div>
            </div>
        </div>
    </section>

    <main class="max-w-7xl mx-auto px-4 py-10 space-y-16">
        <!-- Featured Cars -->
        <section>
            <div class="flex items-end justify-between mb-6">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-1">Top Picks</p>
                    <h2 class="text-2xl font-bold text-zinc-900">Featured Cars</h2>
                </div>
                <a href="/cars/search?sortBy=rating_desc" class="text-sm font-semibold text-primary hover:underline">View all &rarr;</a>
            </div>
            <div id="featuredCarsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
                <div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div>
            </div>
        </section>

        <!-- Available Cars -->
        <section>
            <div class="flex items-end justify-between mb-6">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-1">Ready to Book</p>
                    <h2 class="text-2xl font-bold text-zinc-900">Available Cars</h2>
                </div>
                <a href="/cars/search" class="text-sm font-semibold text-primary hover:underline">Advanced search &rarr;</a>
            </div>
            <div id="availableCarsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
                <div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div>
            </div>
        </section>

        <!-- How it Works -->
        <section class="bg-white rounded-2xl border border-zinc-100 p-8">
            <h2 class="text-2xl font-bold text-zinc-900 mb-8 text-center">How It Works</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                @foreach (var (num, title, desc) in new[]{
                    ("01","Search","Browse by area, pickup date and seat count."),
                    ("02","View Details","Check photos, price, status and reviews."),
                    ("03","Book","Pick dates, pay deposit and collect the car.")
                })
                {
                    <article class="flex flex-col items-center text-center">
                        <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center mb-4">
                            <span class="text-2xl font-extrabold text-primary">@num</span>
                        </div>
                        <h3 class="font-bold text-zinc-900 mb-2">@title</h3>
                        <p class="text-sm text-zinc-500 leading-relaxed">@desc</p>
                    </article>
                }
            </div>
        </section>
    </main>

    <footer class="border-t border-zinc-200 bg-white py-8 mt-10 text-center text-sm text-zinc-500">
        &copy; 2026 VivuCar &mdash; Self-Drive Car Rental
    </footer>

    <!-- Inline scripts (Layout = null) -->
    <script type="module">
        import { authService } from '/js/shared/auth-service.js';
        authService.refresh().then(s => {
            const u = s?.user ?? null;
            if (u) {
                document.getElementById('navUserName').textContent = u.fullName;
                document.getElementById('navUserName').classList.remove('hidden');
                document.getElementById('navGuestState')?.classList.add('hidden');
                document.getElementById('navUserState')?.classList.remove('hidden');
            }
        });
        document.getElementById('navLogoutBtn').addEventListener('click', async () => {
            const { authService: a } = await import('/js/shared/auth-service.js');
            await a.logout(); window.location.href = '/';
        });
    </script>
    <script>
        const fmt = n => (n || 0).toLocaleString('vi-VN') + '₫';
        const starsHtml = r => { const f = Math.round(r || 0); return '★'.repeat(f) + '☆'.repeat(5 - f); };

        function getStatusBadge(status) {
            const s = (status || 'Available').toLowerCase();
            if (s === 'available') {
                return `<span class="absolute top-3 left-3 bg-green-100 text-green-700 text-xs font-semibold px-2.5 py-1 rounded-full shadow-sm">Available</span>`;
            } else if (s === 'rented') {
                return `<span class="absolute top-3 left-3 bg-amber-100 text-amber-700 text-xs font-semibold px-2.5 py-1 rounded-full shadow-sm">Rented</span>`;
            } else if (s === 'maintenance') {
                return `<span class="absolute top-3 left-3 bg-orange-100 text-orange-700 text-xs font-semibold px-2.5 py-1 rounded-full shadow-sm">Maintenance</span>`;
            } else if (s === 'blocked') {
                return `<span class="absolute top-3 left-3 bg-red-100 text-red-700 text-xs font-semibold px-2.5 py-1 rounded-full shadow-sm">Blocked</span>`;
            } else {
                return `<span class="absolute top-3 left-3 bg-zinc-100 text-zinc-700 text-xs font-semibold px-2.5 py-1 rounded-full shadow-sm">${status}</span>`;
            }
        }

        function carCard(car) {
            const img = car.primaryImageUrl
                ? `<img src="${car.primaryImageUrl}" alt="${car.name}" class="w-full h-48 object-cover" loading="lazy">`
                : `<div class="w-full h-48 bg-zinc-200 flex items-center justify-center text-zinc-300 text-5xl">🚗</div>`;
            const fuel = { Gasoline:'Gasoline', Electric:'Electric', Diesel:'Diesel', Hybrid:'Hybrid' };
            return `<article class="car-card bg-white rounded-2xl border border-zinc-200 overflow-hidden flex flex-col">
                <div class="relative overflow-hidden">${img}
                    ${getStatusBadge(car.status)}
                </div>
                <div class="p-4 flex flex-col flex-1">
                    <p class="text-xs text-zinc-400 font-medium mb-1">${car.brandName || ''}</p>
                    <h3 class="font-bold text-zinc-900 text-sm leading-snug mb-2">${car.name}</h3>
                    <div class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-zinc-500 mb-2">
                        <span>📍 ${car.location || 'Da Nang'}</span>
                        <span>🪑 ${car.seatCount} seats</span>
                        <span>⚙️ ${car.transmission === 'Automatic' ? 'Auto' : 'Manual'}</span>
                    </div>
                    <div class="flex items-center gap-1 text-xs text-amber-400 mb-3">
                        <span>${starsHtml(car.averageRating)}</span>
                        <span class="text-zinc-500 ml-1">${(car.averageRating || 0).toFixed(1)}</span>
                    </div>
                    <div class="mt-auto flex items-center justify-between">
                        <div><span class="font-bold text-zinc-900">${fmt(car.dailyPrice)}</span><span class="text-xs text-zinc-400">/day</span></div>
                        <a href="/cars/detail?id=${car.id}" style="background:#f0fdf4; color:#15803d; font-size:0.75rem; font-weight:600; padding:6px 14px; border-radius:10px; text-decoration:none; transition:all 0.2s;" onmouseover="this.style.background='#16a34a'; this.style.color='#ffffff';" onmouseout="this.style.background='#f0fdf4'; this.style.color='#15803d';">View Details</a>
                    </div>
                </div>
            </article>`;
        }

        function empty(msg) {
            return `<div class="col-span-4 py-16 text-center text-zinc-400">${msg}</div>`;
        }

        async function loadFeatured() {
            try {
                const r = await fetch('/api/proxy/cars/featured?sortBy=rating_desc&limit=8');
                if (!r.ok) throw new Error(r.status);
                const items = await r.json();
                document.getElementById('featuredCarsGrid').innerHTML = Array.isArray(items) && items.length
                    ? items.map(carCard).join('') : empty('No featured cars yet.');
            } catch(e) {
                console.error('Featured load error:', e);
                document.getElementById('featuredCarsGrid').innerHTML = empty('Could not load featured cars.');
            }
        }

        async function loadAvailable() {
            try {
                const r = await fetch('/api/proxy/cars?pageSize=50&sortBy=newest');
                if (!r.ok) throw new Error(r.status);
                const data = await r.json();
                const allItems = data.items ?? [];
                const availableItems = allItems.filter(c => (c.status || 'Available').toLowerCase() === 'available').slice(0, 8);
                document.getElementById('availableCarsGrid').innerHTML = availableItems.length ? availableItems.map(carCard).join('') : empty('No cars available.');
                if (data.totalCount != null) {
                    document.getElementById('homeStats').innerHTML = `
                        <div><div class="text-3xl font-extrabold text-zinc-900">${availableItems.length}+</div><div class="text-sm text-zinc-500 mt-1">Cars Available</div></div>
                        <div><div class="text-3xl font-extrabold text-zinc-900">7</div><div class="text-sm text-zinc-500 mt-1">Pickup Areas</div></div>
                        <div><div class="text-3xl font-extrabold text-zinc-900">4.8★</div><div class="text-sm text-zinc-500 mt-1">Avg. Rating</div></div>`;
                }
            } catch(e) {
                console.error('Available load error:', e);
                document.getElementById('availableCarsGrid').innerHTML = empty('Could not load cars.');
            }
        }

        document.getElementById('btnQuickSearch').addEventListener('click', () => {
            const q = new URLSearchParams({
                searchTerm: document.getElementById('homeSearchInput').value.trim(),
                location:   document.getElementById('homeLocationSelect').value,
                seatCount:  document.getElementById('seatQuickSelect').value,
                sortBy:     document.getElementById('homeSortSelect').value,
            });
            window.location.href = `/cars?${q}`;
        });
        document.getElementById('homeSearchInput').addEventListener('keydown', e => { if (e.key === 'Enter') document.getElementById('btnQuickSearch').click(); });

        async function loadFilterOptions() {
            try {
                const r = await fetch('/api/proxy/cars/filter-options');
                if (!r.ok) return;
                const opt = await r.json();
                if (Array.isArray(opt.districts) && opt.districts.length) {
                    document.getElementById('homeLocationSelect').innerHTML =
                        '<option value="" style="color:#09090b;">All areas</option>' +
                        opt.districts.map(d => `<option value="${d}" style="color:#09090b;">${d}</option>`).join('');
                }
                if (Array.isArray(opt.seatCounts) && opt.seatCounts.length) {
                    document.getElementById('seatQuickSelect').innerHTML =
                        '<option value="" style="color:#09090b;">All</option>' +
                        opt.seatCounts.map(s => `<option value="${s}" style="color:#09090b;">${s} seats</option>`).join('');
                }
            } catch(e) {}
        }

        loadFilterOptions();
        loadFeatured();
        loadAvailable();
    </script>
    @await Html.PartialAsync("_ChatbotWidget")
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/chatbot.js" asp-append-version="true"></script>
</body>
</html>

@page "/cars"
@model WebClient.Pages.Cars.SearchModel
@{
    ViewData["Title"] = "Tìm xe - VivuCar";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="Tìm và lọc xe tự lái tại Đà Nẵng theo hãng, giá, khu vực, số sàn/tự động, nhiên liệu và nhiều tiêu chí khác." />
    <script>
        tailwind = { config: { theme: { extend: { colors: { primary: { DEFAULT:'#16a34a',50:'#f0fdf4',100:'#dcfce7',700:'#15803d' } }, fontFamily: { sans:['Be Vietnam Pro','Segoe UI','Arial','sans-serif'] } } } } };
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        .price-chip { cursor:pointer; border:1px solid #e5e7eb; border-radius:9999px; padding:4px 12px; font-size:.75rem; font-weight:600; transition:all .15s; background:#fff; color:#3f3f46; }
        .price-chip.active,.price-chip:hover { background:#16a34a; border-color:#16a34a; color:#fff; }
        .skeleton { background:linear-gradient(90deg,#f0f0f0 25%,#e0e0e0 50%,#f0f0f0 75%); background-size:200% 100%; animation:shimmer 1.5s infinite; border-radius:12px; height:280px; }
        @@keyframes shimmer { 0%{background-position:200% 0} 100%{background-position:-200% 0} }
        @@keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-4px)} }
        .float-anim { animation:float 3s ease-in-out infinite; }

        /* Filter groups */
        .filter-group { margin-bottom:0; }
        .filter-group + .filter-group { border-top:1px solid #f4f4f5; }
        .filter-group-header { display:flex; align-items:center; gap:8px; padding:14px 0 10px; cursor:pointer; user-select:none; }
        .filter-group-header::before { content:''; width:3px; height:16px; background:#16a34a; border-radius:2px; flex-shrink:0; }
        .filter-group-header span { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.04em; color:#18181b; flex:1; }
        .filter-group-header .chevron { width:14px; height:14px; color:#a1a1aa; transition:transform .2s ease; flex-shrink:0; }
        .filter-group-header.open .chevron { transform:rotate(180deg); }
        .filter-group-body { overflow:hidden; max-height:0; opacity:0; transition:max-height .25s ease, opacity .2s ease, padding .2s ease; padding:0; }
        .filter-group-body.open { max-height:500px; opacity:1; padding:0 0 6px 11px; }

        /* Search card */
        .search-car-card { background:#fff; border-radius:14px; border:1px solid #e6e4df; overflow:hidden; display:flex; flex-direction:column; transition:transform .25s, box-shadow .25s; }
        .search-car-card:hover { transform:translateY(-3px); box-shadow:0 10px 30px rgba(0,0,0,.08); }
        .search-car-card:active { transform:scale(0.98); }

        /* Pagination */
        .page-btn { padding:8px 16px; border-radius:10px; font-size:.875rem; font-weight:500; border:1px solid #e5e7eb; background:#fff; color:#3f3f46; cursor:pointer; transition:background .15s, box-shadow .15s; min-width:40px; text-align:center; }
        .page-btn:hover { background:#fafafa; }
        .page-btn.active { background:#16a34a; color:#fff; border-color:#16a34a; box-shadow:0 1px 3px rgba(0,0,0,.1); }
        .page-btn.active:hover { background:#15803d; }
    </style>
</head>
<body class="bg-zinc-50 text-zinc-900 font-sans antialiased">

    <!-- Navbar -->
    <partial name="_Navbar" />

    <!-- Mobile Search Bar -->
    <div class="block md:hidden bg-white border-b border-zinc-200 py-3 px-4">
        <div class="flex gap-2 items-center">
            <div class="relative flex-1">
                <input id="searchInputMobile" type="text" placeholder="Tìm xe..."
                       style="width:100%;border:1px solid #e5e7eb;border-radius:10px;padding:9px 12px;font-size:.875rem;outline:none;background:#fafafa;transition:border-color .2s" onfocus="this.style.borderColor='#16a34a'" onblur="this.style.borderColor='#e5e7eb'" />
            </div>
            <button style="flex-shrink:0;background:#16a34a;color:#fff;font-weight:600;padding:9px 16px;border-radius:10px;font-size:.8125rem;border:none;cursor:pointer;" onmouseover="this.style.background='#15803d'" onmouseout="this.style.background='#16a34a'" onclick="document.getElementById('searchInput').value=document.getElementById('searchInputMobile').value;collectFilters();STATE.page=1;load()">Tìm</button>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 py-6">
        <div class="flex gap-6">

            <!-- Filter Sidebar -->
            <aside class="hidden md:flex flex-col w-64 shrink-0 sticky top-24 self-start" style="max-height: calc(100vh - 7rem);">
                <div class="bg-white rounded-2xl border border-zinc-200 flex flex-col" style="max-height: calc(100vh - 7rem); overflow: hidden;">

                    <!-- Search zone inside filter -->
                    <div style="padding:14px 16px;border-bottom:1px solid #f0f0f0;flex-shrink:0">
                        <div style="position:relative">
                            <svg style="position:absolute;left:12px;top:50%;transform:translateY(-50%);width:14px;height:14px;color:#a1a1aa;pointer-events:none" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                            <input id="searchInput" type="text" value="@Model.SearchTerm"
                                   placeholder="Tìm xe..."
                                   style="width:100%;border:1px solid #e6e4df;border-radius:10px;padding:9px 14px 9px 36px;font-size:.8125rem;outline:none;background:#fafafa;transition:border-color .2s;box-sizing:border-box" onfocus="this.style.borderColor='#16a34a'" onblur="this.style.borderColor='#e6e4df'" />
                            <div id="suggestionsBox" style="display:none;position:absolute;top:calc(100% + 4px);left:0;right:0;background:#fff;border:1px solid #e6e4df;border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.1);z-index:60;overflow:hidden"></div>
                        </div>
                    </div>

                    <!-- Filter header -->
                    <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px 4px;flex-shrink:0">
                        <h2 style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#18181b;margin:0">Bộ lọc</h2>
                        <button id="btnResetFilter" style="font-size:11px;color:#ef4444;font-weight:500;background:none;border:none;cursor:pointer;padding:0">Xoá tất cả</button>
                    </div>

                    <!-- Scrollable filter content -->
                    <div class="overflow-y-auto flex-1" style="padding:0 16px 8px">
                        <!-- Brand -->
                        <div class="filter-group">
                            <div class="filter-group-header open" data-toggle="brandFilterBody"><span>Hãng xe</span><svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></div>
                            <div id="brandFilterBody" class="filter-group-body open" style="max-height:400px;opacity:1;padding:0 0 6px 11px">
                                <div style="height:12px;background:#f4f4f5;border-radius:4px;animation:shimmer 1.5s infinite"></div>
                            </div>
                        </div>

                        <!-- Price -->
                        <div class="filter-group">
                            <div class="filter-group-header open" data-toggle="priceFilterBody"><span>Giá/ngày (VNĐ)</span><svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></div>
                            <div id="priceFilterBody" class="filter-group-body open" style="max-height:200px;opacity:1;padding:0 0 6px 11px">
                                <div style="display:flex;gap:6px;margin-bottom:8px">
                                    <div style="flex:1">
                                        <label for="minPrice" style="font-size:10px;font-weight:600;color:#71717a;display:block;margin-bottom:2px">Từ</label>
                                        <input id="minPrice" type="number" placeholder="0" min="0" style="width:100%;border:1px solid #e6e4df;border-radius:8px;padding:7px 10px;font-size:.75rem;outline:none;transition:border-color .2s;box-sizing:border-box" onfocus="this.style.borderColor='#16a34a'" onblur="this.style.borderColor='#e6e4df'" />
                                    </div>
                                    <div style="flex:1">
                                        <label for="maxPrice" style="font-size:10px;font-weight:600;color:#71717a;display:block;margin-bottom:2px">Đến</label>
                                        <input id="maxPrice" type="number" placeholder="999tr" min="0" style="width:100%;border:1px solid #e6e4df;border-radius:8px;padding:7px 10px;font-size:.75rem;outline:none;transition:border-color .2s;box-sizing:border-box" onfocus="this.style.borderColor='#16a34a'" onblur="this.style.borderColor='#e6e4df'" />
                                    </div>
                                </div>
                                <div style="display:flex;flex-wrap:wrap;gap:4px">
                                    <button class="price-chip" data-price="0,300000">Dưới 300k</button>
                                    <button class="price-chip" data-price="300000,600000">300k–600k</button>
                                    <button class="price-chip" data-price="600000,1000000">600k–1tr</button>
                                    <button class="price-chip" data-price="1000000,99999999">Trên 1tr</button>
                                </div>
                            </div>
                        </div>

                        <!-- Area -->
                        <div class="filter-group">
                            <div class="filter-group-header open" data-toggle="areaFilterBody"><span>Khu vực</span><svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></div>
                            <div id="areaFilterBody" class="filter-group-body open" style="max-height:200px;opacity:1;padding:0 0 6px 11px">
                                <div id="areaFilters" style="display:flex;flex-direction:column;gap:6px;font-size:.8125rem">
                                    @foreach (var loc in new[]{"Hải Châu","Thanh Khê","Sơn Trà","Ngũ Hành Sơn","Liên Chiểu","Cẩm Lệ","Hoà Vang"})
                                    {
                                        <label style="display:flex;align-items:center;gap:6px;cursor:pointer;color:#3f3f46">
                                            <input type="checkbox" name="location" value="@loc" style="accent-color:#16a34a" />
                                            <span>@loc</span>
                                        </label>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Seats -->
                        <div class="filter-group">
                            <div class="filter-group-header open" data-toggle="seatFilterBody"><span>Số chỗ</span><svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></div>
                            <div id="seatFilterBody" class="filter-group-body open" style="max-height:120px;opacity:1;padding:0 0 6px 11px">
                                <select id="seatFilter" style="width:100%;border:1px solid #e6e4df;border-radius:8px;padding:7px 10px;font-size:.8125rem;outline:none;background:#fff;transition:border-color .2s;color:#18181b" onfocus="this.style.borderColor='#16a34a'" onblur="this.style.borderColor='#e6e4df'">
                                    <option value="">Tất cả</option>
                                    <option value="4">4 chỗ</option>
                                    <option value="5">5 chỗ</option>
                                    <option value="7">7 chỗ</option>
                                </select>
                            </div>
                        </div>

                        <!-- Transmission -->
                        <div class="filter-group">
                            <div class="filter-group-header open" data-toggle="transFilterBody"><span>Hộp số</span><svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></div>
                            <div id="transFilterBody" class="filter-group-body open" style="max-height:150px;opacity:1;padding:0 0 6px 11px">
                                <div id="transmissionFilters" style="display:flex;flex-direction:column;gap:6px;font-size:.8125rem">
                                    @foreach (var (lbl, val) in new[]{("Tất cả",""),("Tự động","2"),("Số sàn","1")})
                                    {
                                        <label style="display:flex;align-items:center;gap:6px;cursor:pointer;color:#3f3f46">
                                            <input type="radio" name="transmission" value="@val" @(val == "" ? "checked" : "") style="accent-color:#16a34a" />
                                            <span>@lbl</span>
                                        </label>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Fuel -->
                        <div class="filter-group">
                            <div class="filter-group-header open" data-toggle="fuelFilterBody"><span>Nhiên liệu</span><svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></div>
                            <div id="fuelFilterBody" class="filter-group-body open" style="max-height:180px;opacity:1;padding:0 0 6px 11px">
                                <div id="fuelFilters" style="display:flex;flex-direction:column;gap:6px;font-size:.8125rem">
                                    @foreach (var (lbl, val) in new[]{("Xăng","1"),("Dầu","2"),("Điện","3"),("Hybrid","4")})
                                    {
                                        <label style="display:flex;align-items:center;gap:6px;cursor:pointer;color:#3f3f46">
                                            <input type="checkbox" name="fuel" value="@val" style="accent-color:#16a34a" />
                                            <span>@lbl</span>
                                        </label>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Apply button -->
                    <div style="padding:10px 16px 14px;border-top:1px solid #f0f0f0;flex-shrink:0">
                        <button id="btnApplyFilter" style="display:block;width:100%;background:#16a34a;color:#fff;font-weight:700;padding:9px 0;border-radius:10px;font-size:.8125rem;border:none;cursor:pointer;transition:background .2s" onmouseover="this.style.background='#15803d'" onmouseout="this.style.background='#16a34a'">Áp dụng</button>
                    </div>
                </div>
            </aside>

            <!-- Results -->
            <div class="flex-1 min-w-0">
                <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:20px">
                    <div style="display:flex;align-items:center;gap:10px">
                        <span id="resultCount" style="font-size:13px;font-weight:600;color:#a1a1aa;background:#f4f4f5;padding:4px 14px;border-radius:999px">Loading...</span>
                    </div>
                    <select id="sortCars" style="border:1px solid #e6e4df;border-radius:10px;padding:8px 14px;font-size:.8125rem;color:#18181b;background:#fff;outline:none;cursor:pointer;-webkit-appearance:none;appearance:none;transition:border-color .2s" onfocus="this.style.borderColor='#16a34a'" onblur="this.style.borderColor='#e6e4df'">
                        <option value="">Liên quan nhất</option>
                        <option value="price_asc">Giá: Thấp → Cao</option>
                        <option value="price_desc">Giá: Cao → Thấp</option>
                        <option value="rating_desc">Đánh giá cao nhất</option>
                        <option value="bookings_desc">Nhiều lượt thuê</option>
                        <option value="newest">Mới nhất</option>
                    </select>
                </div>

                <div id="carsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                    <div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div>
                </div>

                <div id="pagination" class="flex justify-center gap-2 mt-8 flex-wrap"></div>
            </div>
        </div>
    </div>

    <!-- Inline scripts (Layout = null) -->
    <script>
        const STATE = { page:1, pageSize:12, searchTerm:'@Model.SearchTerm', location:'@Model.Location', sortBy:'@Model.SortBy', seatCount:'@(Model.SeatCount?.ToString()??"")', brands:[], minPrice:null, maxPrice:null, transmissionType:null, fuelTypes:[] };

        const fmt   = n => (n || 0).toLocaleString('vi-VN') + '₫';
        const stars = r => { const f = Math.floor(r || 0); return `<span style="color:#fbbf24">${'★'.repeat(f)}${'☆'.repeat(5-f)}</span>`; };
        const fuelMap = { Gasoline:'Xăng', Electric:'Điện', Diesel:'Dầu', Hybrid:'Hybrid' };

        function getStatusBadge(status) {
            const s = (status || 'Available').toLowerCase();
            const map = {
                available:    { bg:'#dcfce7', color:'#15803d', label:'Sẵn sàng' },
                rented:       { bg:'#fef3c7', color:'#b45309', label:'Đang cho thuê' },
                maintenance:  { bg:'#ffedd5', color:'#c2410c', label:'Bảo trì' },
                blocked:      { bg:'#fee2e2', color:'#b91c1c', label:'Đã khóa' },
            };
            const m = map[s] || { bg:'#f4f4f5', color:'#3f3f46', label:status };
            return `<span style="position:absolute;top:12px;left:12px;background:${m.bg};color:${m.color};font-size:12px;font-weight:600;padding:4px 12px;border-radius:999px;box-shadow:0 1px 3px rgba(0,0,0,.08)">${m.label}</span>`;
        }

        function carCard(car) {
            const fuel = fuelMap;
            const hasImg = car.primaryImageUrl;
            const img = hasImg
                ? `<img src="${car.primaryImageUrl}" alt="${car.name}" style="width:100%;height:180px;object-fit:cover;transition:transform .4s ease;display:block" loading="lazy">`
                : `<div style="width:100%;height:180px;background:#f4f4f5;display:flex;align-items:center;justify-content:center;color:#d4d4d8;font-size:1.5rem;font-weight:700">?</div>`;
            const trans = car.transmission === 'Automatic' ? 'Tự động' : 'Số sàn';
            const loc = car.location || 'Đà Nẵng';
            return `<article class="search-car-card">
                <div style="position:relative;overflow:hidden">${img}${getStatusBadge(car.status)}</div>
                <div style="padding:14px 16px 16px;display:flex;flex-direction:column;flex:1">
                    <p style="font-size:11px;color:#a1a1aa;font-weight:500;margin:0 0 2px;text-transform:uppercase;letter-spacing:.04em">${car.brandName || ''}</p>
                    <h3 style="font-size:.9375rem;font-weight:700;color:#18181b;margin:0 0 6px;line-height:1.3;letter-spacing:-.01em">${car.name}</h3>
                    <div style="display:flex;align-items:center;gap:4px;font-size:11px;color:#fbbf24;margin-bottom:8px">
                        ${stars(car.averageRating)}
                        <span style="color:#a1a1aa;font-weight:500">${(car.averageRating || 0).toFixed(1)}</span>
                        <span style="color:#d4d4d8">·</span>
                        <span style="color:#a1a1aa">${loc}</span>
                    </div>
                    <div style="display:flex;gap:4px;flex-wrap:wrap;margin-bottom:auto">
                        <span style="font-size:10px;background:#f4f4f5;color:#52525b;padding:2px 8px;border-radius:999px">${car.seatCount} chỗ</span>
                        <span style="font-size:10px;background:#f4f4f5;color:#52525b;padding:2px 8px;border-radius:999px">${trans}</span>
                        <span style="font-size:10px;background:#f4f4f5;color:#52525b;padding:2px 8px;border-radius:999px">${fuel[car.fuel] || car.fuel || ''}</span>
                    </div>
                    <div style="display:flex;align-items:center;justify-content:space-between;padding-top:12px;border-top:1px solid #f4f4f5;margin-top:10px">
                        <div><span style="font-size:1.05rem;font-weight:800;color:#18181b">${fmt(car.dailyPrice)}</span><span style="font-size:11px;color:#a1a1aa">/ngày</span></div>
                        <a href="/cars/detail?id=${car.id}" style="font-size:12px;font-weight:600;background:#16a34a;color:#fff;padding:5px 14px;border-radius:999px;text-decoration:none;transition:background .2s" onmouseover="this.style.background='#15803d'" onmouseout="this.style.background='#16a34a'">Đặt ngay</a>
                    </div>
                </div>
            </article>`;
        }

        function empty(msg) {
            return `<div class="col-span-3 py-20 text-center text-zinc-400">${msg}</div>`;
        }

        function qs() {
            const p = new URLSearchParams();
            if (STATE.searchTerm) p.set('searchTerm', STATE.searchTerm);
            if (STATE.brands && STATE.brands.length) p.set('brands', STATE.brands.join(','));
            if (STATE.minPrice) p.set('minPrice', STATE.minPrice);
            if (STATE.maxPrice) p.set('maxPrice', STATE.maxPrice);
            if (STATE.location) p.set('location', STATE.location);
            if (STATE.transmissionType) p.set('transmissionType', STATE.transmissionType);
            STATE.fuelTypes.forEach(f => p.append('fuelType', f));
            if (STATE.seatCount) p.set('seatCount', STATE.seatCount);
            if (STATE.sortBy) p.set('sortBy', STATE.sortBy);
            p.set('page', STATE.page); p.set('pageSize', STATE.pageSize);
            return p.toString();
        }

        async function load() {
            const grid = document.getElementById('carsGrid');
            grid.innerHTML = '<div class="skeleton" style="grid-column:1/-1;height:280px"></div>';
            try {
                const r = await fetch(`/api/proxy/cars?${qs()}`);
                if (!r.ok) throw new Error(`HTTP ${r.status}`);
                const data = await r.json();
                const items = data.items ?? [];
                grid.innerHTML = items.length ? items.map(carCard).join('') : empty('Không có xe phù hợp.');
                document.getElementById('resultCount').textContent = `Tìm thấy ${data.totalCount||0} xe`;
                renderPagination(data.totalCount||0);
            } catch(e) {
                console.error('Load cars error:', e);
                grid.innerHTML = empty('Tải dữ liệu thất bại. Vui lòng thử lại.');
            }
        }

        function renderBrands(brands) {
            const sel = STATE.brands || [];
            const el = document.getElementById('brandFilters') || document.getElementById('brandFilterBody');
            if (el) {
                el.innerHTML = brands.map(b =>
                    `<label style="display:flex;align-items:center;gap:6px;cursor:pointer;color:#3f3f46;font-size:.8125rem">
                        <input type="checkbox" name="brand" value="${b}" ${sel.includes(b)?'checked':''} style="accent-color:#16a34a" /><span>${b}</span>
                     </label>`
                ).join('');
            }
        }

        async function loadFilterOptions() {
            const defaultBrands = ['VinFast', 'Toyota', 'Kia', 'Hyundai', 'Honda', 'Mazda', 'Ford', 'Chevrolet', 'Mercedes', 'BMW'];
            renderBrands(defaultBrands);
            try {
                const r = await fetch('/api/proxy/cars/filter-options');
                if (!r.ok) return;
                const opt = await r.json();

                // 1. Brands
                if (Array.isArray(opt.brands) && opt.brands.length) {
                    renderBrands(opt.brands);
                }

                // 2. Districts / Area
                if (Array.isArray(opt.districts) && opt.districts.length) {
                    document.getElementById('areaFilters').innerHTML = opt.districts.map(d =>
                        `<label style="display:flex;align-items:center;gap:6px;cursor:pointer;color:#3f3f46;font-size:.8125rem">
                            <input type="checkbox" name="location" value="${d}" ${STATE.location===d?'checked':''} style="accent-color:#16a34a" /><span>${d}</span>
                         </label>`
                    ).join('');
                }

                // 3. Seats
                if (Array.isArray(opt.seatCounts) && opt.seatCounts.length) {
                    const cur = STATE.seatCount;
                    document.getElementById('seatFilter').innerHTML =
                        '<option value="">Tất cả</option>' +
                        opt.seatCounts.map(s => `<option value="${s}" ${String(cur)===String(s)?'selected':''}>${s} chỗ</option>`).join('');
                }

                // 4. Transmission
                if (Array.isArray(opt.transmissions) && opt.transmissions.length) {
                    const transMap = { 'Manual': 1, 'Automatic': 2, 'Cvt': 3 };
                    const transLabel = { 'Manual': 'Số sàn', 'Automatic': 'Tự động', 'Cvt': 'CVT' };
                    let html = `<label style="display:flex;align-items:center;gap:6px;cursor:pointer;color:#3f3f46;font-size:.8125rem">
                        <input type="radio" name="transmission" value="" ${!STATE.transmissionType?'checked':''} style="accent-color:#16a34a" />
                        <span>Tất cả</span>
                    </label>`;
                    opt.transmissions.forEach(t => {
                        const val = transMap[t] || '';
                        const lbl = transLabel[t] || t;
                        html += `<label style="display:flex;align-items:center;gap:6px;cursor:pointer;color:#3f3f46;font-size:.8125rem">
                            <input type="radio" name="transmission" value="${val}" ${String(STATE.transmissionType)===String(val)?'checked':''} style="accent-color:#16a34a" />
                            <span>${lbl}</span>
                        </label>`;
                    });
                    document.getElementById('transmissionFilters').innerHTML = html;
                }

                // 5. Fuel Type
                const allFuelTypes = ['Gasoline', 'Diesel', 'Electric', 'Hybrid'];
                const fuelList = (Array.isArray(opt.fuelTypes) && opt.fuelTypes.length >= 4) ? opt.fuelTypes : allFuelTypes;
                const fuelMap = { 'Gasoline': 1, 'Diesel': 2, 'Electric': 3, 'Hybrid': 4 };
                const fuelLabel = { 'Gasoline': 'Xăng', 'Diesel': 'Dầu', 'Electric': 'Điện', 'Hybrid': 'Hybrid' };
                const curFuels = STATE.fuelTypes || [];
                document.getElementById('fuelFilters').innerHTML = fuelList.map(f => {
                    const val = String(fuelMap[f] || f);
                    const lbl = fuelLabel[f] || f;
                    const checked = curFuels.includes(val) ? 'checked' : '';
                    return `<label style="display:flex;align-items:center;gap:6px;cursor:pointer;color:#3f3f46;font-size:.8125rem">
                        <input type="checkbox" name="fuel" value="${val}" ${checked} style="accent-color:#16a34a" />
                        <span>${lbl}</span>
                    </label>`;
                }).join('');
            } catch(e) {
                console.error('Failed to load filter options:', e);
            }
        }

        async function loadSuggestions(q) {
            const box = document.getElementById('suggestionsBox');
            if (!q || q.length < 2) { box.style.display = 'none'; return; }
            try {
                const r = await fetch(`/api/proxy/cars/suggestions?q=${encodeURIComponent(q)}`);
                if (!r.ok) { box.style.display = 'none'; return; }
                const items = await r.json();
                if (!items?.length) { box.style.display = 'none'; return; }
                box.innerHTML = items.map(s => `<button style="display:block;width:100%;text-align:left;padding:8px 14px;font-size:.8125rem;background:transparent;border:none;cursor:pointer;color:#3f3f46;transition:background .15s" onmouseover="this.style.background='#fafafa'" onmouseout="this.style.background='transparent'" data-suggest="${s}">${s}</button>`).join('');
                box.style.display = 'block';
            } catch {}
        }

        function renderPagination(total) {
            const pages = Math.ceil(total / STATE.pageSize);
            const el = document.getElementById('pagination');
            if (pages <= 1) { el.innerHTML = ''; return; }

            let html = '';

            if (STATE.page > 1) {
                html += '<button data-p="' + (STATE.page - 1) + '" class="page-btn">← Trước</button>';
            }

            const range = 2;
            for (let i = 1; i <= pages; i++) {
                if (i === 1 || i === pages || (i >= STATE.page - range && i <= STATE.page + range)) {
                    html += '<button data-p="' + i + '" class="page-btn' + (i === STATE.page ? ' active' : '') + '">' + i + '</button>';
                } else if (i === 2 || i === pages - 1) {
                    if (!html.endsWith('...</span>')) {
                        html += '<span style="padding:8px 4px;color:#a1a1aa;font-size:.875rem">...</span>';
                    }
                }
            }

            if (STATE.page < pages) {
                html += '<button data-p="' + (STATE.page + 1) + '" class="page-btn">Sau →</button>';
            }

            el.innerHTML = html;
        }

        function collectFilters() {
            STATE.searchTerm        = document.getElementById('searchInput').value.trim();
            STATE.sortBy            = document.getElementById('sortCars').value;
            STATE.seatCount         = document.getElementById('seatFilter').value;
            STATE.minPrice          = document.getElementById('minPrice').value || null;
            STATE.maxPrice          = document.getElementById('maxPrice').value || null;
            const loc               = [...document.querySelectorAll('[name=location]:checked')].map(x=>x.value);
            STATE.location          = loc[0] || '';
            const trans             = document.querySelector('[name=transmission]:checked');
            STATE.transmissionType  = trans?.value || null;
            STATE.fuelTypes         = [...document.querySelectorAll('[name=fuel]:checked')].map(x=>x.value);
            STATE.brands            = [...document.querySelectorAll('[name=brand]:checked')].map(x=>x.value);
        }

        function resetFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('minPrice').value = '';
            document.getElementById('maxPrice').value = '';
            document.getElementById('seatFilter').value = '';
            const firstTrans = document.querySelectorAll('[name=transmission]')[0];
            if (firstTrans) firstTrans.checked = true;
            document.querySelectorAll('[name=location],[name=fuel],[name=brand]').forEach(x=>x.checked=false);
            document.querySelectorAll('.price-chip').forEach(x=>x.classList.remove('active'));
            Object.assign(STATE, {brands:[],minPrice:null,maxPrice:null,transmissionType:null,fuelTypes:[],seatCount:'',location:'',searchTerm:'',page:1});
            load();
        }

        // Filter group toggle
        document.querySelector('.overflow-y-auto')?.addEventListener('click', function(e) {
            const header = e.target.closest('[data-toggle]');
            if (!header) return;
            const body = document.getElementById(header.dataset.toggle);
            if (!body) return;
            header.classList.toggle('open');
            body.classList.toggle('open');
            if (body.classList.contains('open')) {
                body.style.maxHeight = body.scrollHeight + 'px';
                setTimeout(() => { body.style.maxHeight = '500px'; }, 260);
            } else {
                body.style.maxHeight = '0';
            }
        });

        // Init from URL
        const urlParams = new URLSearchParams(location.search);
        STATE.searchTerm = urlParams.get('searchTerm') || STATE.searchTerm || '';
        STATE.location   = urlParams.get('location') || STATE.location || '';
        STATE.sortBy     = urlParams.get('sortBy') || STATE.sortBy || '';
        STATE.seatCount  = urlParams.get('seatCount') || STATE.seatCount || '';
        if (STATE.searchTerm) document.getElementById('searchInput').value = STATE.searchTerm;
        if (STATE.sortBy)     document.getElementById('sortCars').value = STATE.sortBy;
        if (STATE.seatCount)  document.getElementById('seatFilter').value = STATE.seatCount;
        if (STATE.location) {
            const cb = [...document.querySelectorAll('[name=location]')].find(x=>x.value===STATE.location);
            if (cb) cb.checked = true;
        }

        // Event bindings
        document.getElementById('btnSearch')?.addEventListener('click', () => { collectFilters(); STATE.page=1; load(); });
        document.getElementById('searchInput').addEventListener('keydown', e => { if(e.key==='Enter') document.getElementById('btnSearch')?.click(); });
        document.getElementById('searchInput').addEventListener('input', e => loadSuggestions(e.target.value.trim()));
        document.getElementById('suggestionsBox').addEventListener('click', e => {
            const s = e.target.closest('[data-suggest]');
            if (s) { document.getElementById('searchInput').value=s.dataset.suggest; document.getElementById('suggestionsBox').style.display='none'; document.getElementById('btnSearch')?.click(); }
        });
        document.addEventListener('click', e => { if(!e.target.closest('#searchInput')&&!e.target.closest('#suggestionsBox')) document.getElementById('suggestionsBox').style.display='none'; });
        document.getElementById('sortCars').addEventListener('change', () => { collectFilters(); STATE.page=1; load(); });
        document.getElementById('btnApplyFilter').addEventListener('click', () => { collectFilters(); STATE.page=1; load(); });
        document.getElementById('btnResetFilter').addEventListener('click', resetFilters);
        document.querySelectorAll('[data-price]').forEach(btn =>
            btn.addEventListener('click', () => {
                document.querySelectorAll('.price-chip').forEach(b=>b.classList.remove('active'));
                btn.classList.add('active');
                const [min,max] = btn.dataset.price.split(',');
                document.getElementById('minPrice').value = +min>0?min:'';
                document.getElementById('maxPrice').value = +max<99999999?max:'';
            })
        );
        document.getElementById('pagination').addEventListener('click', e => {
            const btn = e.target.closest('[data-p]');
            if (btn) { STATE.page=+btn.dataset.p; load(); window.scrollTo({top:0,behavior:'smooth'}); }
        });

        loadFilterOptions(); load();
    </script>
</body>
</html>

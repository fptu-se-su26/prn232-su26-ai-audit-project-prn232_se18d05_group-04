@page "/cars"
@model WebClient.Pages.Cars.SearchModel
@{
    ViewData["Title"] = "Tìm xe - VivuCar";
    ViewData["DataPage"] = "search";
}

<main class="page-shell">
  <div class="page-heading">
    <div>
      <h1>Tìm xe</h1>
      <p>Tìm theo brand, model, khu vực. Mặc định chỉ hiện xe đang khả dụng.</p>
    </div>
  </div>

  <section class="panel p-3 mb-4">
    <div class="search-box !mt-0">
      <input id="searchKeyword" placeholder="Tìm theo tên xe, hãng xe hoặc dòng xe" />
      <button class="btn btn-primary" id="btnSearch">Tìm kiếm</button>
    </div>
    <div id="searchSuggestions" class="chip-row hidden mt-2.5"></div>
    <div id="filterError" class="alert alert-error hidden"></div>
  </section>

  <div class="listing-layout">
    <aside class="filter-panel" id="filterPanel"></aside>

    <section>
      <div class="section-head" style="margin-top:0">
        <h2 id="resultCount">Tìm thấy 0 xe</h2>
        <select id="sortCars">
          <option value="relevant">Phù hợp nhất</option>
          <option value="price_asc">Giá thấp đến cao</option>
          <option value="price_desc">Giá cao đến thấp</option>
          <option value="rating_desc">Rating cao nhất</option>
        </select>
      </div>
      <div id="searchResultGrid" class="car-grid">
        <div class="skeleton"></div>
      </div>
      <div class="pagination" id="searchPagination"></div>
    </section>
  </div>
</main>

@section Scripts {
  <script>
    const STATE = { keyword: '@Model.SearchTerm', brands: [], location: '@Model.Location', minPrice: null, maxPrice: null, seatCount: '@(Model.SeatCount?.ToString()??"")', transmissionType: null, fuelTypes: [], sort: '@Model.SortBy' || 'relevant', page: 1, pageSize: 12 };

    const fmt = n => (n || 0).toLocaleString('vi-VN') + '₫';
    const stars = r => { const f = Math.round(r || 0); return `<span style="color:#fbbf24">${'★'.repeat(f)}${'☆'.repeat(5-f)}</span>`; };
    const fuelMap = { Gasoline: 'Xăng', Electric: 'Điện', Diesel: 'Dầu', Hybrid: 'Hybrid' };

    function carCard(car) {
      const img = car.primaryImageUrl || car.carImageUrl
        ? `<img src="${car.primaryImageUrl || car.carImageUrl}" alt="${car.name}" style="width:100%;height:192px;object-fit:cover" loading="lazy">`
        : `<div style="height:192px;background:#e4e4e7;display:flex;align-items:center;justify-content:center;font-size:3rem;color:#d4d4d8">🚗</div>`;
      const badge = String(car.status || '').toLowerCase() === 'available'
        ? `<span style="position:absolute;top:12px;left:12px;background:#dcfce7;color:#16a34a;font-size:.75rem;font-weight:600;padding:4px 10px;border-radius:999px;box-shadow:0 1px 3px rgba(0,0,0,.1)">Khả dụng</span>`
        : '';
      return `<article class="car-card">
        <div style="position:relative;overflow:hidden">${img}${badge}</div>
        <div class="car-card-body">
          <p style="font-size:.75rem;color:#a1a1aa;font-weight:500;margin:0 0 4px">${car.brandName || ''}</p>
          <h3 style="margin:0 0 8px">${car.name}</h3>
          <div class="car-meta">
            <span>📍 ${car.location || 'Đà Nẵng'}</span>
            <span>🪑 ${car.seatCount} chỗ</span>
            <span>⚙️ ${car.transmission === 'Automatic' ? 'Tự động' : 'Số sàn'}</span>
            <span>⛽ ${fuelMap[car.fuel] || car.fuel || ''}</span>
          </div>
          <div style="display:flex;align-items:center;gap:6px;font-size:.8125rem;margin-top:4px">
            ${stars(car.averageRating)}
            <span style="color:#71717a">${(car.averageRating || 0).toFixed(1)} · ${car.totalBookings || 0} lượt thuê</span>
          </div>
          <div class="price-line" style="margin-top:auto">
            <strong>${fmt(car.dailyPrice)}</strong><span class="muted">/ngày</span>
          </div>
          <div class="actions" style="margin-top:8px">
            <a class="btn btn-secondary btn-sm" href="/cars/detail?id=${car.id}">Xem chi tiết</a>
            <a class="btn btn-primary btn-sm" href="/Booking/Checkout?carId=${car.id}">Đặt xe</a>
          </div>
        </div>
      </article>`;
    }

    function empty(msg) {
      return `<div style="grid-column:1/-1;padding:80px 0;text-align:center;color:#a1a1aa">${msg}</div>`;
    }

    function qs() {
      const p = new URLSearchParams();
      if (STATE.keyword) p.set('searchTerm', STATE.keyword);
      if (STATE.brands.length) p.set('brands', STATE.brands.join(','));
      if (STATE.minPrice) p.set('minPrice', STATE.minPrice);
      if (STATE.maxPrice) p.set('maxPrice', STATE.maxPrice);
      if (STATE.location) p.set('location', STATE.location);
      if (STATE.transmissionType) p.set('transmissionType', STATE.transmissionType);
      STATE.fuelTypes.forEach(f => p.append('fuelType', f));
      if (STATE.seatCount) p.set('seatCount', STATE.seatCount);
      if (STATE.sort && STATE.sort !== 'relevant') p.set('sortBy', STATE.sort);
      p.set('page', STATE.page);
      p.set('pageSize', STATE.pageSize);
      return p.toString();
    }

    async function load() {
      const grid = document.getElementById('searchResultGrid');
      grid.innerHTML = '<div class="skeleton" style="grid-column:1/-1;min-height:16rem"></div>';
      try {
        const r = await fetch(`/api/proxy/cars?${qs()}`);
        if (!r.ok) throw new Error('HTTP ' + r.status);
        const data = await r.json();
        const items = data.items ?? [];
        grid.innerHTML = items.length ? items.map(carCard).join('') : empty('Không tìm thấy xe phù hợp.');
        document.getElementById('resultCount').textContent = `Tìm thấy ${data.totalCount || 0} xe`;
        renderPagination(data.totalCount || 0);
      } catch {
        grid.innerHTML = empty('Lỗi tải dữ liệu. Vui lòng thử lại.');
      }
    }

    function renderBrands(brands) {
      const sel = STATE.brands || [];
      const el = document.getElementById('brandFilters');
      if (!el) return;
      el.innerHTML = brands.map(b =>
        `<label class="check-row" style="cursor:pointer">
          <input type="checkbox" name="brand" value="${b}" ${sel.includes(b) ? 'checked' : ''}>
          <span>${b}</span>
        </label>`
      ).join('');
    }

    async function loadFilterOptions() {
      const defaults = ['VinFast', 'Toyota', 'Kia', 'Hyundai', 'Honda', 'Mazda', 'Ford', 'Chevrolet', 'Mercedes', 'BMW'];
      renderBrands(defaults);
      try {
        const r = await fetch('/api/proxy/cars/filter-options');
        if (!r.ok) return;
        const opt = await r.json();
        if (Array.isArray(opt.brands) && opt.brands.length) renderBrands(opt.brands);
        if (Array.isArray(opt.districts) && opt.districts.length) {
          document.getElementById('areaFilters').innerHTML = opt.districts.map(d =>
            `<label class="check-row" style="cursor:pointer">
              <input type="checkbox" name="location" value="${d}" ${STATE.location === d ? 'checked' : ''}>
              <span>${d}</span>
            </label>`
          ).join('');
        }
        if (Array.isArray(opt.seatCounts) && opt.seatCounts.length) {
          const cur = STATE.seatCount;
          document.getElementById('seatFilter').innerHTML =
            '<option value="">Tất cả</option>' +
            opt.seatCounts.map(s => `<option value="${s}" ${String(cur) === String(s) ? 'selected' : ''}>${s} chỗ</option>`).join('');
        }
        if (Array.isArray(opt.transmissions) && opt.transmissions.length) {
          const transMap = { Manual: 1, Automatic: 2, Cvt: 3 };
          const transLabel = { Manual: 'Số sàn', Automatic: 'Tự động', Cvt: 'CVT' };
          let html = `<label class="check-row" style="cursor:pointer">
            <input type="radio" name="transmission" value="" ${!STATE.transmissionType ? 'checked' : ''}>
            <span>Tất cả</span>
          </label>`;
          opt.transmissions.forEach(t => {
            const val = transMap[t] || '';
            html += `<label class="check-row" style="cursor:pointer">
              <input type="radio" name="transmission" value="${val}" ${String(STATE.transmissionType) === String(val) ? 'checked' : ''}>
              <span>${transLabel[t] || t}</span>
            </label>`;
          });
          document.getElementById('transmissionFilters').innerHTML = html;
        }
        const allFuel = ['Gasoline', 'Diesel', 'Electric', 'Hybrid'];
        const fuelList = (Array.isArray(opt.fuelTypes) && opt.fuelTypes.length >= 4) ? opt.fuelTypes : allFuel;
        const fuelMap = { Gasoline: 1, Diesel: 2, Electric: 3, Hybrid: 4 };
        const fuelLabel = { Gasoline: 'Xăng', Diesel: 'Dầu', Electric: 'Điện', Hybrid: 'Hybrid' };
        const curFuels = STATE.fuelTypes || [];
        document.getElementById('fuelFilters').innerHTML = fuelList.map(f => {
          const val = String(fuelMap[f] || f);
          const checked = curFuels.includes(val) ? 'checked' : '';
          return `<label class="check-row" style="cursor:pointer">
            <input type="checkbox" name="fuel" value="${val}" ${checked}>
            <span>${fuelLabel[f] || f}</span>
          </label>`;
        }).join('');
      } catch {}
    }

    async function loadSuggestions(q) {
      const box = document.getElementById('searchSuggestions');
      if (!q || q.length < 2) { box.classList.add('hidden'); return; }
      try {
        const r = await fetch(`/api/proxy/cars/suggestions?q=${encodeURIComponent(q)}`);
        if (!r.ok) { box.classList.add('hidden'); return; }
        const items = await r.json();
        if (!items?.length) { box.classList.add('hidden'); return; }
        box.innerHTML = items.map(s =>
          `<button class="chip" data-suggest="${s}">${s}</button>`
        ).join('');
        box.classList.remove('hidden');
      } catch {}
    }

    function renderPagination(total) {
      const pages = Math.ceil(total / STATE.pageSize);
      const el = document.getElementById('searchPagination');
      if (pages <= 1) { el.innerHTML = ''; return; }
      let html = '<div class="page-buttons">';
      if (STATE.page > 1)
        html += `<button data-p="${STATE.page - 1}" class="btn btn-secondary btn-sm">← Trước</button>`;
      const range = 2;
      for (let i = 1; i <= pages; i++) {
        if (i === 1 || i === pages || (i >= STATE.page - range && i <= STATE.page + range)) {
          html += `<button data-p="${i}" class="btn ${i === STATE.page ? 'btn-primary' : 'btn-secondary'} btn-sm">${i}</button>`;
        } else if (i === 2 || i === pages - 1) {
          if (!html.endsWith('...</span>')) html += '<span style="padding:0 8px;color:#a1a1aa;font-size:.875rem">...</span>';
        }
      }
      if (STATE.page < pages)
        html += `<button data-p="${STATE.page + 1}" class="btn btn-secondary btn-sm">Sau →</button>`;
      html += '</div>';
      el.innerHTML = html;
    }

    function renderFilters() {
      document.getElementById('filterPanel').innerHTML = `
        <h2 style="font-size:1rem;font-weight:700;margin:0 0 16px">Bộ lọc</h2>

        <div class="filter-group">
          <h3>Hãng xe</h3>
          <div id="brandFilters" class="check-row" style="flex-direction:column;gap:4px;max-height:192px;overflow-y:auto;padding-right:4px"><div style="height:16px;background:#f4f4f5;border-radius:4px;animation:pulse 2s infinite"></div></div>
        </div>

        <div class="filter-group">
          <h3>Giá thuê</h3>
          <div style="display:flex;gap:8px;margin-top:8px">
            <input id="minPrice" type="number" placeholder="Từ" min="0">
            <input id="maxPrice" type="number" placeholder="Đến" min="0">
          </div>
          <div class="chip-row" style="margin-top:8px">
            <button class="chip" data-price="0,300000">Dưới 300k</button>
            <button class="chip" data-price="300000,600000">300k–600k</button>
            <button class="chip" data-price="600000,1000000">600k–1M</button>
            <button class="chip" data-price="1000000,99999999">Trên 1M</button>
          </div>
        </div>

        <div class="filter-group">
          <h3>Khu vực</h3>
          <div id="areaFilters" class="check-row" style="flex-direction:column;gap:4px;max-height:160px;overflow-y:auto;padding-right:4px">
            <label class="check-row"><input type="checkbox" name="location" value="Hải Châu"/><span>Hải Châu</span></label>
            <label class="check-row"><input type="checkbox" name="location" value="Thanh Khê"/><span>Thanh Khê</span></label>
            <label class="check-row"><input type="checkbox" name="location" value="Sơn Trà"/><span>Sơn Trà</span></label>
          </div>
        </div>

        <div class="filter-group">
          <h3>Số chỗ</h3>
          <select id="seatFilter" style="margin-top:8px">
            <option value="">Tất cả</option>
            <option value="4">4 chỗ</option>
            <option value="5">5 chỗ</option>
            <option value="7">7 chỗ</option>
          </select>
        </div>

        <div class="filter-group">
          <h3>Hộp số</h3>
          <div id="transmissionFilters" class="check-row" style="flex-direction:column;gap:4px;margin-top:4px"></div>
        </div>

        <div class="filter-group">
          <h3>Nhiên liệu</h3>
          <div id="fuelFilters" class="check-row" style="flex-direction:column;gap:4px;margin-top:4px"></div>
        </div>

        <div style="margin-top:20px;display:flex;gap:8px">
          <button class="btn btn-secondary btn-full btn-sm" id="btnResetFilter">Xóa</button>
          <button class="btn btn-primary btn-full btn-sm" id="btnApplyFilter">Áp dụng</button>
        </div>
      `;
    }

    function collectFilters() {
      STATE.keyword = document.getElementById('searchKeyword').value.trim();
      STATE.sort = document.getElementById('sortCars').value;
      STATE.seatCount = document.getElementById('seatFilter').value;
      STATE.minPrice = document.getElementById('minPrice').value || null;
      STATE.maxPrice = document.getElementById('maxPrice').value || null;
      const loc = [...document.querySelectorAll('[name=location]:checked')].map(x => x.value);
      STATE.location = loc[0] || '';
      const trans = document.querySelector('[name=transmission]:checked');
      STATE.transmissionType = trans?.value || null;
      STATE.fuelTypes = [...document.querySelectorAll('[name=fuel]:checked')].map(x => x.value);
      STATE.brands = [...document.querySelectorAll('[name=brand]:checked')].map(x => x.value);
    }

    function resetFilters() {
      document.getElementById('searchKeyword').value = '';
      document.getElementById('minPrice').value = '';
      document.getElementById('maxPrice').value = '';
      document.getElementById('seatFilter').value = '';
      const first = document.querySelector('[name=transmission]');
      if (first) first.checked = true;
      document.querySelectorAll('[name=location],[name=fuel],[name=brand]').forEach(x => x.checked = false);
      document.querySelectorAll('.chip[data-price]').forEach(x => x.classList.remove('active'));
      Object.assign(STATE, { brands: [], minPrice: null, maxPrice: null, transmissionType: null, fuelTypes: [], seatCount: '', location: '', keyword: '', page: 1 });
      load();
    }

    // Init
    renderFilters();

    const urlParams = new URLSearchParams(location.search);
    STATE.keyword = urlParams.get('searchTerm') || STATE.keyword || '';
    STATE.location = urlParams.get('location') || STATE.location || '';
    STATE.sort = urlParams.get('sortBy') || STATE.sort || '';
    STATE.seatCount = urlParams.get('seatCount') || STATE.seatCount || '';
    if (STATE.keyword) document.getElementById('searchKeyword').value = STATE.keyword;
    if (STATE.sort) document.getElementById('sortCars').value = STATE.sort;
    if (STATE.seatCount) document.getElementById('seatFilter').value = STATE.seatCount;

    // Events
    document.getElementById('btnSearch').addEventListener('click', () => { collectFilters(); STATE.page = 1; load(); });
    document.getElementById('searchKeyword').addEventListener('keydown', e => { if (e.key === 'Enter') document.getElementById('btnSearch').click(); });
    document.getElementById('searchKeyword').addEventListener('input', e => loadSuggestions(e.target.value.trim()));
    document.getElementById('searchSuggestions').addEventListener('click', e => {
      const s = e.target.closest('[data-suggest]');
      if (s) {
        document.getElementById('searchKeyword').value = s.dataset.suggest;
        document.getElementById('searchSuggestions').classList.add('hidden');
        document.getElementById('btnSearch').click();
      }
    });
    document.addEventListener('click', e => {
      if (!e.target.closest('#searchKeyword') && !e.target.closest('#searchSuggestions'))
        document.getElementById('searchSuggestions').classList.add('hidden');
    });
    document.getElementById('sortCars').addEventListener('change', () => { collectFilters(); STATE.page = 1; load(); });
    document.getElementById('btnApplyFilter').addEventListener('click', () => { collectFilters(); STATE.page = 1; load(); });
    document.getElementById('btnResetFilter').addEventListener('click', resetFilters);
    document.getElementById('filterPanel').addEventListener('click', e => {
      const price = e.target.closest('[data-price]');
      if (price) {
        document.querySelectorAll('.chip[data-price]').forEach(b => b.classList.remove('active'));
        price.classList.add('active');
        const [min, max] = price.dataset.price.split(',');
        document.getElementById('minPrice').value = +min > 0 ? min : '';
        document.getElementById('maxPrice').value = +max < 99999999 ? max : '';
      }
    });
    document.getElementById('searchPagination').addEventListener('click', e => {
      const btn = e.target.closest('[data-p]');
      if (btn) { STATE.page = +btn.dataset.p; load(); window.scrollTo({ top: 0, behavior: 'smooth' }); }
    });

    loadFilterOptions();
    load();
  </script>
}
